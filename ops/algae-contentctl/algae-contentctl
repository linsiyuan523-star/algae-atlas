      "$(json_quote "$UPLOAD_COALESCED_INTO_COMMIT")" \
      "$(json_quote "$UPLOAD_INCLUDED_IN_SYNC_TRANSACTION_ID")" \
      "$(json_quote "$UPLOAD_PUBLISHED_RELEASE_ID")" "$(json_quote "$UPLOAD_PUBLISHED_AT")"
    printf ',"retryable":%s,"errorCode":%s,"message":%s,"contentType":%s,"stableId":%s}\n' \
      "$UPLOAD_RETRYABLE" "$(json_quote "$UPLOAD_ERROR_CODE")" "$(json_quote "$UPLOAD_MESSAGE")" \
      "$(json_quote "$UPLOAD_CONTENT_TYPE")" "$(json_quote "$UPLOAD_STABLE_ID")"
