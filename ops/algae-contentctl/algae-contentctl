json_quote() {
  local value=$1
  value=$(printf '%s' "$value" | LC_ALL=C tr -d '\000-\010\013\014\016-\037')
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\b'/\\b}
  value=${value//$'\f'/\\f}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  value=${value//$'\t'/\\t}
  printf '"%s"' "$value"
}

emit_error() {
  local code=$1
  local message=$2
  local log_tail=${3:-}
  local error_action="unknown"
  case "$ACTION" in
    status|list|pending-status|publish-status|sync-status|sync-pending|queue-init|queue-upload|publish|delete) error_action=$ACTION ;;
  esac
  ERROR_EMITTED=true
  if $JSON_MODE; then
    printf '{"ok":false,"action":%s,"code":%s,"message":%s' "$(json_quote "$error_action")" "$(json_quote "$code")" "$(json_quote "$message")"
    if [[ "$error_action" == "publish" || "$error_action" == "publish-status" ]]; then
      printf ',"errorCode":%s,"retryable":%s,"userMessage":%s,"technicalSummary":%s,"failedStage":%s,"transactionId":%s,"attempt":%d' \
        "$(json_quote "$code")" "$PUBLISH_RETRYABLE" "$(json_quote "$message")" \
        "$(json_quote "${PUBLISH_TECHNICAL_SUMMARY:-$code: $message}")" \
        "$(json_quote "${PUBLISH_FAILED_STAGE:-${PUBLISH_STAGE:-unknown}}")" \
        "$(json_quote "$PUBLISH_TRANSACTION_ID")" "$PUBLISH_ATTEMPT"
    fi
    if [[ "$error_action" == "queue-upload" ]]; then
      printf ',"transactionId":%s,"retryable":false,"errorCode":%s' \
        "$(json_quote "$PUBLISH_TRANSACTION_ID")" "$(json_quote "$code")"
      if $UPLOAD_STATE_PERSISTED; then
        printf ',"status":%s' "$(json_quote "FAILED")"
      fi
    fi
    if [[ "$error_action" == "sync-pending" || "$error_action" == "sync-status" ]]; then
      printf ',"sync_transaction_id":%s,"status":%s,"stage":%s,"retryable":%s,"blocked":%s' \
        "$(json_quote "$SYNC_TRANSACTION_ID")" "$(json_quote "$SYNC_STATUS")" \
        "$(json_quote "$SYNC_STAGE")" "$SYNC_RETRYABLE" "$SYNC_BLOCKED"
    fi
    if [[ -n "$log_tail" ]]; then
      printf ',"logTail":%s' "$(json_quote "$log_tail")"
    fi
    printf '}\n'
  else
    printf '%s: %s\n' "$code" "$message" >&2
    if [[ -n "$log_tail" ]]; then
      printf '%s\n' "$log_tail" >&2
    fi
  fi
}

log_tail() {
  if [[ -n "$OP_LOG" && -f "$OP_LOG" ]]; then
    tail -n 40 -- "$OP_LOG" | sed -e 's/[[:cntrl:]]\[[0-9;]*[[:alpha:]]//g'
  fi
}

fail() {
  local code=$1
  local message=$2
  local include_log=${3:-false}
  local details=""
  if $RELEASE_ACTIVATED; then
    if ! restore_release_links; then
      code="RELEASE_ROLLBACK_FAILED"
      message="$message; release rollback is incomplete and recovery state was retained"
      include_log=true
    fi
  fi
  if [[ "$include_log" == "true" ]]; then
    details=$(log_tail || true)
  fi
  if [[ "$ACTION" == "publish" && -n "$PUBLISH_TRANSACTION_ID" ]]; then
    if publish_error_is_retryable "$code" && ! $PUBLISH_SWITCH_COMPLETED; then
      PUBLISH_RETRYABLE=true
    else
      PUBLISH_RETRYABLE=false
    fi
    PUBLISH_FAILED_STAGE=${PUBLISH_STAGE:-unknown}
    PUBLISH_TECHNICAL_SUMMARY="${code}: ${message}"
    fail_publish_state "$code" "$message" "$details"
  fi
  if [[ "$ACTION" == "queue-upload" && -n "$PUBLISH_TRANSACTION_ID" ]] && $UPLOAD_STATE_ACTIVE; then
    fail_upload_state "$code" "$message" || true
  fi
  if [[ "$ACTION" == "sync-pending" && -n "$SYNC_TRANSACTION_ID" ]] && $SYNC_STATE_ACTIVE; then
    case "$code" in
      QUEUE_STATE_CORRUPT|SYNC_STATE_CORRUPT|SYNC_RELEASE_INVALID|SYNC_RECOVERY_REQUIRED|SYNC_RECOVERY_FAILED)
        # Preserve the active evidence when controlled state or release identity disagrees.
        ;;
      CONTROLLER_BUSY)
        if ! $SYNC_SWITCH_COMPLETED; then
          finish_sync_failure "$code" "$message" || true
        fi
        ;;
      *) finish_sync_failure "$code" "$message" || true ;;
    esac
  fi
  emit_error "$code" "$message" "$details"
  exit 1
}

on_unexpected_error() {
  local status=$1
  trap - ERR
  local code="INTERNAL_ERROR"
  local message="The controller stopped unexpectedly"
  if $RELEASE_ACTIVATED && ! restore_release_links; then
    code="RELEASE_ROLLBACK_FAILED"
    message="The controller stopped unexpectedly and release rollback is incomplete; recovery state was retained"
  fi
  if ! $ERROR_EMITTED; then
    if [[ "$ACTION" == "publish" && -n "$PUBLISH_TRANSACTION_ID" ]]; then
      fail_publish_state "$code" "$message" "$(log_tail || true)"
    fi
    if [[ "$ACTION" == "queue-upload" && -n "$PUBLISH_TRANSACTION_ID" ]] && $UPLOAD_STATE_ACTIVE; then
      fail_upload_state "$code" "$message" || true
    fi
    if [[ "$ACTION" == "sync-pending" && -n "$SYNC_TRANSACTION_ID" ]] && $SYNC_STATE_ACTIVE; then
      finish_sync_failure "$code" "$message" || true
    fi
    emit_error "$code" "$message" "$(log_tail || true)"
  fi
  exit "$status"
}

is_absolute_safe_path() {
  local value=$1
  [[ "$value" == /* ]] || return 1
  [[ "$value" != *".."* ]] || return 1
  [[ "$value" != *[!A-Za-z0-9._/-]* ]] || return 1
}

is_stable_id() {
  local value=$1
  [[ ${#value} -ge 1 && ${#value} -le 200 ]] || return 1
  [[ "$value" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]
}

is_job_id() {
  local value=$1
  [[ "$value" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$ ]]
}

is_publish_transaction_id() {
  [[ "$1" =~ ^[0-9a-f]{32}$ ]]
}

is_bundle_sha256() {
  [[ "$1" =~ ^[0-9A-F]{64}$ ]]
}

is_content_type() {
  case "$1" in
    team-news|research-output|research-project|learning-resource|algae-profile|live-feed-profile|coastal-observation|science-article|team-member|collaboration|research-profile)
