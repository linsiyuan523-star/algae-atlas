emit_upload_state_json() {
  local ref=$1
  local response_action=$2
  local renderer
  renderer=$(cat <<'NODE'
const fs = require("fs");
const action = process.argv[1];
const state = JSON.parse(fs.readFileSync(0, "utf8"));
const failed = action !== "publish-status" && state.status === "FAILED";
const output = { ok: !failed, action, ...state };
if (failed) output.code = state.errorCode || "UPLOAD_FAILED";
process.stdout.write(`${JSON.stringify(output)}\n`);
NODE
)
  "$GIT_BIN" -C "$CONTENT_REPOSITORY" cat-file blob "$ref" 2>>"$OP_LOG" | \
