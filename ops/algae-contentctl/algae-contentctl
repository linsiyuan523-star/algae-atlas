try { state = JSON.parse(fs.readFileSync(0, "utf8")); } catch { process.exit(2); }
if (!state || Array.isArray(state) || !/^[0-9a-f]{32}$/.test(state.sync_transaction_id)) process.exit(3);
process.stdout.write(state.sync_transaction_id);
NODE
)
  SYNC_RESOLVED_TRANSACTION_ID=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" cat-file blob "$SYNC_RESOLVED_OBJECT" 2>>"$OP_LOG" | \
    "$NODE_BIN" -e "$parser") || return 1
  is_sync_transaction_id "$SYNC_RESOLVED_TRANSACTION_ID"
}

