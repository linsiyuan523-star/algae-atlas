#!/usr/bin/env bash
# Controlled server-side publisher for the Algae Atlas content workbench.
# This script deliberately accepts only four fixed commands. It never reads
# /srv/algae-atlas/source and it never executes helpers uploaded with a bundle.

set -Eeuo pipefail
IFS=$'\n\t'
umask 077

readonly PROGRAM_NAME="algae-contentctl"
readonly INSTALLED_PATH="/usr/local/sbin/algae-contentctl"
readonly DEFAULT_CONTENT_ROOT="/srv/algae-content"
readonly DEFAULT_INCOMING_ROOT="/home/ubuntu/algae-content-workbench/incoming"
readonly DEFAULT_SITE_ROOT="/srv/algae-atlas"
readonly DEFAULT_SITE_REPOSITORY_URL="https://github.com/linsiyuan523-star/algae-atlas.git"
readonly DEFAULT_SITE_REPOSITORY_API_URL="https://api.github.com/repos/linsiyuan523-star/algae-atlas"
readonly DEFAULT_SITE_BRANCH="main"
readonly DEFAULT_SERVICE_NAME="algae-atlas.service"
readonly DEFAULT_HEALTH_URL="http://127.0.0.1:3000/"
readonly DEFAULT_LOCAL_BASE_URL="http://127.0.0.1:3000"
readonly DEFAULT_PUBLIC_BASE_URL="https://sycszy.icu"
readonly MAX_BUNDLE_BYTES=$((512 * 1024 * 1024))
readonly MAX_ARTIFACT_BYTES=$((4 * 1024 * 1024))
readonly PRODUCTION_MAX_CONTENT_FILE_BYTES=$((64 * 1024 * 1024))
MAX_CONTENT_FILE_BYTES=$PRODUCTION_MAX_CONTENT_FILE_BYTES
readonly MAX_SNAPSHOT_MEDIA_IDS=256
readonly MAX_SNAPSHOT_BYTES=$MAX_BUNDLE_BYTES
readonly MAX_SITE_API_BYTES=$((1024 * 1024))
readonly MAX_SITE_ARCHIVE_BYTES=$((512 * 1024 * 1024))
readonly SITE_CLONE_ATTEMPTS=2
readonly SITE_HTTP_ATTEMPTS=3
readonly SITE_CLONE_TIMEOUT_SECONDS=60
readonly SITE_API_ATTEMPT_TIMEOUT_SECONDS=90
readonly SITE_API_TOTAL_TIMEOUT_SECONDS=180
readonly SITE_ARCHIVE_ATTEMPT_TIMEOUT_SECONDS=900
readonly SITE_ARCHIVE_TOTAL_TIMEOUT_SECONDS=900

JSON_MODE=false
ACTION=""
ERROR_EMITTED=false
SUCCESS=false
TEST_MODE=false
TEST_LINK_FILES=false
TX_ROOT=""
OP_LOG=""
LOCK_DIR=""
LOCK_FD_OPEN=false
RELEASE_ACTIVATED=false
RELEASE_ROLLBACK_FAILED=false
BUILD_STAGING_DIRECTORY=""
NEW_RELEASE_DIRECTORY=""
FORMAL_REPOSITORY_MOVED=false
FORMAL_REPOSITORY_SWAPPED=false
OLD_CURRENT_RELEASE=""
OLD_PREVIOUS_RELEASE=""
FORMAL_REPOSITORY_BACKUP=""
CANDIDATE_REPOSITORY=""
BUNDLE_REPOSITORY=""
BUNDLE_SNAPSHOT_ROOT=""
SNAPSHOT_TOTAL_BYTES=0
declare -a SNAPSHOT_PATHS=()
declare -A SNAPSHOT_MEDIA_PRIMARY_PATHS=()
declare -A SNAPSHOT_MEDIA_HAS_THUMBNAILS=()
SITE_SOURCE_REPOSITORY=""
SITE_SOURCE_SHA=""
SITE_SOURCE_TREE_SHA=""

if [[ "${ALGAE_CONTENTCTL_TESTING:-}" == "1" && "$(realpath -m -- "$0")" != "$INSTALLED_PATH" ]]; then
  TEST_MODE=true
  [[ "${ALGAE_TEST_LINK_FILES:-}" == "1" ]] && TEST_LINK_FILES=true
fi

if $TEST_MODE && [[ -n "${ALGAE_MAX_CONTENT_FILE_BYTES:-}" ]]; then
  candidate_max_content_file_bytes=$ALGAE_MAX_CONTENT_FILE_BYTES
  production_max_digits=${#PRODUCTION_MAX_CONTENT_FILE_BYTES}
  if [[ ! "$candidate_max_content_file_bytes" =~ ^[1-9][0-9]*$ || \
        ${#candidate_max_content_file_bytes} -gt $production_max_digits ]] || \
     (( 10#$candidate_max_content_file_bytes > PRODUCTION_MAX_CONTENT_FILE_BYTES )); then
    printf 'ALGAE_MAX_CONTENT_FILE_BYTES must be between 1 and %s in test mode\n' \
      "$PRODUCTION_MAX_CONTENT_FILE_BYTES" >&2
    exit 1
  fi
  MAX_CONTENT_FILE_BYTES=$((10#$candidate_max_content_file_bytes))
fi
readonly MAX_CONTENT_FILE_BYTES

configuration_value() {
  local name=$1
  local fallback=$2
  if $TEST_MODE && [[ -n "${!name:-}" ]]; then
    printf '%s' "${!name}"
  else
    printf '%s' "$fallback"
  fi
}

CONTENT_ROOT="$(configuration_value ALGAE_CONTENT_ROOT "$DEFAULT_CONTENT_ROOT")"
CONTENT_REPOSITORY="$CONTENT_ROOT/repository"
TRANSACTION_ROOT="$CONTENT_ROOT/transactions"
INCOMING_ROOT="$(configuration_value ALGAE_INCOMING_ROOT "$DEFAULT_INCOMING_ROOT")"
SITE_ROOT="$(configuration_value ALGAE_SITE_ROOT "$DEFAULT_SITE_ROOT")"
RELEASES_ROOT="$SITE_ROOT/releases"
CURRENT_LINK="$SITE_ROOT/current"
PREVIOUS_LINK="$SITE_ROOT/previous"
SITE_REPOSITORY_URL="$(configuration_value ALGAE_SITE_REPOSITORY_URL "$DEFAULT_SITE_REPOSITORY_URL")"
SITE_REPOSITORY_API_URL="$(configuration_value ALGAE_SITE_REPOSITORY_API_URL "$DEFAULT_SITE_REPOSITORY_API_URL")"
SITE_BRANCH="$(configuration_value ALGAE_SITE_BRANCH "$DEFAULT_SITE_BRANCH")"
SERVICE_NAME="$(configuration_value ALGAE_SERVICE_NAME "$DEFAULT_SERVICE_NAME")"
HEALTH_URL="$(configuration_value ALGAE_HEALTH_URL "$DEFAULT_HEALTH_URL")"
LOCAL_BASE_URL="$(configuration_value ALGAE_LOCAL_BASE_URL "$DEFAULT_LOCAL_BASE_URL")"
PUBLIC_BASE_URL="$(configuration_value ALGAE_PUBLIC_BASE_URL "$DEFAULT_PUBLIC_BASE_URL")"
HEALTH_ATTEMPTS="$(configuration_value ALGAE_HEALTH_ATTEMPTS "20")"
GIT_BIN="$(configuration_value ALGAE_GIT_BIN "$(command -v git 2>/dev/null || true)")"
NPM_BIN="$(configuration_value ALGAE_NPM_BIN "$(command -v npm 2>/dev/null || true)")"
NODE_BIN="$(configuration_value ALGAE_NODE_BIN "$(command -v node 2>/dev/null || true)")"
SYSTEMCTL_BIN="$(configuration_value ALGAE_SYSTEMCTL_BIN "$(command -v systemctl 2>/dev/null || true)")"
CURL_BIN="$(configuration_value ALGAE_CURL_BIN "$(command -v curl 2>/dev/null || true)")"
CHMOD_BIN="$(configuration_value ALGAE_CHMOD_BIN "$(command -v chmod 2>/dev/null || true)")"
TAR_BIN="$(configuration_value ALGAE_TAR_BIN "$(command -v tar 2>/dev/null || true)")"
TIMEOUT_BIN="$(configuration_value ALGAE_TIMEOUT_BIN "$(command -v timeout 2>/dev/null || true)")"

export GIT_CONFIG_NOSYSTEM=1
export GIT_CONFIG_GLOBAL=/dev/null
export GIT_TERMINAL_PROMPT=0

usage() {
  cat >&2 <<'USAGE'
Usage:
  algae-contentctl status --json
  algae-contentctl list --json
  algae-contentctl publish --bundle /home/ubuntu/algae-content-workbench/incoming/<job-id> --json
  algae-contentctl delete --type <content-type> --id <stable-id> --json
USAGE
}

json_quote() {
  local value=$1
  value=$(printf '%s' "$value" | LC_ALL=C tr -d '\000-\010\013\014\016-\037')
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\b'/\\b}
  value=${value//$'\f'/\\f}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  value=${value//$'\t'/\\t}
  printf '"%s"' "$value"
}

emit_error() {
  local code=$1
  local message=$2
  local log_tail=${3:-}
  local error_action="unknown"
  case "$ACTION" in
    status|list|publish|delete) error_action=$ACTION ;;
  esac
  ERROR_EMITTED=true
  if $JSON_MODE; then
    printf '{"ok":false,"action":%s,"code":%s,"message":%s' "$(json_quote "$error_action")" "$(json_quote "$code")" "$(json_quote "$message")"
    if [[ -n "$log_tail" ]]; then
      printf ',"logTail":%s' "$(json_quote "$log_tail")"
    fi
    printf '}\n'
  else
    printf '%s: %s\n' "$code" "$message" >&2
    if [[ -n "$log_tail" ]]; then
      printf '%s\n' "$log_tail" >&2
    fi
  fi
}

log_tail() {
  if [[ -n "$OP_LOG" && -f "$OP_LOG" ]]; then
    tail -n 40 -- "$OP_LOG" | sed -e 's/[[:cntrl:]]\[[0-9;]*[[:alpha:]]//g'
  fi
}

fail() {
  local code=$1
  local message=$2
  local include_log=${3:-false}
  local details=""
  if $RELEASE_ACTIVATED; then
    if ! restore_release_links; then
      code="RELEASE_ROLLBACK_FAILED"
      message="$message; release rollback is incomplete and recovery state was retained"
      include_log=true
    fi
  fi
  if [[ "$include_log" == "true" ]]; then
    details=$(log_tail || true)
  fi
  emit_error "$code" "$message" "$details"
  exit 1
}

on_unexpected_error() {
  local status=$1
  trap - ERR
  local code="INTERNAL_ERROR"
  local message="The controller stopped unexpectedly"
  if $RELEASE_ACTIVATED && ! restore_release_links; then
    code="RELEASE_ROLLBACK_FAILED"
    message="The controller stopped unexpectedly and release rollback is incomplete; recovery state was retained"
  fi
  if ! $ERROR_EMITTED; then
    emit_error "$code" "$message" "$(log_tail || true)"
  fi
  exit "$status"
}

is_absolute_safe_path() {
  local value=$1
  [[ "$value" == /* ]] || return 1
  [[ "$value" != *".."* ]] || return 1
  [[ "$value" != *[!A-Za-z0-9._/-]* ]] || return 1
}

is_stable_id() {
  local value=$1
  [[ ${#value} -ge 1 && ${#value} -le 200 ]] || return 1
  [[ "$value" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]
}

is_job_id() {
  local value=$1
  [[ "$value" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$ ]]
}

is_content_type() {
  case "$1" in
    team-news|research-output|research-project|learning-resource|algae-profile|live-feed-profile|coastal-observation|science-article|team-member|collaboration|research-profile)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

route_section_for_type() {
  case "$1" in
    team-news) printf 'news' ;;
    research-output) printf 'outputs' ;;
    research-project) printf 'projects' ;;
    learning-resource) printf 'tutorials' ;;
    algae-profile) printf 'algae' ;;
    live-feed-profile) printf 'live-feeds' ;;
    coastal-observation) printf 'observations' ;;
    science-article) printf 'insights' ;;
    team-member) printf 'team' ;;
    collaboration) printf 'collaboration' ;;
    research-profile) printf 'research' ;;
    *) return 1 ;;
  esac
}

content_url() {
  local content_type=$1
  local stable_id=$2
  printf '%s/zh/%s/%s' "${PUBLIC_BASE_URL%/}" "$(route_section_for_type "$content_type")" "$stable_id"
}

local_content_url() {
  local content_type=$1
  local stable_id=$2
  printf '%s/zh/%s/%s' "${LOCAL_BASE_URL%/}" "$(route_section_for_type "$content_type")" "$stable_id"
}

assert_regular_command() {
  local name=$1
  local binary=$2
  [[ -n "$binary" && -x "$binary" ]] || fail "DEPENDENCY_MISSING" "Required command is unavailable: $name"
}

assert_no_symlink_components() {
  local path=$1
  local remaining=${path#/}
  local current="/"
  local component
  local -a components=()
  local old_ifs=$IFS
  IFS='/'
  read -r -a components <<< "$remaining"
  IFS=$old_ifs
  for component in "${components[@]}"; do
    [[ -n "$component" ]] || continue
    current="${current%/}/$component"
    if [[ -L "$current" ]]; then
      fail "UNSAFE_PATH" "Managed path contains a symbolic link"
    fi
  done
}

ensure_safe_directory() {
  local path=$1
  is_absolute_safe_path "$path" || fail "UNSAFE_PATH" "Managed path is invalid"
  assert_no_symlink_components "$path"
  mkdir -p -- "$path"
  [[ -d "$path" && ! -L "$path" ]] || fail "UNSAFE_PATH" "Managed directory is unsafe"
  assert_no_symlink_components "$path"
}

canonical_directory() {
  local path=$1
  [[ -d "$path" && ! -L "$path" ]] || return 1
  realpath -e -- "$path"
}

path_is_direct_child() {
  local path=$1
  local parent=$2
  local relative=${path#"$parent"/}
  [[ "$path" == "$parent"/* && "$relative" != */* && -n "$relative" ]]
}

assert_no_symlinks_in_tree() {
  local root=$1
  local link
  link=$(find "$root" -type l -print -quit 2>/dev/null || true)
  [[ -z "$link" ]] || fail "UNSAFE_PATH" "Repository contains a symbolic link"
}

prepare_runtime() {
  if ! $TEST_MODE && [[ $EUID -ne 0 ]]; then
    fail "PERMISSION_DENIED" "This controller must run through the restricted sudo rule"
  fi
  assert_regular_command "git" "$GIT_BIN"
  assert_regular_command "node" "$NODE_BIN"
  assert_regular_command "chmod" "$CHMOD_BIN"
  [[ "$HEALTH_ATTEMPTS" =~ ^[1-9][0-9]*$ && "$HEALTH_ATTEMPTS" -le 60 ]] || fail "CONFIGURATION_ERROR" "Health attempt count is invalid"
  ensure_safe_directory "$CONTENT_ROOT"
  ensure_safe_directory "$TRANSACTION_ROOT"
  ensure_safe_directory "$SITE_ROOT"
  ensure_safe_directory "$RELEASES_ROOT"
  ensure_safe_directory "$INCOMING_ROOT"
  [[ -d "$CONTENT_REPOSITORY" && ! -L "$CONTENT_REPOSITORY" ]] || fail "CONTENT_REPOSITORY_MISSING" "Content repository is not installed"
  [[ -d "$CONTENT_REPOSITORY/.git" ]] || fail "CONTENT_REPOSITORY_INVALID" "Content repository is not a Git working tree"
  if ! "$GIT_BIN" -C "$CONTENT_REPOSITORY" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    fail "CONTENT_REPOSITORY_INVALID" "Content repository is not a Git working tree"
  fi
  if [[ -n "$("$GIT_BIN" -C "$CONTENT_REPOSITORY" status --porcelain 2>/dev/null)" ]]; then
    fail "CONTENT_REPOSITORY_DIRTY" "Formal content repository has uncommitted changes"
  fi
  if ! $TEST_MODE; then
    [[ $(stat -c '%U' -- "$CONTENT_REPOSITORY") == "root" ]] || fail "CONTENT_REPOSITORY_INVALID" "Formal content repository must be root owned"
    local repository_mode
    repository_mode=$(stat -c '%a' -- "$CONTENT_REPOSITORY")
    [[ $((8#$repository_mode & 0022)) -eq 0 ]] || fail "CONTENT_REPOSITORY_INVALID" "Formal content repository must not be group or world writable"
  fi
  assert_no_symlinks_in_tree "$CONTENT_REPOSITORY"
}

acquire_lock() {
  local lock_file="$CONTENT_ROOT/.algae-contentctl.lock"
  if command -v flock >/dev/null 2>&1; then
    # shellcheck disable=SC3045
    exec 9>"$lock_file"
    if ! flock -n 9; then
      fail "CONTROLLER_BUSY" "Another content operation is in progress"
    fi
    LOCK_FD_OPEN=true
  else
    LOCK_DIR="$CONTENT_ROOT/.algae-contentctl.lockdir"
    if ! mkdir "$LOCK_DIR" 2>/dev/null; then
      fail "CONTROLLER_BUSY" "Another content operation is in progress"
    fi
  fi
}

release_lock() {
  if [[ -n "$LOCK_DIR" ]]; then
    rmdir -- "$LOCK_DIR" 2>/dev/null || true
  fi
  if $LOCK_FD_OPEN; then
    flock -u 9 2>/dev/null || true
  fi
}

safe_remove_transaction() {
  local path=$1
  [[ -n "$path" && -d "$path" ]] || return 0
  local root
  root=$(canonical_directory "$TRANSACTION_ROOT") || return 0
  local candidate
  candidate=$(canonical_directory "$path") || return 0
  path_is_direct_child "$candidate" "$root" || return 0
  rm -rf -- "$candidate"
}

create_transaction() {
  local label=$1
  local transaction_root
  transaction_root=$(canonical_directory "$TRANSACTION_ROOT") || fail "UNSAFE_PATH" "Transaction root is unavailable"
  local entropy
  entropy="$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM"
  TX_ROOT="$transaction_root/${label}-${entropy}"
  mkdir -m 0700 -- "$TX_ROOT"
  OP_LOG="$TX_ROOT/controller.log"
  : > "$OP_LOG"
}

assert_regular_source_tree() {
  local tree=$1
  [[ -d "$tree" && ! -L "$tree" ]] || fail "SITE_SOURCE_FAILED" "Website source content tree is missing or unsafe" true
  local unsafe_entry
  if ! unsafe_entry=$(find -P "$tree" \( -type l -o \( ! -type d ! -type f \) \) -print -quit 2>>"$OP_LOG"); then
    fail "SITE_SOURCE_FAILED" "Website source content tree cannot be inspected" true
  fi
  [[ -z "$unsafe_entry" ]] || fail "SITE_SOURCE_FAILED" "Website source content tree contains a link or special file" true
}

is_git_object_id() {
  [[ "$1" =~ ^[0-9a-f]{40}$ || "$1" =~ ^[0-9a-f]{64}$ ]]
}

clone_site_source_shallow() {
  local attempt
  for ((attempt = 1; attempt <= SITE_CLONE_ATTEMPTS; attempt += 1)); do
    rm -rf -- "$SITE_SOURCE_REPOSITORY"
    printf 'Website source shallow clone attempt %d of %d\n' "$attempt" "$SITE_CLONE_ATTEMPTS" >> "$OP_LOG"
    if (umask 022; "$TIMEOUT_BIN" --signal=TERM --kill-after=10s "${SITE_CLONE_TIMEOUT_SECONDS}s" \
      "$GIT_BIN" -c http.lowSpeedLimit=1024 -c http.lowSpeedTime=30 \
      clone --quiet --depth 1 --branch "$SITE_BRANCH" --single-branch --no-tags \
      "$SITE_REPOSITORY_URL" "$SITE_SOURCE_REPOSITORY") >>"$OP_LOG" 2>&1; then
      return 0
    fi
  done
  rm -rf -- "$SITE_SOURCE_REPOSITORY"
  return 1
}

download_site_source_file() {
  local url=$1
  local output=$2
  local maximum_bytes=$3
  local accept=$4
  local attempt_timeout=$5
  local total_timeout=$6
  rm -f -- "$output"
  if ! "$TIMEOUT_BIN" --signal=TERM --kill-after=10s "${total_timeout}s" "$CURL_BIN" \
    --fail --silent --show-error --location \
    --proto '=https' --proto-redir '=https' \
    --connect-timeout 10 --max-time "$attempt_timeout" \
    --retry "$((SITE_HTTP_ATTEMPTS - 1))" --retry-delay 2 --retry-max-time "$total_timeout" --retry-all-errors \
    --max-filesize "$maximum_bytes" \
    --user-agent "$PROGRAM_NAME/1" \
    --header "Accept: $accept" \
    --header 'X-GitHub-Api-Version: 2022-11-28' \
    --output "$output" "$url" >>"$OP_LOG" 2>&1; then
    return 1
  fi
  [[ -f "$output" && ! -L "$output" ]] || return 1
  local downloaded_bytes
  downloaded_bytes=$(stat -c '%s' -- "$output" 2>>"$OP_LOG") || return 1
  [[ "$downloaded_bytes" =~ ^[0-9]+$ && "$downloaded_bytes" -gt 0 && "$downloaded_bytes" -le "$maximum_bytes" ]]
}

read_site_source_metadata() {
  local metadata_file=$1
  local metadata_script
  metadata_script=$(cat <<'NODE'
const fs = require("fs");
const metadata = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
const commit = metadata && metadata.sha;
const tree = metadata && metadata.commit && metadata.commit.tree && metadata.commit.tree.sha;
if (typeof commit !== "string" || typeof tree !== "string") process.exit(2);
process.stdout.write(`${commit}\t${tree}\n`);
NODE
)
  local identity
  identity=$("$NODE_BIN" -e "$metadata_script" "$metadata_file" 2>>"$OP_LOG") || return 1
  IFS=$'\t' read -r SITE_SOURCE_SHA SITE_SOURCE_TREE_SHA <<< "$identity"
  is_git_object_id "$SITE_SOURCE_SHA" && is_git_object_id "$SITE_SOURCE_TREE_SHA" && \
    [[ ${#SITE_SOURCE_SHA} -eq ${#SITE_SOURCE_TREE_SHA} ]]
}

validate_site_source_archive() {
  local archive=$1
  local names_file="$TX_ROOT/site-source-archive-names.txt"
  local verbose_file="$TX_ROOT/site-source-archive-entries.txt"
  if ! LC_ALL=C "$TAR_BIN" --list --gzip --file "$archive" --quoting-style=escape >"$names_file" 2>>"$OP_LOG"; then
    return 1
  fi
  if ! LC_ALL=C "$TAR_BIN" --list --verbose --gzip --file "$archive" --quoting-style=escape >"$verbose_file" 2>>"$OP_LOG"; then
    return 1
  fi
  local validation_script
  validation_script=$(cat <<'NODE'
const fs = require("fs");
const [namesPath, verbosePath] = process.argv.slice(1);
const readLines = (file) => {
  const text = fs.readFileSync(file, "utf8");
  const lines = text.split("\n");
  if (lines.at(-1) === "") lines.pop();
  return lines;
};
const names = readLines(namesPath);
const verbose = readLines(verbosePath);
if (names.length === 0 || names.length !== verbose.length) process.exit(2);
let root = null;
let payloadEntries = 0;
const seen = new Set();
for (let index = 0; index < names.length; index += 1) {
  const name = names[index];
  const type = verbose[index][0];
  if (type !== "-" && type !== "d") process.exit(3);
  if (!name || /[\\\x00-\x1f\x7f]/.test(name) || name.startsWith("/") || seen.has(name)) process.exit(4);
  seen.add(name);
  const normalized = name.endsWith("/") ? name.slice(0, -1) : name;
  const parts = normalized.split("/");
  if (parts.some((part) => !part || part === "." || part === "..")) process.exit(5);
  if (root === null) root = parts[0];
  if (parts[0] !== root || !/^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$/.test(root)) process.exit(6);
  if (parts.slice(1).includes(".git")) process.exit(7);
  if (parts.length === 1) {
    if (type !== "d" || !name.endsWith("/")) process.exit(8);
  } else {
    payloadEntries += 1;
  }
}
if (payloadEntries === 0) process.exit(9);
NODE
)
  "$NODE_BIN" -e "$validation_script" "$names_file" "$verbose_file" >>"$OP_LOG" 2>&1
}

initialize_site_source_snapshot() {
  local expected_tree=$1
  local -a init_arguments=(init --quiet "--initial-branch=$SITE_BRANCH")
  if [[ ${#expected_tree} -eq 64 ]]; then
    init_arguments+=(--object-format=sha256)
  fi
  "$GIT_BIN" "${init_arguments[@]}" "$SITE_SOURCE_REPOSITORY" >>"$OP_LOG" 2>&1 || return 1
  "$GIT_BIN" -C "$SITE_SOURCE_REPOSITORY" config user.name "Algae Content Controller" >>"$OP_LOG" 2>&1 || return 1
  "$GIT_BIN" -C "$SITE_SOURCE_REPOSITORY" config user.email "contentctl@localhost" >>"$OP_LOG" 2>&1 || return 1
  "$GIT_BIN" -C "$SITE_SOURCE_REPOSITORY" config core.autocrlf false >>"$OP_LOG" 2>&1 || return 1
  "$GIT_BIN" -C "$SITE_SOURCE_REPOSITORY" add --all --force -- . >>"$OP_LOG" 2>&1 || return 1
  local executable_list="$TX_ROOT/site-source-executable-files.z"
  if ! find -P "$SITE_SOURCE_REPOSITORY" -path "$SITE_SOURCE_REPOSITORY/.git" -prune -o \
    -type f -perm /111 -print0 > "$executable_list" 2>>"$OP_LOG"; then
    return 1
  fi
  local executable_file
  local executable_path
  while IFS= read -r -d '' executable_file; do
    executable_path=${executable_file#"$SITE_SOURCE_REPOSITORY"/}
    [[ "$executable_path" != "$executable_file" && -n "$executable_path" ]] || return 1
    "$GIT_BIN" -C "$SITE_SOURCE_REPOSITORY" update-index --chmod=+x -- "$executable_path" >>"$OP_LOG" 2>&1 || return 1
  done < "$executable_list"
  local written_tree
  written_tree=$("$GIT_BIN" -C "$SITE_SOURCE_REPOSITORY" write-tree 2>>"$OP_LOG") || return 1
  [[ "$written_tree" == "$expected_tree" ]] || return 2
  "$GIT_BIN" -C "$SITE_SOURCE_REPOSITORY" commit --quiet --no-gpg-sign --no-verify \
    -m "site: snapshot GitHub $SITE_SOURCE_SHA" >>"$OP_LOG" 2>&1 || return 1
  [[ -z "$("$GIT_BIN" -C "$SITE_SOURCE_REPOSITORY" status --porcelain --untracked-files=all 2>>"$OP_LOG")" ]]
}

prepare_site_source_from_github_archive() {
  assert_regular_command "curl" "$CURL_BIN"
  assert_regular_command "tar" "$TAR_BIN"
  local metadata_file="$TX_ROOT/site-source-commit.json"
  local archive_file="$TX_ROOT/site-source.tar.gz"
  if ! download_site_source_file \
    "${SITE_REPOSITORY_API_URL%/}/commits/$SITE_BRANCH" "$metadata_file" "$MAX_SITE_API_BYTES" \
    'application/vnd.github+json' "$SITE_API_ATTEMPT_TIMEOUT_SECONDS" "$SITE_API_TOTAL_TIMEOUT_SECONDS"; then
    fail "SITE_SOURCE_FAILED" "Cannot query the GitHub main source metadata" true
  fi
  if ! read_site_source_metadata "$metadata_file"; then
    fail "SITE_SOURCE_FAILED" "GitHub main source commit or tree metadata is invalid" true
  fi
  if ! download_site_source_file \
    "${SITE_REPOSITORY_API_URL%/}/tarball/$SITE_SOURCE_SHA" "$archive_file" "$MAX_SITE_ARCHIVE_BYTES" \
    'application/vnd.github+json' "$SITE_ARCHIVE_ATTEMPT_TIMEOUT_SECONDS" "$SITE_ARCHIVE_TOTAL_TIMEOUT_SECONDS"; then
    fail "SITE_SOURCE_FAILED" "Cannot download the exact GitHub main source archive" true
  fi
  if ! validate_site_source_archive "$archive_file"; then
    fail "SITE_SOURCE_FAILED" "GitHub main source archive is unsafe or invalid" true
  fi
  local extraction_root="$TX_ROOT/site-source-extracted"
  mkdir -m 0700 -- "$extraction_root"
  if ! (umask 022; "$TAR_BIN" --extract --gzip --file "$archive_file" --directory "$extraction_root" \
    --strip-components=1 --no-same-owner --no-same-permissions --delay-directory-restore \
    --keep-directory-symlink) >>"$OP_LOG" 2>&1; then
    fail "SITE_SOURCE_FAILED" "Cannot safely extract the GitHub main source archive" true
  fi
  assert_regular_source_tree "$extraction_root"
  [[ ! -e "$extraction_root/.git" && ! -L "$extraction_root/.git" ]] || \
    fail "SITE_SOURCE_FAILED" "GitHub main source archive contains reserved Git metadata" true
  mv -- "$extraction_root" "$SITE_SOURCE_REPOSITORY" || \
    fail "SITE_SOURCE_FAILED" "Cannot stage the GitHub main source archive" true
  local snapshot_status=0
  initialize_site_source_snapshot "$SITE_SOURCE_TREE_SHA" || snapshot_status=$?
  if [[ $snapshot_status -eq 2 ]]; then
    fail "SITE_SOURCE_FAILED" "GitHub main source archive tree does not match the API tree" true
  fi
  [[ $snapshot_status -eq 0 ]] || fail "SITE_SOURCE_FAILED" "Cannot initialize the GitHub main source snapshot" true
}

prepare_site_source() {
  SITE_SOURCE_REPOSITORY="$TX_ROOT/site-source"
  [[ ! -e "$SITE_SOURCE_REPOSITORY" && ! -L "$SITE_SOURCE_REPOSITORY" ]] || fail "SITE_SOURCE_FAILED" "Website source staging path already exists"
  assert_regular_command "timeout" "$TIMEOUT_BIN"
  if ! clone_site_source_shallow; then
    printf 'Website source shallow clone failed; using the exact GitHub API archive fallback\n' >> "$OP_LOG"
    prepare_site_source_from_github_archive
  else
    [[ $("$GIT_BIN" -C "$SITE_SOURCE_REPOSITORY" rev-parse --is-shallow-repository 2>>"$OP_LOG") == "true" ]] || \
      fail "SITE_SOURCE_FAILED" "Website source clone is not shallow" true
    [[ $("$GIT_BIN" -C "$SITE_SOURCE_REPOSITORY" symbolic-ref --quiet --short HEAD 2>>"$OP_LOG") == "$SITE_BRANCH" ]] || \
      fail "SITE_SOURCE_FAILED" "Website source branch does not match" true
    [[ -z "$("$GIT_BIN" -C "$SITE_SOURCE_REPOSITORY" status --porcelain --untracked-files=all 2>>"$OP_LOG")" ]] || \
      fail "SITE_SOURCE_FAILED" "Website source checkout is not clean" true
    SITE_SOURCE_SHA=$("$GIT_BIN" -C "$SITE_SOURCE_REPOSITORY" rev-parse --verify HEAD 2>>"$OP_LOG") || \
      fail "SITE_SOURCE_FAILED" "Website source commit cannot be read" true
    SITE_SOURCE_TREE_SHA=$("$GIT_BIN" -C "$SITE_SOURCE_REPOSITORY" rev-parse --verify 'HEAD^{tree}' 2>>"$OP_LOG") || \
      fail "SITE_SOURCE_FAILED" "Website source tree cannot be read" true
  fi
  [[ -z "$("$GIT_BIN" -C "$SITE_SOURCE_REPOSITORY" status --porcelain --untracked-files=all 2>>"$OP_LOG")" ]] || \
    fail "SITE_SOURCE_FAILED" "Website source checkout is not clean" true
  is_git_object_id "$SITE_SOURCE_SHA" || fail "SITE_SOURCE_FAILED" "Website source commit is invalid" true
  is_git_object_id "$SITE_SOURCE_TREE_SHA" || fail "SITE_SOURCE_FAILED" "Website source tree is invalid" true
  assert_regular_source_tree "$SITE_SOURCE_REPOSITORY/content"
  if [[ -e "$SITE_SOURCE_REPOSITORY/public/images/uploads" || -L "$SITE_SOURCE_REPOSITORY/public/images/uploads" ]]; then
    assert_regular_source_tree "$SITE_SOURCE_REPOSITORY/public/images/uploads"
  fi
}

run_logged() {
  "$@" >>"$OP_LOG" 2>&1
}

git_head_or_empty() {
  local repository=$1
  "$GIT_BIN" -C "$repository" rev-parse --verify HEAD 2>/dev/null || true
}

RESOLVED_RELEASE_TARGET=""
read_release_target() {
  local link=$1
  RESOLVED_RELEASE_TARGET=""
  local target
  if $TEST_LINK_FILES; then
    [[ -f "$link" && ! -L "$link" ]] || return 0
    IFS= read -r target < "$link" || fail "RELEASE_STATE_INVALID" "Release marker is unreadable"
    target=$(realpath -e -- "$target") || fail "RELEASE_STATE_INVALID" "Release marker is broken"
  else
    [[ -L "$link" ]] || return 0
    target=$(realpath -e -- "$link") || fail "RELEASE_STATE_INVALID" "Release link is broken"
  fi
  local releases
  releases=$(canonical_directory "$RELEASES_ROOT") || fail "RELEASE_STATE_INVALID" "Release root is unavailable"
  [[ "$target" == "$releases"/* && -d "$target" ]] || fail "RELEASE_STATE_INVALID" "Release link points outside the release root"
  RESOLVED_RELEASE_TARGET="$target"
}

make_link_atomically() {
  local target=$1
  local link=$2
  local temporary="${link}.new-$$-$RANDOM"
  if $TEST_LINK_FILES; then
    printf '%s\n' "$target" > "$temporary"
  else
    ln -s -- "$target" "$temporary"
  fi
  mv -Tf -- "$temporary" "$link"
}

restore_release_links() {
  local restored=true
  if [[ -n "$OLD_CURRENT_RELEASE" ]]; then
    if ! make_link_atomically "$OLD_CURRENT_RELEASE" "$CURRENT_LINK"; then
      printf 'release rollback: cannot restore current release link\n' >>"$OP_LOG" 2>/dev/null || true
      restored=false
    fi
  else
    if ! rm -f -- "$CURRENT_LINK"; then
      printf 'release rollback: cannot remove current release link\n' >>"$OP_LOG" 2>/dev/null || true
      restored=false
    fi
  fi
  if [[ -n "$OLD_PREVIOUS_RELEASE" ]]; then
    if ! make_link_atomically "$OLD_PREVIOUS_RELEASE" "$PREVIOUS_LINK"; then
      printf 'release rollback: cannot restore previous release link\n' >>"$OP_LOG" 2>/dev/null || true
      restored=false
    fi
  else
    if ! rm -f -- "$PREVIOUS_LINK"; then
      printf 'release rollback: cannot remove previous release link\n' >>"$OP_LOG" 2>/dev/null || true
      restored=false
    fi
  fi
  if [[ -n "$SYSTEMCTL_BIN" && -x "$SYSTEMCTL_BIN" ]]; then
    if ! "$SYSTEMCTL_BIN" restart "$SERVICE_NAME" >>"$OP_LOG" 2>&1; then
      printf 'release rollback: cannot restart website service on the restored release\n' >>"$OP_LOG" 2>/dev/null || true
      restored=false
    fi
  else
    printf 'release rollback: website service manager is unavailable\n' >>"$OP_LOG" 2>/dev/null || true
    restored=false
  fi
  if $restored; then
    RELEASE_ACTIVATED=false
    RELEASE_ROLLBACK_FAILED=false
    return 0
  fi
  RELEASE_ROLLBACK_FAILED=true
  printf 'release rollback: incomplete; current, previous, service state, and new release require inspection\n' >>"$OP_LOG" 2>/dev/null || true
  return 1
}

restore_formal_repository() {
  if ! $FORMAL_REPOSITORY_MOVED; then
    return 0
  fi
  local failed_repository="$TX_ROOT/failed-repository"
  if [[ ! -d "$FORMAL_REPOSITORY_BACKUP" || -L "$FORMAL_REPOSITORY_BACKUP" ]]; then
    printf 'formal repository rollback: backup is unavailable at %s\n' "$FORMAL_REPOSITORY_BACKUP" >>"$OP_LOG" 2>/dev/null || true
    return 1
  fi

  if [[ -e "$CONTENT_REPOSITORY" || -L "$CONTENT_REPOSITORY" ]]; then
    if ! mv -- "$CONTENT_REPOSITORY" "$failed_repository" 2>/dev/null; then
      printf 'formal repository rollback: cannot move the candidate repository aside\n' >>"$OP_LOG" 2>/dev/null || true
      return 1
    fi
  fi

  if ! mv -- "$FORMAL_REPOSITORY_BACKUP" "$CONTENT_REPOSITORY" 2>/dev/null; then
    printf 'formal repository rollback: cannot restore the formal repository\n' >>"$OP_LOG" 2>/dev/null || true
    return 1
  fi

  FORMAL_REPOSITORY_MOVED=false
  FORMAL_REPOSITORY_SWAPPED=false
}

cleanup() {
  local status=$?
  local preserve_transaction=false
  trap - EXIT
  if [[ $status -ne 0 ]] && ! $SUCCESS; then
    if ! restore_formal_repository; then
      preserve_transaction=true
    fi
    if $RELEASE_ACTIVATED && ! $RELEASE_ROLLBACK_FAILED; then
      if ! restore_release_links; then
        preserve_transaction=true
      fi
    fi
  fi
  if $RELEASE_ROLLBACK_FAILED; then
    preserve_transaction=true
  fi
  if $SUCCESS && [[ -n "$FORMAL_REPOSITORY_BACKUP" && -d "$FORMAL_REPOSITORY_BACKUP" ]]; then
    rm -rf -- "$FORMAL_REPOSITORY_BACKUP" || true
  fi
  if [[ $status -ne 0 ]] && ! $SUCCESS && ! $RELEASE_ROLLBACK_FAILED; then
    local release_root=""
    release_root=$(canonical_directory "$RELEASES_ROOT" 2>/dev/null || true)
    if [[ -n "$release_root" ]]; then
      local candidate resolved
      for candidate in "$BUILD_STAGING_DIRECTORY" "$NEW_RELEASE_DIRECTORY"; do
        [[ -n "$candidate" && -e "$candidate" && ! -L "$candidate" ]] || continue
        resolved=$(realpath -e -- "$candidate" 2>/dev/null || true)
        if [[ -n "$resolved" && "$resolved" == "$release_root"/* ]]; then
          rm -rf -- "$resolved"
        fi
      done
    fi
  fi
  if $preserve_transaction; then
    printf 'algae-contentctl: rollback incomplete; transaction and release recovery state retained at %s\n' "$TX_ROOT" >&2
  else
    safe_remove_transaction "$TX_ROOT" || true
  fi
  release_lock || true
  exit "$status"
}

trap 'on_unexpected_error "$?"' ERR
trap cleanup EXIT

validate_owner_and_mode() {
  local path=$1
  if $TEST_MODE; then
    return 0
  fi
  [[ $(stat -c '%U' -- "$path") == "ubuntu" ]] || fail "UNSAFE_UPLOAD" "Uploaded files must be owned by ubuntu"
  local mode
  mode=$(stat -c '%a' -- "$path")
  [[ $((8#$mode & 0022)) -eq 0 ]] || fail "UNSAFE_UPLOAD" "Uploaded files must not be group or world writable"
  if [[ -f "$path" ]]; then
    [[ $(stat -c '%h' -- "$path") -eq 1 ]] || fail "UNSAFE_UPLOAD" "Uploaded files must not be hard linked"
  fi
}

copy_uploaded_delivery() {
  local supplied_path=$1
  is_absolute_safe_path "$supplied_path" || fail "INVALID_BUNDLE_PATH" "Bundle path must be a safe absolute directory"
  [[ -d "$supplied_path" && ! -L "$supplied_path" ]] || fail "INVALID_BUNDLE_PATH" "Bundle path must name an uploaded delivery directory"
  assert_no_symlink_components "$supplied_path"
  local incoming
  incoming=$(canonical_directory "$INCOMING_ROOT") || fail "INCOMING_ROOT_INVALID" "Incoming directory is unavailable"
  local job
  job=$(canonical_directory "$supplied_path") || fail "INVALID_BUNDLE_PATH" "Bundle directory cannot be resolved"
  path_is_direct_child "$job" "$incoming" || fail "INVALID_BUNDLE_PATH" "Bundle directory must be one job below the incoming root"
  is_job_id "$(basename -- "$job")" || fail "INVALID_BUNDLE_PATH" "Upload job id is invalid"
  validate_owner_and_mode "$job"

  local upload_copy="$TX_ROOT/upload"
  mkdir -m 0700 -- "$upload_copy"
  local entries=()
  local entry
  shopt -s nullglob dotglob
  entries=("$job"/*)
  shopt -u nullglob dotglob
  [[ ${#entries[@]} -eq 9 ]] || fail "INVALID_BUNDLE" "Delivery directory must contain exactly the standard bundle artifacts"
  for entry in "${entries[@]}"; do
    [[ -f "$entry" && ! -L "$entry" ]] || fail "UNSAFE_UPLOAD" "Delivery contains a non-regular file"
    validate_owner_and_mode "$entry"
    local size
    size=$(stat -c '%s' -- "$entry")
    [[ "$size" =~ ^[0-9]+$ && "$size" -gt 0 ]] || fail "INVALID_BUNDLE" "Delivery contains an empty artifact"
    if [[ "$size" -gt "$MAX_BUNDLE_BYTES" ]]; then
      fail "BUNDLE_TOO_LARGE" "Delivery artifact exceeds the bundle size limit"
    fi
    cp -P -- "$entry" "$upload_copy/$(basename -- "$entry")"
  done
  assert_no_symlinks_in_tree "$upload_copy"
  DELIVERY_COPY="$upload_copy"
}

declare -A MANIFEST=()
MANIFEST_BUNDLE=""
MANIFEST_BRANCH=""
MANIFEST_HEAD=""
MANIFEST_BASE=""
MANIFEST_RECORD_ID=""

parse_manifest() {
  local delivery=$1
  local manifest_file="$delivery/MANIFEST.txt"
  [[ -f "$manifest_file" && ! -L "$manifest_file" ]] || fail "INVALID_MANIFEST" "MANIFEST.txt is missing"
  [[ $(stat -c '%s' -- "$manifest_file") -le "$MAX_ARTIFACT_BYTES" ]] || fail "INVALID_MANIFEST" "MANIFEST.txt is too large"
  MANIFEST=()
  local line key value
  while IFS= read -r line || [[ -n "$line" ]]; do
    line=${line%$'\r'}
    [[ -n "$line" && "$line" == *=* ]] || fail "INVALID_MANIFEST" "MANIFEST.txt has an invalid line"
    key=${line%%=*}
    value=${line#*=}
    case "$key" in
      FormatVersion|Branch|HeadCommit|BaseCommit|BundleFile|BundleSizeBytes|BundleSha256|History|ImportBranch|ChangedFileCount|Artifacts) ;;
      *) fail "INVALID_MANIFEST" "MANIFEST.txt has an unknown field" ;;
    esac
    [[ -z "${MANIFEST[$key]+present}" ]] || fail "INVALID_MANIFEST" "MANIFEST.txt has a duplicate field"
    MANIFEST[$key]=$value
  done < "$manifest_file"
  [[ ${#MANIFEST[@]} -eq 11 ]] || fail "INVALID_MANIFEST" "MANIFEST.txt is incomplete"
  [[ ${MANIFEST[FormatVersion]} == "1" && ${MANIFEST[History]} == "complete" ]] || fail "INVALID_MANIFEST" "Bundle manifest has an unsupported format"
  MANIFEST_BRANCH=${MANIFEST[Branch]}
  if [[ "$MANIFEST_BRANCH" =~ ^content/direct-[0-9a-f]{32}-([a-z0-9]+(-[a-z0-9]+)*)$ ]]; then
    MANIFEST_RECORD_ID=${BASH_REMATCH[1]}
  elif [[ "$MANIFEST_BRANCH" =~ ^content/[0-9]{8}-([a-z0-9]+(-[a-z0-9]+)*)$ ]]; then
    MANIFEST_RECORD_ID=${BASH_REMATCH[1]}
  else
    fail "INVALID_MANIFEST" "Bundle branch is invalid"
  fi
  is_stable_id "$MANIFEST_RECORD_ID" || fail "INVALID_MANIFEST" "Bundle record id is invalid"
  MANIFEST_BUNDLE=${MANIFEST[BundleFile]}
  [[ "$MANIFEST_BUNDLE" == "${MANIFEST_BRANCH//\//-}-v1.bundle" ]] || fail "INVALID_MANIFEST" "Bundle filename does not match the branch"
  [[ "$MANIFEST_BUNDLE" =~ ^[a-z0-9-]+\.bundle$ ]] || fail "INVALID_MANIFEST" "Bundle filename is invalid"
  [[ ${MANIFEST[ImportBranch]} == "import/${MANIFEST_BRANCH//\//-}" ]] || fail "INVALID_MANIFEST" "Import branch is invalid"
  MANIFEST_HEAD=${MANIFEST[HeadCommit]}
  MANIFEST_BASE=${MANIFEST[BaseCommit]}
  [[ "$MANIFEST_HEAD" =~ ^[0-9a-f]{40}$ && "$MANIFEST_BASE" =~ ^[0-9a-f]{40}$ ]] || fail "INVALID_MANIFEST" "Bundle commit ids are invalid"
  [[ ${MANIFEST[BundleSha256]} =~ ^[0-9A-F]{64}$ ]] || fail "INVALID_MANIFEST" "Bundle SHA-256 is invalid"
  [[ ${MANIFEST[BundleSizeBytes]} =~ ^[1-9][0-9]*$ && ${MANIFEST[BundleSizeBytes]} -le $MAX_BUNDLE_BYTES ]] || fail "INVALID_MANIFEST" "Bundle size is invalid"
  [[ ${MANIFEST[ChangedFileCount]} =~ ^[0-9]+$ && ${MANIFEST[ChangedFileCount]} -le 256 ]] || fail "INVALID_MANIFEST" "Changed file count is invalid"
}

validate_delivery_artifacts() {
  local delivery=$1
  local expected_sidecar="$MANIFEST_BUNDLE.sha256.txt"
  local expected=(
    "$MANIFEST_BUNDLE"
    "$expected_sidecar"
    "MANIFEST.txt"
    "HANDOFF.md"
    "TEST-SUMMARY.txt"
    "CHANGED-FILES.txt"
    "Import-Bundle.ps1"
    "Validate-Bundle.sh"
    "validate-bundle.mjs"
  )
  local artifact_list=${MANIFEST[Artifacts]}
  local declared=()
  local old_ifs=$IFS
  IFS=','
  read -r -a declared <<< "$artifact_list"
  IFS=$old_ifs
  [[ ${#declared[@]} -eq ${#expected[@]} ]] || fail "INVALID_MANIFEST" "Manifest artifact list is invalid"
  local index
  for index in "${!expected[@]}"; do
    [[ ${declared[$index]} == "${expected[$index]}" ]] || fail "INVALID_MANIFEST" "Manifest artifact list is not the standard delivery"
    [[ -f "$delivery/${expected[$index]}" && ! -L "$delivery/${expected[$index]}" ]] || fail "INVALID_BUNDLE" "A required delivery artifact is missing"
    local size
    size=$(stat -c '%s' -- "$delivery/${expected[$index]}")
    if [[ ${expected[$index]} == "$MANIFEST_BUNDLE" ]]; then
      [[ "$size" == "${MANIFEST[BundleSizeBytes]}" ]] || fail "INVALID_BUNDLE" "Bundle size does not match the manifest"
    else
      [[ "$size" -le "$MAX_ARTIFACT_BYTES" ]] || fail "INVALID_BUNDLE" "Delivery sidecar is too large"
    fi
  done

  local actual=()
  local entry
  shopt -s nullglob dotglob
  actual=("$delivery"/*)
  shopt -u nullglob dotglob
  [[ ${#actual[@]} -eq ${#expected[@]} ]] || fail "INVALID_BUNDLE" "Delivery has unexpected artifacts"
  local sha
  sha=$(sha256sum -- "$delivery/$MANIFEST_BUNDLE" | awk '{print toupper($1)}')
  [[ "$sha" == "${MANIFEST[BundleSha256]}" ]] || fail "SHA256_MISMATCH" "Bundle SHA-256 does not match the manifest"
  local sidecar
  sidecar=$(tr -d '\r\n' < "$delivery/$expected_sidecar")
  [[ "$sidecar" == "${MANIFEST[BundleSha256]}  $MANIFEST_BUNDLE" ]] || fail "SHA256_MISMATCH" "Bundle SHA-256 sidecar does not match the manifest"
}

validate_content_path() {
  local path=$1
  [[ ${#path} -le 512 ]] || return 1
  [[ "$path" != /* && "$path" != *".."* && "$path" != *\\* ]] || return 1
  [[ "$path" != *$'\n'* && "$path" != *$'\r'* && "$path" != *$'\t'* ]] || return 1
  if [[ "$path" =~ ^content/records/([a-z-]+)/([a-z0-9]+(-[a-z0-9]+)*)/(record\.json|zh\.md|en\.md)$ ]]; then
    is_content_type "${BASH_REMATCH[1]}" && is_stable_id "${BASH_REMATCH[2]}"
    return
  fi
  if [[ "$path" =~ ^content/(authors|media)/[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$ ]]; then
    return
  fi
  if [[ "$path" =~ ^public/images/uploads/[0-9]{4}/(01|02|03|04|05|06|07|08|09|10|11|12)/([a-z0-9]+(-[a-z0-9]+)*)(\.thumbnail\.webp|\.webp|\.jpeg|\.jpg|\.png|\.avif)$ ]]; then
    is_stable_id "${BASH_REMATCH[2]}"
    return
  fi
  return 1
}

extract_record_target() {
  local path=$1
  if [[ "$path" =~ ^content/records/([a-z-]+)/([a-z0-9]+(-[a-z0-9]+)*)/ ]]; then
    printf '%s\t%s' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
  fi
}

validate_changed_files() {
  local bundle_repository=$1
  local diff_file="$TX_ROOT/diff.z"
  if ! "$GIT_BIN" -C "$bundle_repository" diff-tree --no-commit-id --name-status --no-renames -r -z "$MANIFEST_BASE" "$MANIFEST_HEAD" >"$diff_file" 2>>"$OP_LOG"; then
    fail "BUNDLE_INVALID" "Unable to inspect bundle changes" true
  fi

  CHANGED_STATUSES=()
  CHANGED_PATHS=()
  local status path
  while IFS= read -r -d '' status; do
    IFS= read -r -d '' path || fail "BUNDLE_INVALID" "Bundle diff is truncated"
    [[ "$status" == "A" || "$status" == "M" || "$status" == "D" ]] || fail "BUNDLE_INVALID" "Bundle uses an unsupported file operation"
    validate_content_path "$path" || fail "FORBIDDEN_PATH" "Bundle changes a path outside the approved content allowlist"
    CHANGED_STATUSES+=("$status")
    CHANGED_PATHS+=("$path")
  done < "$diff_file"
  [[ ${#CHANGED_PATHS[@]} -gt 0 && ${#CHANGED_PATHS[@]} -eq ${MANIFEST[ChangedFileCount]} ]] || fail "INVALID_MANIFEST" "Changed file count does not match the bundle"

  local changed_file="$TX_ROOT/changed-files.txt"
  mapfile -t manifest_paths < <(tr -d '\r' < "$TX_ROOT/upload/CHANGED-FILES.txt" | sed '/^$/d' | LC_ALL=C sort)
  mapfile -t actual_paths < <(printf '%s\n' "${CHANGED_PATHS[@]}" | LC_ALL=C sort)
  [[ ${#manifest_paths[@]} -eq ${#actual_paths[@]} ]] || fail "INVALID_MANIFEST" "Changed file list does not match the bundle"
  local index
  for index in "${!actual_paths[@]}"; do
    [[ ${manifest_paths[$index]} == "${actual_paths[$index]}" ]] || fail "INVALID_MANIFEST" "Changed file list does not match the bundle"
  done
  printf '%s\n' "${actual_paths[@]}" > "$changed_file"

  declare -A record_targets=()
  local target
  for path in "${CHANGED_PATHS[@]}"; do
    target=$(extract_record_target "$path")
    [[ -z "$target" ]] || record_targets[$target]=1
  done
  [[ ${#record_targets[@]} -eq 1 ]] || fail "INVALID_BUNDLE" "Bundle must change exactly one content record"
  local key
  for key in "${!record_targets[@]}"; do
    BUNDLE_CONTENT_TYPE=${key%%$'\t'*}
    BUNDLE_STABLE_ID=${key#*$'\t'}
  done
  [[ "$BUNDLE_STABLE_ID" == "$MANIFEST_RECORD_ID" ]] || fail "INVALID_BUNDLE" "Bundle record id does not match its branch"

  for index in "${!CHANGED_PATHS[@]}"; do
    status=${CHANGED_STATUSES[$index]}
    path=${CHANGED_PATHS[$index]}
    [[ "$status" == "D" ]] && continue
    local entry
    entry=$("$GIT_BIN" -C "$bundle_repository" ls-tree "$MANIFEST_HEAD" -- "$path" 2>>"$OP_LOG") || fail "BUNDLE_INVALID" "Bundle file cannot be read" true
    [[ ${entry%% *} == "100644" ]] || fail "BUNDLE_INVALID" "Bundle contains a non-regular content file"
    local object_size
    object_size=$("$GIT_BIN" -C "$bundle_repository" cat-file -s "$MANIFEST_HEAD:$path" 2>>"$OP_LOG") || fail "BUNDLE_INVALID" "Bundle file cannot be read" true
    [[ "$object_size" =~ ^[0-9]+$ && "$object_size" -le "$MAX_CONTENT_FILE_BYTES" ]] || fail "BUNDLE_TOO_LARGE" "Bundle contains an oversized content file"
  done
}

import_and_validate_bundle() {
  local delivery=$1
  local bundle_repository="$TX_ROOT/bundle.git"
  "$GIT_BIN" init --bare --initial-branch=main "$bundle_repository" >>"$OP_LOG" 2>&1 || fail "BUNDLE_INVALID" "Cannot create isolated bundle repository" true
  if ! "$GIT_BIN" -C "$bundle_repository" bundle verify "$delivery/$MANIFEST_BUNDLE" >>"$OP_LOG" 2>&1; then
    fail "BUNDLE_INVALID" "Git bundle verification failed" true
  fi
  local heads
  heads=$("$GIT_BIN" -C "$bundle_repository" bundle list-heads "$delivery/$MANIFEST_BUNDLE" 2>>"$OP_LOG") || fail "BUNDLE_INVALID" "Cannot read bundle heads" true
  local head ref extra
  IFS=' ' read -r head ref extra <<< "$heads"
  [[ -n "$head" && -n "$ref" && -z "$extra" && "$head" == "$MANIFEST_HEAD" && "$ref" == "refs/heads/$MANIFEST_BRANCH" ]] || fail "BUNDLE_INVALID" "Bundle must contain exactly the manifest branch"
  [[ $(printf '%s\n' "$heads" | wc -l) -eq 1 ]] || fail "BUNDLE_INVALID" "Bundle must contain exactly one head"
  if ! "$GIT_BIN" -C "$bundle_repository" fetch --quiet --no-tags "$delivery/$MANIFEST_BUNDLE" "$ref:refs/heads/incoming" >>"$OP_LOG" 2>&1; then
    fail "BUNDLE_INVALID" "Cannot import the verified bundle" true
  fi
  [[ $("$GIT_BIN" -C "$bundle_repository" rev-parse --verify refs/heads/incoming 2>>"$OP_LOG") == "$MANIFEST_HEAD" ]] || fail "BUNDLE_INVALID" "Imported bundle head does not match the manifest"
  local parents
  parents=$("$GIT_BIN" -C "$bundle_repository" rev-list --parents -n 1 "$MANIFEST_HEAD" 2>>"$OP_LOG") || fail "BUNDLE_INVALID" "Bundle commit cannot be inspected" true
  [[ "$parents" == "$MANIFEST_HEAD $MANIFEST_BASE" ]] || fail "BUNDLE_INVALID" "Bundle must have the declared single parent"
  [[ $("$GIT_BIN" -C "$bundle_repository" log -1 --format=%s "$MANIFEST_HEAD" 2>>"$OP_LOG") == "content: publish $MANIFEST_RECORD_ID" ]] || fail "BUNDLE_INVALID" "Bundle commit was not generated by the content workbench"
  validate_changed_files "$bundle_repository"
  BUNDLE_REPOSITORY="$bundle_repository"
}

bundle_tree_entry() {
  local path=$1
  "$GIT_BIN" -C "$BUNDLE_REPOSITORY" ls-tree "$MANIFEST_HEAD" -- "$path" 2>>"$OP_LOG"
}

stage_snapshot_blob() {
  local path=$1
  local entry metadata entry_path mode type object extra old_ifs size destination temporary max_content_digits
  entry=$(bundle_tree_entry "$path") || fail "BUNDLE_INVALID" "Cannot inspect the bundle snapshot tree" true
  [[ "$entry" != *$'\n'* ]] || fail "BUNDLE_INVALID" "Bundle snapshot path is ambiguous"
  [[ -n "$entry" && "$entry" == *$'\t'* ]] || fail "INVALID_BUNDLE" "Bundle snapshot is missing a required file"
  metadata=${entry%%$'\t'*}
  entry_path=${entry#*$'\t'}
  [[ "$entry_path" == "$path" ]] || fail "INVALID_BUNDLE" "Bundle snapshot path does not match the requested file"
  old_ifs=$IFS
  IFS=' '
  read -r mode type object extra <<< "$metadata"
  IFS=$old_ifs
  [[ "$mode" == "100644" && "$type" == "blob" && "$object" =~ ^[0-9a-f]{40}$ && -z "$extra" ]] || \
    fail "INVALID_BUNDLE" "Bundle snapshot contains a non-regular content file"

  size=$("$GIT_BIN" -C "$BUNDLE_REPOSITORY" cat-file -s "$object" 2>>"$OP_LOG") || \
    fail "BUNDLE_INVALID" "Cannot read a bundle snapshot file" true
  max_content_digits=${#MAX_CONTENT_FILE_BYTES}
  [[ "$size" =~ ^[0-9]+$ && ${#size} -le $max_content_digits ]] || \
    fail "BUNDLE_TOO_LARGE" "Bundle snapshot contains an empty or oversized file"
  (( 10#$size > 0 && 10#$size <= MAX_CONTENT_FILE_BYTES )) || \
    fail "BUNDLE_TOO_LARGE" "Bundle snapshot contains an empty or oversized file"
  (( 10#$size <= MAX_SNAPSHOT_BYTES - SNAPSHOT_TOTAL_BYTES )) || \
    fail "BUNDLE_TOO_LARGE" "Bundle snapshot exceeds the total size limit"
  SNAPSHOT_TOTAL_BYTES=$((SNAPSHOT_TOTAL_BYTES + 10#$size))

  destination="$BUNDLE_SNAPSHOT_ROOT/$path"
  mkdir -p -- "$(dirname -- "$destination")"
  temporary="$destination.incoming"
  if ! "$GIT_BIN" -C "$BUNDLE_REPOSITORY" cat-file blob "$object" >"$temporary" 2>>"$OP_LOG"; then
    rm -f -- "$temporary"
    fail "BUNDLE_INVALID" "Cannot extract a bundle snapshot file" true
  fi
  [[ $(stat -c '%s' -- "$temporary") == "$size" ]] || fail "BUNDLE_INVALID" "Bundle snapshot file size changed during extraction"
  chmod 0600 -- "$temporary"
  mv -- "$temporary" "$destination"
  SNAPSHOT_PATHS+=("$path")
}

prepare_record_snapshot() {
  local record_root="content/records/$BUNDLE_CONTENT_TYPE/$BUNDLE_STABLE_ID"
  local tree_file="$TX_ROOT/record-snapshot-tree.z"
  "$GIT_BIN" -C "$BUNDLE_REPOSITORY" ls-tree -r -z "$MANIFEST_HEAD" -- "$record_root" >"$tree_file" 2>>"$OP_LOG" || \
    fail "BUNDLE_INVALID" "Cannot inspect the bundle record snapshot" true
  local -a entries=()
  mapfile -d '' -t entries < "$tree_file"
  [[ ${#entries[@]} -ge 2 && ${#entries[@]} -le 3 ]] || \
    fail "INVALID_BUNDLE" "Bundle record snapshot must contain only record.json, zh.md, and optional en.md"

  local record_seen=false zh_seen=false en_seen=false entry metadata path
  for entry in "${entries[@]}"; do
    [[ "$entry" == *$'\t'* ]] || fail "INVALID_BUNDLE" "Bundle record snapshot entry is invalid"
    metadata=${entry%%$'\t'*}
    path=${entry#*$'\t'}
    [[ "$metadata" == 100644\ blob\ * ]] || fail "INVALID_BUNDLE" "Bundle record snapshot contains a non-regular file"
    case "$path" in
      "$record_root/record.json") $record_seen && fail "INVALID_BUNDLE" "Bundle record snapshot contains a duplicate record"; record_seen=true ;;
      "$record_root/zh.md") $zh_seen && fail "INVALID_BUNDLE" "Bundle record snapshot contains duplicate Chinese content"; zh_seen=true ;;
      "$record_root/en.md") $en_seen && fail "INVALID_BUNDLE" "Bundle record snapshot contains duplicate English content"; en_seen=true ;;
      *) fail "INVALID_BUNDLE" "Bundle record snapshot contains an unexpected path" ;;
    esac
  done
  $record_seen && $zh_seen || fail "INVALID_BUNDLE" "Bundle record snapshot is incomplete"

  stage_snapshot_blob "$record_root/record.json"
  stage_snapshot_blob "$record_root/zh.md"
  $en_seen && stage_snapshot_blob "$record_root/en.md"

  local media_ids_file="$TX_ROOT/record-media-ids.txt"
  local validation_script
  validation_script=$(cat <<'NODE'
const fs = require("fs");
const path = require("path");
const [recordPath, recordDirectory, expectedType, expectedId, maximumMediaIds] = process.argv.slice(1);
try {
  const record = JSON.parse(fs.readFileSync(recordPath, "utf8"));
  if (record.id !== expectedId || record.type !== expectedType) throw new Error("record identity");
  const zh = record.locales && record.locales.zh;
  if (!zh || typeof zh.title !== "string" || !zh.title.trim()) throw new Error("Chinese title");
  if (zh.bodyFile !== "zh.md") throw new Error("Chinese body filename");
  if (!fs.readFileSync(path.join(recordDirectory, "zh.md"), "utf8").trim()) throw new Error("Chinese body");
  const en = record.locales && record.locales.en;
  const hasEnglishBody = fs.existsSync(path.join(recordDirectory, "en.md"));
  if (en && Object.prototype.hasOwnProperty.call(en, "bodyFile")) {
    if (en.bodyFile !== "en.md" || !hasEnglishBody) throw new Error("English body filename");
    if (!fs.readFileSync(path.join(recordDirectory, "en.md"), "utf8").trim()) throw new Error("English body");
  } else if (hasEnglishBody) {
    throw new Error("unreferenced English body");
  }
  if (!Array.isArray(record.media) || record.media.length > Number(maximumMediaIds)) throw new Error("record media list");
  const stableId = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;
  const unique = new Set();
  for (const id of record.media) {
    if (typeof id !== "string" || id.length > 200 || !stableId.test(id) || unique.has(id)) throw new Error("record media id");
    unique.add(id);
  }
  process.stdout.write([...unique].join("\n"));
} catch (error) {
  process.stderr.write(String(error.message || error));
  process.exit(1);
}
NODE
)
  if ! "$NODE_BIN" -e "$validation_script" \
    "$BUNDLE_SNAPSHOT_ROOT/$record_root/record.json" "$BUNDLE_SNAPSHOT_ROOT/$record_root" \
    "$BUNDLE_CONTENT_TYPE" "$BUNDLE_STABLE_ID" "$MAX_SNAPSHOT_MEDIA_IDS" >"$media_ids_file" 2>>"$OP_LOG"; then
    fail "INVALID_BUNDLE" "Bundle record snapshot has invalid identity, body references, or media ids" true
  fi
}

prepare_media_snapshot() {
  local media_ids_file="$TX_ROOT/record-media-ids.txt"
  local -a media_ids=()
  [[ ! -s "$media_ids_file" ]] || mapfile -t media_ids < "$media_ids_file"
  local media_id metadata_path metadata_file primary_path thumbnail_path entry validation_script
  local metadata_values_file expected_sha256 expected_bytes actual_sha256 actual_bytes
  validation_script=$(cat <<'NODE'
const fs = require("fs");
const [metadataPath, expectedId] = process.argv.slice(1);
try {
  const metadata = JSON.parse(fs.readFileSync(metadataPath, "utf8"));
  if (!metadata || metadata.id !== expectedId || typeof metadata.filePath !== "string") throw new Error("media identity or file path");
  if (!metadata.filePath.length || metadata.filePath.length > 512 || /[\u0000-\u001f\u007f]/.test(metadata.filePath)) throw new Error("media file path bounds");
  if (typeof metadata.sha256 !== "string" || !/^[0-9a-f]{64}$/.test(metadata.sha256)) throw new Error("media sha256");
  if (!Number.isSafeInteger(metadata.bytes) || metadata.bytes <= 0) throw new Error("media bytes");
  process.stdout.write(`${metadata.filePath}\n${metadata.sha256}\n${metadata.bytes}\n`);
} catch (error) {
  process.stderr.write(String(error.message || error));
  process.exit(1);
}
NODE
)
  for media_id in "${media_ids[@]}"; do
    is_stable_id "$media_id" || fail "INVALID_BUNDLE" "Bundle record snapshot contains an invalid media id"
    metadata_path="content/media/$media_id.json"
    stage_snapshot_blob "$metadata_path"
    metadata_file="$BUNDLE_SNAPSHOT_ROOT/$metadata_path"
    metadata_values_file="$TX_ROOT/media-$media_id-values.txt"
    if ! "$NODE_BIN" -e "$validation_script" "$metadata_file" "$media_id" \
      >"$metadata_values_file" 2>>"$OP_LOG"; then
      fail "INVALID_BUNDLE" "Bundle media snapshot has invalid metadata identity or file path" true
    fi
    local -a metadata_values=()
    mapfile -t metadata_values < "$metadata_values_file"
    [[ ${#metadata_values[@]} -eq 3 ]] || fail "INVALID_BUNDLE" "Bundle media snapshot metadata is incomplete"
    primary_path=${metadata_values[0]}
    expected_sha256=${metadata_values[1]}
    expected_bytes=${metadata_values[2]}
    validate_content_path "$primary_path" || fail "INVALID_BUNDLE" "Bundle media snapshot primary path is outside the upload allowlist"
    [[ "$primary_path" =~ ^public/images/uploads/[0-9]{4}/(01|02|03|04|05|06|07|08|09|10|11|12)/${media_id}(\.webp|\.jpeg|\.jpg|\.png|\.avif)$ ]] || \
      fail "INVALID_BUNDLE" "Bundle media snapshot primary path does not match its media id"
    stage_snapshot_blob "$primary_path"
    actual_bytes=$(stat -c '%s' -- "$BUNDLE_SNAPSHOT_ROOT/$primary_path") || \
      fail "BUNDLE_INVALID" "Cannot inspect the bundle media snapshot file" true
    actual_sha256=$(sha256sum -- "$BUNDLE_SNAPSHOT_ROOT/$primary_path" | awk '{print $1}') || \
      fail "BUNDLE_INVALID" "Cannot hash the bundle media snapshot file" true
    [[ "$actual_bytes" == "$expected_bytes" && "$actual_sha256" == "$expected_sha256" ]] || \
      fail "INVALID_BUNDLE" "Bundle media snapshot does not match its declared bytes and sha256"
    SNAPSHOT_MEDIA_PRIMARY_PATHS[$media_id]=$primary_path
    thumbnail_path="${primary_path%/*}/$media_id.thumbnail.webp"
    entry=$(bundle_tree_entry "$thumbnail_path") || fail "BUNDLE_INVALID" "Cannot inspect the bundle snapshot tree" true
    [[ "$entry" != *$'\n'* ]] || fail "BUNDLE_INVALID" "Bundle snapshot path is ambiguous"
    if [[ -n "$entry" ]]; then
      stage_snapshot_blob "$thumbnail_path"
      SNAPSHOT_MEDIA_HAS_THUMBNAILS[$media_id]=1
    fi
  done
}

prepare_bundle_snapshot() {
  BUNDLE_SNAPSHOT_ROOT="$TX_ROOT/bundle-snapshot"
  mkdir -m 0700 -- "$BUNDLE_SNAPSHOT_ROOT"
  SNAPSHOT_TOTAL_BYTES=0
  SNAPSHOT_PATHS=()
  SNAPSHOT_MEDIA_PRIMARY_PATHS=()
  SNAPSHOT_MEDIA_HAS_THUMBNAILS=()
  prepare_record_snapshot
  prepare_media_snapshot
}

snapshot_contains_path() {
  local expected=$1
  local path
  for path in "${SNAPSHOT_PATHS[@]}"; do
    [[ "$path" == "$expected" ]] && return 0
  done
  return 1
}

validate_changed_paths_against_snapshot() {
  local record_root="content/records/$BUNDLE_CONTENT_TYPE/$BUNDLE_STABLE_ID/"
  local path
  for path in "${CHANGED_PATHS[@]}"; do
    if [[ "$path" == "$record_root"record.json || "$path" == "$record_root"zh.md || "$path" == "$record_root"en.md ]]; then
      continue
    fi
    snapshot_contains_path "$path" || fail "INVALID_BUNDLE" "Bundle changes a path outside the target record snapshot"
  done
}

clone_candidate_repository() {
  local action_label=$1
  CANDIDATE_REPOSITORY="$TX_ROOT/candidate-content"
  local source_head
  source_head=$(git_head_or_empty "$CONTENT_REPOSITORY")
  FORMAL_CONTENT_HEAD="$source_head"
  if ! "$GIT_BIN" clone --quiet --no-hardlinks "$CONTENT_REPOSITORY" "$CANDIDATE_REPOSITORY" >>"$OP_LOG" 2>&1; then
    fail "CONTENT_REPOSITORY_INVALID" "Cannot clone the formal content repository" true
  fi
  assert_no_symlinks_in_tree "$CANDIDATE_REPOSITORY"
  local remote
  while IFS= read -r remote; do
    [[ -n "$remote" ]] || continue
    "$GIT_BIN" -C "$CANDIDATE_REPOSITORY" remote remove "$remote" >>"$OP_LOG" 2>&1 || \
      fail "CONTENT_REPOSITORY_INVALID" "Cannot detach the candidate from the formal repository" true
  done < <("$GIT_BIN" -C "$CANDIDATE_REPOSITORY" remote 2>>"$OP_LOG")
  "$GIT_BIN" -C "$CANDIDATE_REPOSITORY" config user.name "Algae Content Controller" >>"$OP_LOG" 2>&1
  "$GIT_BIN" -C "$CANDIDATE_REPOSITORY" config user.email "algae-contentctl@localhost" >>"$OP_LOG" 2>&1
  mkdir -p -- "$CANDIDATE_REPOSITORY/content/authors" "$CANDIDATE_REPOSITORY/content/media" "$CANDIDATE_REPOSITORY/content/records" "$CANDIDATE_REPOSITORY/public/images/uploads"
}

formal_repository_is_initial_placeholder() {
  local commit_count subject tracked_file
  commit_count=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" rev-list --count HEAD 2>>"$OP_LOG") || return 1
  [[ "$commit_count" == "1" ]] || return 1
  subject=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" log -1 --format=%s HEAD 2>>"$OP_LOG") || return 1
  [[ "$subject" == "content: initialize repository" ]] || return 1

  tracked_file="$TX_ROOT/formal-placeholder-files.z"
  "$GIT_BIN" -C "$CONTENT_REPOSITORY" ls-files -z >"$tracked_file" 2>>"$OP_LOG" || return 1
  local -a tracked_paths=()
  mapfile -d '' -t tracked_paths < "$tracked_file"
  if [[ ${#tracked_paths[@]} -eq 3 ]]; then
    [[ "${tracked_paths[0]}" == "content/authors/.gitkeep" && \
       "${tracked_paths[1]}" == "content/media/.gitkeep" && \
       "${tracked_paths[2]}" == "content/records/.gitkeep" ]] || return 1
  elif [[ ${#tracked_paths[@]} -eq 4 ]]; then
    [[ "${tracked_paths[0]}" == "content/authors/.gitkeep" && \
       "${tracked_paths[1]}" == "content/media/.gitkeep" && \
       "${tracked_paths[2]}" == "content/records/.gitkeep" && \
       "${tracked_paths[3]}" == "public/images/uploads/.gitkeep" ]] || return 1
  else
    return 1
  fi

  local path
  for path in "${tracked_paths[@]}"; do
    [[ -f "$CONTENT_REPOSITORY/$path" && ! -L "$CONTENT_REPOSITORY/$path" ]] || return 1
  done
}

bootstrap_candidate_if_placeholder() {
  formal_repository_is_initial_placeholder || return 0
  [[ -n "$SITE_SOURCE_REPOSITORY" && -d "$SITE_SOURCE_REPOSITORY/content" ]] || \
    fail "SITE_SOURCE_FAILED" "Prepared website source is unavailable for content bootstrap" true
  [[ ! -L "$CANDIDATE_REPOSITORY/content" && \
     ! -L "$CANDIDATE_REPOSITORY/public" && \
     ! -L "$CANDIDATE_REPOSITORY/public/images" && \
     ! -L "$CANDIDATE_REPOSITORY/public/images/uploads" ]] || \
    fail "CONTENT_REPOSITORY_INVALID" "Candidate content path is unsafe"

  rm -rf -- "$CANDIDATE_REPOSITORY/content" "$CANDIDATE_REPOSITORY/public/images/uploads"
  mkdir -p -- "$CANDIDATE_REPOSITORY/content" "$CANDIDATE_REPOSITORY/public/images/uploads"
  cp -a -- "$SITE_SOURCE_REPOSITORY/content/." "$CANDIDATE_REPOSITORY/content/"
  if [[ -d "$SITE_SOURCE_REPOSITORY/public/images/uploads" ]]; then
    cp -a -- "$SITE_SOURCE_REPOSITORY/public/images/uploads/." "$CANDIDATE_REPOSITORY/public/images/uploads/"
  else
    touch "$CANDIDATE_REPOSITORY/public/images/uploads/.gitkeep"
  fi
  find -P "$CANDIDATE_REPOSITORY/content" "$CANDIDATE_REPOSITORY/public/images/uploads" -type d -exec chmod 0755 -- {} +
  find -P "$CANDIDATE_REPOSITORY/content" "$CANDIDATE_REPOSITORY/public/images/uploads" -type f -exec chmod 0644 -- {} +
  "$GIT_BIN" -C "$CANDIDATE_REPOSITORY" add --all -- content public/images/uploads >>"$OP_LOG" 2>&1 || \
    fail "CONTENT_COMMIT_FAILED" "Cannot stage fresh-main bootstrap content" true
  if ! "$GIT_BIN" -C "$CANDIDATE_REPOSITORY" diff --cached --quiet; then
    "$GIT_BIN" -C "$CANDIDATE_REPOSITORY" commit --quiet --no-gpg-sign --no-verify \
      -m "content: bootstrap from site main $SITE_SOURCE_SHA" >>"$OP_LOG" 2>&1 || \
      fail "CONTENT_COMMIT_FAILED" "Cannot commit fresh-main bootstrap content" true
  fi
}

validate_shared_snapshot_media() {
  local media_ids_file="$TX_ROOT/record-media-ids.txt"
  [[ -s "$media_ids_file" ]] || return 0
  local shared_ids_file="$TX_ROOT/shared-snapshot-media-ids.txt"
  local scan_script
  scan_script=$(cat <<'NODE'
const fs = require("fs");
const path = require("path");
const [recordsRoot, targetDirectory, mediaIdsPath] = process.argv.slice(1);
try {
  const wanted = new Set(fs.readFileSync(mediaIdsPath, "utf8").split(/\r?\n/).filter(Boolean));
  const shared = new Set();
  const collectMediaReferences = (record) => {
    const referenced = new Set(Array.isArray(record.media) ? record.media : []);
    const visit = (value) => {
      if (!value || typeof value !== "object") return;
      for (const [key, child] of Object.entries(value)) {
        if ((key === "mediaId" || /MediaId$/.test(key)) && typeof child === "string") referenced.add(child);
        if ((key === "mediaIds" || /MediaIds$/.test(key)) && Array.isArray(child)) {
          for (const id of child) if (typeof id === "string") referenced.add(id);
        }
        if (child && typeof child === "object") visit(child);
      }
    };
    visit(record.shared);
    return referenced;
  };
  if (fs.existsSync(recordsRoot)) {
    for (const typeEntry of fs.readdirSync(recordsRoot, { withFileTypes: true })) {
      if (!typeEntry.isDirectory()) continue;
      const typeDirectory = path.join(recordsRoot, typeEntry.name);
      for (const recordEntry of fs.readdirSync(typeDirectory, { withFileTypes: true })) {
        if (!recordEntry.isDirectory()) continue;
        const recordDirectory = path.join(typeDirectory, recordEntry.name);
        if (path.resolve(recordDirectory) === path.resolve(targetDirectory)) continue;
        const recordPath = path.join(recordDirectory, "record.json");
        if (!fs.existsSync(recordPath)) continue;
        const record = JSON.parse(fs.readFileSync(recordPath, "utf8"));
        for (const id of collectMediaReferences(record)) if (wanted.has(id)) shared.add(id);
      }
    }
  }
  process.stdout.write([...shared].sort().join("\n"));
} catch (error) {
  process.stderr.write(String(error.message || error));
  process.exit(1);
}
NODE
)
  local target_directory="$CANDIDATE_REPOSITORY/content/records/$BUNDLE_CONTENT_TYPE/$BUNDLE_STABLE_ID"
  if ! "$NODE_BIN" -e "$scan_script" "$CANDIDATE_REPOSITORY/content/records" \
    "$target_directory" "$media_ids_file" >"$shared_ids_file" 2>>"$OP_LOG"; then
    fail "CONTENT_REPOSITORY_INVALID" "Cannot inspect candidate records for shared media" true
  fi

  local -a shared_ids=()
  [[ ! -s "$shared_ids_file" ]] || mapfile -t shared_ids < "$shared_ids_file"
  local media_id path
  local -a protected_paths=()
  for media_id in "${shared_ids[@]}"; do
    [[ -n "${SNAPSHOT_MEDIA_PRIMARY_PATHS[$media_id]:-}" ]] || \
      fail "BUNDLE_INVALID" "Prepared shared media snapshot is incomplete"
    protected_paths=(
      "content/media/$media_id.json"
      "${SNAPSHOT_MEDIA_PRIMARY_PATHS[$media_id]}"
    )
    if [[ "${SNAPSHOT_MEDIA_HAS_THUMBNAILS[$media_id]:-}" == "1" ]]; then
      protected_paths+=("${SNAPSHOT_MEDIA_PRIMARY_PATHS[$media_id]%/*}/$media_id.thumbnail.webp")
    fi
    for path in "${protected_paths[@]}"; do
      [[ -f "$CANDIDATE_REPOSITORY/$path" && ! -L "$CANDIDATE_REPOSITORY/$path" ]] || \
        fail "INVALID_BUNDLE" "Bundle would replace a shared media file that is missing from the formal content"
      cmp -s -- "$BUNDLE_SNAPSHOT_ROOT/$path" "$CANDIDATE_REPOSITORY/$path" || \
        fail "INVALID_BUNDLE" "Bundle would change media shared by another content record"
    done
  done
}

install_bundle_snapshot() {
  local record_root="content/records/$BUNDLE_CONTENT_TYPE/$BUNDLE_STABLE_ID"
  local record_destination="$CANDIDATE_REPOSITORY/$record_root"
  assert_no_symlinks_in_tree "$CANDIDATE_REPOSITORY"
  [[ ! -L "$record_destination" ]] || fail "CONTENT_REPOSITORY_INVALID" "Candidate record path is unsafe"
  rm -rf -- "$record_destination"

  local path source destination parent temporary
  for path in "${SNAPSHOT_PATHS[@]}"; do
    source="$BUNDLE_SNAPSHOT_ROOT/$path"
    [[ -f "$source" && ! -L "$source" ]] || fail "BUNDLE_INVALID" "Prepared bundle snapshot file is unavailable"
    destination="$CANDIDATE_REPOSITORY/$path"
    parent=$(dirname -- "$destination")
    mkdir -p -- "$parent"
    [[ -d "$parent" && ! -L "$parent" && ! -L "$destination" ]] || fail "CONTENT_REPOSITORY_INVALID" "Candidate snapshot path is unsafe"
    temporary="$parent/.${path##*/}.snapshot-$$-$RANDOM"
    cp -- "$source" "$temporary"
    chmod 0644 -- "$temporary"
    mv -f -- "$temporary" "$destination"
  done
  assert_no_symlinks_in_tree "$CANDIDATE_REPOSITORY"
}

validate_candidate_record() {
  local content_type=$1
  local stable_id=$2
  local record_directory="$CANDIDATE_REPOSITORY/content/records/$content_type/$stable_id"
  [[ -d "$record_directory" && ! -L "$record_directory" ]] || fail "INVALID_BUNDLE" "Bundle does not leave a publishable record"
  local validation_script
  validation_script=$(cat <<'NODE'
const fs = require("fs");
const path = require("path");
const [directory, expectedType, expectedId] = process.argv.slice(1);
try {
  const record = JSON.parse(fs.readFileSync(path.join(directory, "record.json"), "utf8"));
  if (record.id !== expectedId || record.type !== expectedType) throw new Error("record identity");
  const zh = record.locales && record.locales.zh;
  if (!zh || typeof zh.title !== "string" || !zh.title.trim()) throw new Error("Chinese title");
  if (typeof zh.bodyFile !== "string" || !/^[a-z0-9][a-z0-9._-]*\.md$/.test(zh.bodyFile)) throw new Error("Chinese body filename");
  const body = fs.readFileSync(path.join(directory, zh.bodyFile), "utf8");
  if (!body.trim()) throw new Error("Chinese body");
} catch (error) {
  process.stderr.write(String(error.message || error));
  process.exit(1);
}
NODE
)
  if ! "$NODE_BIN" -e "$validation_script" "$record_directory" "$content_type" "$stable_id" >>"$OP_LOG" 2>&1; then
    fail "INVALID_BUNDLE" "Bundle record is missing required Chinese content" true
  fi
}

commit_candidate() {
  local message=$1
  "$GIT_BIN" -C "$CANDIDATE_REPOSITORY" add --all -- content public/images/uploads >>"$OP_LOG" 2>&1 || fail "CONTENT_COMMIT_FAILED" "Cannot stage candidate content" true
  if "$GIT_BIN" -C "$CANDIDATE_REPOSITORY" diff --cached --quiet; then
    fail "NO_CONTENT_CHANGE" "Candidate content has no changes to publish"
  fi
  if ! "$GIT_BIN" -C "$CANDIDATE_REPOSITORY" commit --quiet --no-gpg-sign --no-verify -m "$message" >>"$OP_LOG" 2>&1; then
    fail "CONTENT_COMMIT_FAILED" "Cannot create the candidate content commit" true
  fi
  CANDIDATE_CONTENT_SHA=$("$GIT_BIN" -C "$CANDIDATE_REPOSITORY" rev-parse --verify HEAD 2>>"$OP_LOG") || fail "CONTENT_COMMIT_FAILED" "Candidate commit cannot be read" true
}

run_build_command() {
  local build_directory=$1
  shift
  (
    cd "$build_directory"
    CONTENT_REPOSITORY_SOURCE=records "$@"
  ) >>"$OP_LOG" 2>&1
}

write_records_runtime_config() {
  local build_directory=$1
  local runtime_environment="$build_directory/.env.production.local"
  [[ ! -e "$runtime_environment" && ! -L "$runtime_environment" ]] || \
    fail "BUILD_FAILED" "Website source runtime environment file is reserved" true
  if ! printf '%s\n' 'CONTENT_REPOSITORY_SOURCE=records' > "$runtime_environment"; then
    fail "BUILD_FAILED" "Website runtime content source cannot be configured" true
  fi
  "$CHMOD_BIN" 0644 -- "$runtime_environment" || \
    fail "BUILD_FAILED" "Website runtime content source permissions cannot be configured" true
}

build_release() {
  local content_type=$1
  local stable_id=$2
  assert_regular_command "npm" "$NPM_BIN"
  umask 022
  local build_directory="$RELEASES_ROOT/.candidate-$ACTION-$$-$RANDOM"
  BUILD_STAGING_DIRECTORY="$build_directory"
  [[ ! -e "$build_directory" ]] || fail "BUILD_FAILED" "Release staging directory already exists"
  [[ -n "$SITE_SOURCE_REPOSITORY" && -d "$SITE_SOURCE_REPOSITORY/.git" ]] || fail "SITE_SOURCE_FAILED" "Prepared website source is unavailable" true
  if ! cp -a -- "$SITE_SOURCE_REPOSITORY" "$build_directory" >>"$OP_LOG" 2>&1; then
    fail "SITE_SOURCE_FAILED" "Cannot copy the prepared website source" true
  fi
  "$CHMOD_BIN" -R a+rX -- "$build_directory" || fail "SITE_SOURCE_FAILED" "Cannot make the prepared website source readable" true
  local build_source_tree_sha
  build_source_tree_sha=$("$GIT_BIN" -C "$build_directory" rev-parse --verify 'HEAD^{tree}' 2>>"$OP_LOG") || fail "SITE_SOURCE_FAILED" "Prepared website source tree cannot be read" true
  [[ "$build_source_tree_sha" == "$SITE_SOURCE_TREE_SHA" ]] || fail "SITE_SOURCE_FAILED" "Prepared website source tree changed during the transaction" true
  [[ -z "$("$GIT_BIN" -C "$build_directory" status --porcelain --untracked-files=all 2>>"$OP_LOG")" ]] || fail "SITE_SOURCE_FAILED" "Prepared website source changed during the transaction" true
  [[ ! -L "$build_directory/content" ]] || fail "BUILD_FAILED" "Website source content directory is unsafe"
  rm -rf -- "$build_directory/content"
  cp -a -- "$CANDIDATE_REPOSITORY/content" "$build_directory/content"
  chmod -R a+rX -- "$build_directory/content"
  [[ ! -L "$build_directory/public" && ! -L "$build_directory/public/images" && ! -L "$build_directory/public/images/uploads" ]] || fail "BUILD_FAILED" "Website upload directory is unsafe"
  mkdir -p -- "$build_directory/public/images"
  rm -rf -- "$build_directory/public/images/uploads"
  cp -a -- "$CANDIDATE_REPOSITORY/public/images/uploads" "$build_directory/public/images/uploads"
  chmod -R a+rX -- "$build_directory/public/images/uploads"
  write_records_runtime_config "$build_directory"
  if ! run_build_command "$build_directory" "$NPM_BIN" ci --include=dev; then
    fail "BUILD_FAILED" "Website dependency installation failed" true
  fi
  if ! run_build_command "$build_directory" "$NPM_BIN" run check; then
    fail "BUILD_FAILED" "Website check failed" true
  fi
  if ! run_build_command "$build_directory" "$NPM_BIN" run build:next; then
    fail "BUILD_FAILED" "Website build failed" true
  fi

  RELEASE_NAME="$(date -u +%Y%m%dT%H%M%SZ)-${SITE_SOURCE_SHA:0:12}-${CANDIDATE_CONTENT_SHA:0:12}"
  RELEASE_DIRECTORY="$RELEASES_ROOT/$RELEASE_NAME"
  [[ ! -e "$RELEASE_DIRECTORY" ]] || fail "BUILD_FAILED" "Release identifier already exists"
  printf '%s\n' "$SITE_SOURCE_SHA" > "$build_directory/.release-sha"
  printf '%s\n' "$CANDIDATE_CONTENT_SHA" > "$build_directory/.content-sha"
  printf '%s\n' "$RELEASE_NAME" > "$build_directory/.release-id"
  mv -- "$build_directory" "$RELEASE_DIRECTORY"
  BUILD_STAGING_DIRECTORY=""
  NEW_RELEASE_DIRECTORY="$RELEASE_DIRECTORY"
}

activate_release() {
  assert_regular_command "systemctl" "$SYSTEMCTL_BIN"
  assert_regular_command "curl" "$CURL_BIN"
  read_release_target "$CURRENT_LINK"
  OLD_CURRENT_RELEASE=$RESOLVED_RELEASE_TARGET
  read_release_target "$PREVIOUS_LINK"
  OLD_PREVIOUS_RELEASE=$RESOLVED_RELEASE_TARGET
  RELEASE_ACTIVATED=true
  if [[ -n "$OLD_CURRENT_RELEASE" ]]; then
    make_link_atomically "$OLD_CURRENT_RELEASE" "$PREVIOUS_LINK" || fail "RELEASE_SWITCH_FAILED" "Cannot update the previous release link" true
  else
    rm -f -- "$PREVIOUS_LINK"
  fi
  make_link_atomically "$RELEASE_DIRECTORY" "$CURRENT_LINK" || fail "RELEASE_SWITCH_FAILED" "Cannot switch the current release link" true
  if ! run_logged "$SYSTEMCTL_BIN" restart "$SERVICE_NAME"; then
    fail "SERVICE_RESTART_FAILED" "Website service restart failed" true
  fi
  local attempt
  local healthy=false
  for ((attempt = 1; attempt <= HEALTH_ATTEMPTS; attempt += 1)); do
    if run_logged "$CURL_BIN" --fail --silent --show-error --max-time 10 "$HEALTH_URL"; then
      healthy=true
      break
    fi
    [[ $attempt -eq $HEALTH_ATTEMPTS ]] || sleep 1
  done
  if ! $healthy; then
    fail "HEALTH_CHECK_FAILED" "Website health check failed" true
  fi
}

verify_deleted_url() {
  local url=$1
  local response_code
  response_code=$("$CURL_BIN" --silent --show-error --output /dev/null --write-out '%{http_code}' --max-time 10 "$url" 2>>"$OP_LOG") || fail "DELETE_VERIFICATION_FAILED" "Cannot verify the deleted content URL" true
  [[ "$response_code" == "404" || "$response_code" == "410" ]] || fail "DELETE_VERIFICATION_FAILED" "Deleted content URL is still available"
}

verify_published_url() {
  local url=$1
  if ! run_logged "$CURL_BIN" --fail --silent --show-error --output /dev/null --max-time 10 "$url"; then
    fail "PUBLISH_VERIFICATION_FAILED" "Published content URL is unavailable" true
  fi
}

swap_formal_repository() {
  local current_head current_status candidate_head candidate_status
  current_head=$(git_head_or_empty "$CONTENT_REPOSITORY")
  [[ "$current_head" == "$FORMAL_CONTENT_HEAD" ]] || fail "CONTENT_REPOSITORY_CHANGED" "Formal content changed during this operation"
  current_status=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" status --porcelain --untracked-files=all 2>>"$OP_LOG") || \
    fail "CONTENT_REPOSITORY_CHANGED" "Formal content status cannot be verified" true
  [[ -z "$current_status" ]] || fail "CONTENT_REPOSITORY_CHANGED" "Formal content changed during this operation"
  assert_no_symlinks_in_tree "$CONTENT_REPOSITORY"
  candidate_head=$(git_head_or_empty "$CANDIDATE_REPOSITORY")
  [[ "$candidate_head" == "$CANDIDATE_CONTENT_SHA" ]] || fail "CONTENT_REPOSITORY_CHANGED" "Candidate content changed during this operation"
  candidate_status=$("$GIT_BIN" -C "$CANDIDATE_REPOSITORY" status --porcelain --untracked-files=all 2>>"$OP_LOG") || \
    fail "CONTENT_REPOSITORY_CHANGED" "Candidate content status cannot be verified" true
  [[ -z "$candidate_status" ]] || fail "CONTENT_REPOSITORY_CHANGED" "Candidate content changed during this operation"
  assert_no_symlinks_in_tree "$CANDIDATE_REPOSITORY"
  FORMAL_REPOSITORY_BACKUP="$TX_ROOT/formal-repository-before-swap"
  mv -- "$CONTENT_REPOSITORY" "$FORMAL_REPOSITORY_BACKUP" || fail "CONTENT_REPOSITORY_UPDATE_FAILED" "Cannot stage the formal content repository" true
  FORMAL_REPOSITORY_MOVED=true
  if ! mv -- "$CANDIDATE_REPOSITORY" "$CONTENT_REPOSITORY"; then
    restore_formal_repository
    fail "CONTENT_REPOSITORY_UPDATE_FAILED" "Cannot update the formal content repository" true
  fi
  FORMAL_REPOSITORY_SWAPPED=true
}

publish() {
  local bundle_directory=$1
  create_transaction "publish"
  copy_uploaded_delivery "$bundle_directory"
  local delivery=$DELIVERY_COPY
  parse_manifest "$delivery"
  validate_delivery_artifacts "$delivery"
  import_and_validate_bundle "$delivery"
  prepare_bundle_snapshot
  validate_changed_paths_against_snapshot
  prepare_site_source
  clone_candidate_repository "publish"
  bootstrap_candidate_if_placeholder
  validate_shared_snapshot_media
  install_bundle_snapshot
  validate_candidate_record "$BUNDLE_CONTENT_TYPE" "$BUNDLE_STABLE_ID"
  commit_candidate "content: publish $BUNDLE_STABLE_ID"
  build_release "$BUNDLE_CONTENT_TYPE" "$BUNDLE_STABLE_ID"
  activate_release
  verify_published_url "$(local_content_url "$BUNDLE_CONTENT_TYPE" "$BUNDLE_STABLE_ID")"
  swap_formal_repository
  SUCCESS=true
  printf '{"ok":true,"action":"publish","contentType":%s,"stableId":%s,"url":%s,"releaseSha":%s,"contentSha":%s,"message":"Published successfully"}\n' \
    "$(json_quote "$BUNDLE_CONTENT_TYPE")" \
    "$(json_quote "$BUNDLE_STABLE_ID")" \
    "$(json_quote "$(content_url "$BUNDLE_CONTENT_TYPE" "$BUNDLE_STABLE_ID")")" \
    "$(json_quote "$SITE_SOURCE_SHA")" \
    "$(json_quote "$CANDIDATE_CONTENT_SHA")"
}

delete_content() {
  local content_type=$1
  local stable_id=$2
  is_content_type "$content_type" || fail "INVALID_CONTENT_TYPE" "Content type is not allowed"
  is_stable_id "$stable_id" || fail "INVALID_STABLE_ID" "Stable id is invalid"
  create_transaction "delete"
  prepare_site_source
  clone_candidate_repository "delete"
  bootstrap_candidate_if_placeholder
  local target="$CANDIDATE_REPOSITORY/content/records/$content_type/$stable_id"
  [[ -d "$target" && ! -L "$target" ]] || fail "CONTENT_NOT_FOUND" "Content record does not exist"
  rm -rf -- "$target"
  commit_candidate "content: delete $content_type/$stable_id"
  build_release "$content_type" "$stable_id"
  activate_release
  verify_deleted_url "$(local_content_url "$content_type" "$stable_id")"
  swap_formal_repository
  SUCCESS=true
  printf '{"ok":true,"action":"delete","contentType":%s,"stableId":%s,"url":%s,"releaseSha":%s,"contentSha":%s,"message":"Deleted successfully"}\n' \
    "$(json_quote "$content_type")" \
    "$(json_quote "$stable_id")" \
    "$(json_quote "$(content_url "$content_type" "$stable_id")")" \
    "$(json_quote "$SITE_SOURCE_SHA")" \
    "$(json_quote "$CANDIDATE_CONTENT_SHA")"
}

service_is_active() {
  [[ -n "$SYSTEMCTL_BIN" && -x "$SYSTEMCTL_BIN" ]] || return 1
  "$SYSTEMCTL_BIN" is-active --quiet "$SERVICE_NAME" >/dev/null 2>&1
}

health_is_ready() {
  [[ -n "$CURL_BIN" && -x "$CURL_BIN" ]] || return 1
  "$CURL_BIN" --fail --silent --show-error --max-time 5 "$HEALTH_URL" >/dev/null 2>&1
}

status() {
  local current=""
  local previous=""
  read_release_target "$CURRENT_LINK"
  current=$RESOLVED_RELEASE_TARGET
  read_release_target "$PREVIOUS_LINK"
  previous=$RESOLVED_RELEASE_TARGET
  local repository_ready=false
  if [[ -d "$CONTENT_REPOSITORY/.git" ]] && "$GIT_BIN" -C "$CONTENT_REPOSITORY" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    repository_ready=true
  fi
  local service_active=false
  local healthy=false
  service_is_active && service_active=true
  health_is_ready && healthy=true
  local ready=false
  if $repository_ready && [[ -n "$current" ]] && $service_active && $healthy; then
    ready=true
  fi
  printf '{"ok":true,"action":"status","ready":%s,"contentRepositoryReady":%s,"currentRelease":%s,"previousRelease":%s,"serviceActive":%s,"healthy":%s,"message":%s}\n' \
    "$ready" "$repository_ready" "$(json_quote "$current")" "$(json_quote "$previous")" "$service_active" "$healthy" "$(json_quote "Server status checked")"
}

list_content() {
  local list_script
  list_script=$(cat <<'NODE'
const fs = require("fs");
const path = require("path");
const [repository, publicBase] = process.argv.slice(1);
const routes = {
  "team-news": "news", "research-output": "outputs", "research-project": "projects",
  "learning-resource": "tutorials", "algae-profile": "algae", "live-feed-profile": "live-feeds",
  "coastal-observation": "observations", "science-article": "insights", "team-member": "team",
  "collaboration": "collaboration", "research-profile": "research"
};
const validId = (value) => typeof value === "string" && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(value) && value.length <= 200;
const root = path.join(repository, "content", "records");
const rows = [];
try {
  if (fs.existsSync(root)) {
    for (const type of fs.readdirSync(root, { withFileTypes: true }).filter((entry) => entry.isDirectory()).map((entry) => entry.name).sort()) {
      if (!routes[type]) throw new Error(`unsupported content type: ${type}`);
      const typeRoot = path.join(root, type);
      for (const entry of fs.readdirSync(typeRoot, { withFileTypes: true }).filter((item) => item.isDirectory()).sort((a, b) => a.name.localeCompare(b.name))) {
        if (!validId(entry.name)) throw new Error(`invalid stable id: ${entry.name}`);
        const record = JSON.parse(fs.readFileSync(path.join(typeRoot, entry.name, "record.json"), "utf8"));
        if (record.id !== entry.name || record.type !== type) throw new Error(`record identity mismatch: ${type}/${entry.name}`);
        const zh = record.locales && record.locales.zh;
        if (!zh || typeof zh.title !== "string") throw new Error(`missing Chinese title: ${type}/${entry.name}`);
        rows.push({
          title: zh.title,
          stableId: entry.name,
          contentType: type,
          zhUrl: `${publicBase.replace(/\/$/, "")}/zh/${routes[type]}/${entry.name}`,
          status: "published",
          updatedAt: typeof record.updatedAt === "string" ? record.updatedAt : null
        });
      }
    }
  }
  process.stdout.write(`${JSON.stringify({ ok: true, action: "list", items: rows, count: rows.length, message: "Server content listed" })}\n`);
} catch (error) {
  process.stdout.write(`${JSON.stringify({ ok: false, action: "list", code: "CONTENT_REPOSITORY_INVALID", message: String(error.message || error) })}\n`);
  process.exitCode = 2;
}
NODE
)
  if ! "$NODE_BIN" -e "$list_script" "$CONTENT_REPOSITORY" "$PUBLIC_BASE_URL"; then
    ERROR_EMITTED=true
    exit 1
  fi
}

parse_arguments() {
  [[ $# -ge 1 ]] || { usage; fail "INVALID_ARGUMENTS" "A command is required"; }
  ACTION=$1
  shift
  local bundle=""
  local content_type=""
  local stable_id=""
  local json_count=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)
        JSON_MODE=true
        ((json_count += 1))
        ;;
      --bundle)
        [[ -z "$bundle" && $# -ge 2 ]] || fail "INVALID_ARGUMENTS" "--bundle requires one value"
        bundle=$2
        shift
        ;;
      --type)
        [[ -z "$content_type" && $# -ge 2 ]] || fail "INVALID_ARGUMENTS" "--type requires one value"
        content_type=$2
        shift
        ;;
      --id)
        [[ -z "$stable_id" && $# -ge 2 ]] || fail "INVALID_ARGUMENTS" "--id requires one value"
        stable_id=$2
        shift
        ;;
      *)
        fail "INVALID_ARGUMENTS" "Unknown argument"
        ;;
    esac
    shift
  done
  [[ $json_count -eq 1 ]] || fail "INVALID_ARGUMENTS" "--json is required exactly once"
  case "$ACTION" in
    status|list)
      [[ -z "$bundle$content_type$stable_id" ]] || fail "INVALID_ARGUMENTS" "This command does not accept values"
      ;;
    publish)
      [[ -n "$bundle" && -z "$content_type$stable_id" ]] || fail "INVALID_ARGUMENTS" "publish requires only --bundle"
      PARSED_BUNDLE=$bundle
      ;;
    delete)
      [[ -z "$bundle" && -n "$content_type" && -n "$stable_id" ]] || fail "INVALID_ARGUMENTS" "delete requires --type and --id"
      PARSED_CONTENT_TYPE=$content_type
      PARSED_STABLE_ID=$stable_id
      ;;
    *)
      fail "INVALID_COMMAND" "Unsupported controller command"
      ;;
  esac
}

main() {
  # Pre-scan JSON mode so malformed invocations still return structured errors.
  local argument
  for argument in "$@"; do
    [[ "$argument" == "--json" ]] && JSON_MODE=true
  done
  parse_arguments "$@"
  prepare_runtime
  acquire_lock
  case "$ACTION" in
    status) status ;;
    list) list_content ;;
    publish) publish "$PARSED_BUNDLE" ;;
    delete) delete_content "$PARSED_CONTENT_TYPE" "$PARSED_STABLE_ID" ;;
  esac
}

main "$@"
