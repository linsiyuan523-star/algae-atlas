fail_upload_state() {
  local code=$1
  local message=$2
  [[ -d "$CONTENT_REPOSITORY/.git" && -n "$GIT_BIN" && -x "$GIT_BIN" ]] || return 1
  local ref
  ref=$(upload_transaction_ref)
  queue_ref_exists "$ref" && return 0
  [[ -n "$TX_ROOT" && -d "$TX_ROOT" ]] || return 1
  UPLOAD_STATUS="FAILED"
  UPLOAD_SOURCE_COMMIT=""
  UPLOAD_CONTENT_COMMIT=""
  UPLOAD_QUEUED_AT=""
  UPLOAD_COALESCED_INTO_COMMIT=""
  UPLOAD_INCLUDED_IN_SYNC_TRANSACTION_ID=""
  UPLOAD_PUBLISHED_RELEASE_ID=""
  UPLOAD_PUBLISHED_AT=""
  UPLOAD_RETRYABLE=false
  UPLOAD_ERROR_CODE=$code
  UPLOAD_MESSAGE=$message
  UPLOAD_CONTENT_TYPE=${BUNDLE_CONTENT_TYPE:-}
  UPLOAD_STABLE_ID=${BUNDLE_STABLE_ID:-}
  write_upload_state_blob "$TX_ROOT/failed-upload-state.json" || return 1
  if "$GIT_BIN" -C "$CONTENT_REPOSITORY" update-ref "$ref" "$UPLOAD_STATE_BLOB" \
    0000000000000000000000000000000000000000 >>"$OP_LOG" 2>&1; then
    UPLOAD_STATE_PERSISTED=true
    return 0
  fi
  return 1
}

is_sync_transaction_id() {
  [[ "$1" =~ ^[0-9a-f]{32}$ ]]
}

is_sync_trigger() {
  case "$1" in
    scheduled|manual|recovery) return 0 ;;
    *) return 1 ;;
  esac
}

sync_transaction_ref() {
  local transaction_id=${1:-$SYNC_TRANSACTION_ID}
  is_sync_transaction_id "$transaction_id" || return 1
  printf '%s/%s' "$SYNC_TRANSACTION_REF_ROOT" "$transaction_id"
}

sync_member_ref() {
  local sync_transaction_id=$1
  local upload_transaction_id=$2
  is_sync_transaction_id "$sync_transaction_id" || return 1
  is_publish_transaction_id "$upload_transaction_id" || return 1
  printf '%s/%s/%s' "$SYNC_MEMBER_REF_ROOT" "$sync_transaction_id" "$upload_transaction_id"
}

sync_ref_object() {
  local ref=$1
  SYNC_RESOLVED_OBJECT=""
  queue_ref_exists "$ref" || return 2
  local raw object
  raw=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" rev-parse --verify "$ref" 2>>"$OP_LOG") || return 1
  object=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" rev-parse --verify "$ref^{blob}" 2>>"$OP_LOG") || return 1
  [[ "$raw" == "$object" && "$object" =~ ^[0-9a-f]{40}$ ]] || return 1
  SYNC_RESOLVED_OBJECT=$object
}

sync_transaction_id_from_ref() {
  local ref=$1
  SYNC_RESOLVED_TRANSACTION_ID=""
  sync_ref_object "$ref" || return $?
  local parser
  parser=$(cat <<'NODE'
