  while IFS= read -r remote; do
    [[ -n "$remote" ]] || continue
    "$GIT_BIN" -C "$CANDIDATE_REPOSITORY" remote remove "$remote" >>"$OP_LOG" 2>&1 || \
      fail "CONTENT_REPOSITORY_INVALID" "Cannot detach the queued candidate repository" true
  done < <("$GIT_BIN" -C "$CANDIDATE_REPOSITORY" remote 2>>"$OP_LOG")
  "$GIT_BIN" -C "$CANDIDATE_REPOSITORY" config user.name "Algae Content Controller" >>"$OP_LOG" 2>&1
  "$GIT_BIN" -C "$CANDIDATE_REPOSITORY" config user.email "algae-contentctl@localhost" >>"$OP_LOG" 2>&1
}

tree_oid_or_missing() {
  local repository=$1
  local commit=$2
  local path=$3
  local oid
  if oid=$("$GIT_BIN" -C "$repository" rev-parse --verify "$commit:$path" 2>/dev/null); then
    [[ "$oid" =~ ^[0-9a-f]{40}$ ]] || return 1
    printf '%s' "$oid"
  else
    printf '%s' "missing"
  fi
}

source_baseline_matches_pending() {
  local source_commit=$1
  local canonical_commit=$2
  local source_content canonical_content source_uploads canonical_uploads
  source_content=$(tree_oid_or_missing "$CONTENT_REPOSITORY" "$source_commit" content) || return 1
  canonical_content=$(tree_oid_or_missing "$CONTENT_REPOSITORY" "$canonical_commit" content) || return 1
  [[ "$source_content" != "missing" && "$source_content" == "$canonical_content" ]] || return 1
  source_uploads=$(tree_oid_or_missing "$CONTENT_REPOSITORY" "$source_commit" public/images/uploads) || return 1
  canonical_uploads=$(tree_oid_or_missing "$CONTENT_REPOSITORY" "$canonical_commit" public/images/uploads) || return 1
  [[ "$source_uploads" == "$canonical_uploads" ]]
}

import_verified_source_commit() {
  local staging_ref
  staging_ref=$(queue_staging_source_ref)
  "$GIT_BIN" -C "$CONTENT_REPOSITORY" update-ref -d "$staging_ref" >/dev/null 2>&1 || true
  if ! "$GIT_BIN" -C "$CONTENT_REPOSITORY" fetch --quiet --no-tags "$BUNDLE_REPOSITORY" \
    "refs/heads/incoming:$staging_ref" >>"$OP_LOG" 2>&1; then
    fail "BUNDLE_INVALID" "Cannot retain the verified Bundle commit" true
  fi
  local imported
  imported=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" rev-parse --verify "$staging_ref^{commit}" 2>>"$OP_LOG") || \
    fail "BUNDLE_INVALID" "Imported Bundle commit cannot be read" true
  [[ "$imported" == "$MANIFEST_HEAD" ]] || fail "BUNDLE_INVALID" "Imported Bundle commit changed identity"
}

validate_queue_source_lineage() {
  if [[ -z "$QUEUE_PENDING_SOURCE_COMMIT" ]]; then
    source_baseline_matches_pending "$MANIFEST_BASE" "$QUEUE_PENDING_CONTENT_COMMIT" || \
      fail "PENDING_BASE_MISMATCH" "Server pending content does not match the uploaded Bundle base"
    QUEUE_PUBLISHED_SOURCE_COMMIT=$MANIFEST_BASE
    return
  fi
  if [[ "$MANIFEST_HEAD" == "$QUEUE_PENDING_SOURCE_COMMIT" ]]; then
    return
  fi
  [[ "$MANIFEST_BASE" == "$QUEUE_PENDING_SOURCE_COMMIT" ]] || \
    fail "PENDING_BASE_MISMATCH" "Server has newer pending content; refresh the local content workspace before uploading again"
  "$GIT_BIN" -C "$CONTENT_REPOSITORY" merge-base --is-ancestor \
    "$QUEUE_PENDING_SOURCE_COMMIT" "$MANIFEST_HEAD" >>"$OP_LOG" 2>&1 || \
    fail "PENDING_BASE_MISMATCH" "Uploaded content does not fast-forward the pending content"
}

import_queue_candidate_commit() {
  local staging_ref
  staging_ref=$(queue_staging_content_ref)
  "$GIT_BIN" -C "$CONTENT_REPOSITORY" update-ref -d "$staging_ref" >/dev/null 2>&1 || true
  if ! "$GIT_BIN" -C "$CONTENT_REPOSITORY" fetch --quiet --no-tags "$CANDIDATE_REPOSITORY" \
    "HEAD:$staging_ref" >>"$OP_LOG" 2>&1; then
    fail "CONTENT_COMMIT_FAILED" "Cannot retain the queued content commit" true
  fi
  local imported
  imported=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" rev-parse --verify "$staging_ref^{commit}" 2>>"$OP_LOG") || \
    fail "CONTENT_COMMIT_FAILED" "Queued content commit cannot be read" true
  [[ "$imported" == "$CANDIDATE_CONTENT_SHA" ]] || fail "CONTENT_COMMIT_FAILED" "Queued content commit changed identity"
  "$GIT_BIN" -C "$CONTENT_REPOSITORY" merge-base --is-ancestor \
    "$QUEUE_PENDING_CONTENT_COMMIT" "$imported" >>"$OP_LOG" 2>&1 || \
    fail "CONTENT_COMMIT_FAILED" "Queued content commit does not fast-forward pending"
}

coalesced_upload_blob() {
  local ref=$1
  local transaction_id=$2
  local pending_commit=$3
  local input="$TX_ROOT/coalesced-$transaction_id.input.json"
  local output="$TX_ROOT/coalesced-$transaction_id.json"
  "$GIT_BIN" -C "$CONTENT_REPOSITORY" cat-file blob "$ref" >"$input" 2>>"$OP_LOG" || return 1
  "$NODE_BIN" - "$input" "$output" "$pending_commit" <<'NODE'
const fs = require("fs");
const [input, output, pendingCommit] = process.argv.slice(2);
const state = JSON.parse(fs.readFileSync(input, "utf8"));
state.status = "COALESCED";
state.coalescedIntoCommit = pendingCommit;
state.retryable = false;
state.errorCode = "";
state.message = "Included in a newer queued content commit";
fs.writeFileSync(output, `${JSON.stringify(state)}\n`, { mode: 0o600 });
NODE
  local blob
  blob=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" hash-object -w -- "$output" 2>>"$OP_LOG") || return 1
  [[ "$blob" =~ ^[0-9a-f]{40}$ ]] || return 1
  COALESCED_UPLOAD_BLOB=$blob
}

persist_queued_upload() {
  local current_transaction=$PUBLISH_TRANSACTION_ID
  local current_bundle_sha=$PUBLISH_EXPECTED_BUNDLE_SHA256
  local current_source=$UPLOAD_SOURCE_COMMIT
  local current_content=$UPLOAD_CONTENT_COMMIT
  local current_queued_at=$UPLOAD_QUEUED_AT
  local current_type=$UPLOAD_CONTENT_TYPE
  local current_id=$UPLOAD_STABLE_ID
  local queue_state_old
  queue_state_old=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" rev-parse --verify "$QUEUE_STATE_REF^{blob}" 2>>"$OP_LOG") || \
    fail "QUEUE_STATE_CORRUPT" "Queue state cannot be updated"
  write_queue_state_blob "$current_transaction" || fail "QUEUE_STATE_UPDATE_FAILED" "Cannot create queue state"

  local transaction_file="$TX_ROOT/queued-upload-state.json"
  write_upload_state_blob "$transaction_file" || fail "QUEUE_STATE_UPDATE_FAILED" "Cannot create upload transaction state"
  local current_transaction_blob=$UPLOAD_STATE_BLOB

  local -a coalesced_refs=()
  local -a coalesced_old_objects=()
  local -a coalesced_new_objects=()
  local ref transaction_id old_object existing_upload_status
  if [[ -z "$QUEUE_PENDING_SOURCE_COMMIT" || "$current_source" != "$QUEUE_PENDING_SOURCE_COMMIT" ]]; then
    local upload_refs_file="$TX_ROOT/upload-transaction-refs"
    "$GIT_BIN" -C "$CONTENT_REPOSITORY" for-each-ref --format='%(refname)' \
      "$UPLOAD_TRANSACTION_REF_ROOT/" >"$upload_refs_file" 2>>"$OP_LOG" || \
      fail "QUEUE_STATE_CORRUPT" "Upload transaction refs cannot be enumerated"
    while IFS= read -r ref; do
      [[ -n "$ref" ]] || continue
      transaction_id=${ref##*/}
      [[ "$transaction_id" != "$current_transaction" ]] || continue
      existing_upload_status=$(load_upload_state_ref "$ref" "$transaction_id" && \
        validate_loaded_upload_against_pending && printf '%s' "$UPLOAD_STATUS") || \
        fail "QUEUE_STATE_CORRUPT" "A queued upload transaction is invalid"
      case "$existing_upload_status" in
        QUEUED|COALESCED)
          old_object=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" rev-parse --verify "$ref^{blob}" 2>>"$OP_LOG") || \
            fail "QUEUE_STATE_CORRUPT" "A queued upload transaction cannot be read"
          coalesced_upload_blob "$ref" "$transaction_id" "$current_content" || \
            fail "QUEUE_STATE_UPDATE_FAILED" "Cannot coalesce an earlier upload transaction"
          coalesced_refs+=("$ref")
          coalesced_old_objects+=("$old_object")
          coalesced_new_objects+=("$COALESCED_UPLOAD_BLOB")
          ;;
        FAILED|SYNCING|PUBLISHED) ;;
        *) fail "QUEUE_STATE_CORRUPT" "A queued upload transaction has an invalid status" ;;
      esac
    done < "$upload_refs_file"
  fi

  PUBLISH_TRANSACTION_ID=$current_transaction
  PUBLISH_EXPECTED_BUNDLE_SHA256=$current_bundle_sha
  UPLOAD_SOURCE_COMMIT=$current_source
  UPLOAD_CONTENT_COMMIT=$current_content
  UPLOAD_STATUS="QUEUED"
  UPLOAD_QUEUED_AT=$current_queued_at
  UPLOAD_COALESCED_INTO_COMMIT=""
  UPLOAD_INCLUDED_IN_SYNC_TRANSACTION_ID=""
  UPLOAD_PUBLISHED_RELEASE_ID=""
  UPLOAD_PUBLISHED_AT=""
  UPLOAD_RETRYABLE=false
  UPLOAD_ERROR_CODE=""
  UPLOAD_MESSAGE="Content validated and queued for synchronization"
  UPLOAD_CONTENT_TYPE=$current_type
  UPLOAD_STABLE_ID=$current_id

  local update_file="$TX_ROOT/queue-ref-update"
  local staging_source staging_content transaction_ref source_ref content_ref
  staging_source=$(queue_staging_source_ref)
  staging_content=$(queue_staging_content_ref)
  transaction_ref=$(upload_transaction_ref)
  source_ref=$(upload_source_ref)
  content_ref=$(upload_content_ref)
  {
    printf 'start\n'
    printf 'update %s %s %s\n' "$QUEUE_STATE_REF" "$QUEUE_STATE_BLOB" "$queue_state_old"
    if [[ -z "$QUEUE_PENDING_SOURCE_COMMIT" ]]; then
      printf 'create %s %s\n' "$PUBLISHED_SOURCE_REF" "$MANIFEST_BASE"
      printf 'create %s %s\n' "$PENDING_SOURCE_REF" "$current_source"
    elif [[ "$current_source" == "$QUEUE_PENDING_SOURCE_COMMIT" ]]; then
      printf 'verify %s %s\n' "$PENDING_SOURCE_REF" "$QUEUE_PENDING_SOURCE_COMMIT"
    else
      printf 'update %s %s %s\n' "$PENDING_SOURCE_REF" "$current_source" "$QUEUE_PENDING_SOURCE_COMMIT"
    fi
    if [[ "$current_content" == "$QUEUE_PENDING_CONTENT_COMMIT" ]]; then
      printf 'verify %s %s\n' "$PENDING_CONTENT_REF" "$QUEUE_PENDING_CONTENT_COMMIT"
    else
      printf 'update %s %s %s\n' "$PENDING_CONTENT_REF" "$current_content" "$QUEUE_PENDING_CONTENT_COMMIT"
    fi
    printf 'create %s %s\n' "$source_ref" "$current_source"
    printf 'create %s %s\n' "$content_ref" "$current_content"
    printf 'create %s %s\n' "$transaction_ref" "$current_transaction_blob"
    printf 'delete %s %s\n' "$staging_source" "$current_source"
    if queue_ref_exists "$staging_content"; then
      printf 'delete %s %s\n' "$staging_content" "$current_content"
    fi
    local index
    for index in "${!coalesced_refs[@]}"; do
      printf 'update %s %s %s\n' "${coalesced_refs[$index]}" \
        "${coalesced_new_objects[$index]}" "${coalesced_old_objects[$index]}"
    done
    printf 'prepare\ncommit\n'
  } >"$update_file"
  chmod 0600 -- "$update_file"
  if ! "$GIT_BIN" -C "$CONTENT_REPOSITORY" update-ref --stdin <"$update_file" >>"$OP_LOG" 2>&1; then
    fail "QUEUE_STATE_UPDATE_FAILED" "Cannot atomically advance the pending content queue" true
  fi
}

next_scheduled_sync_at() {
  "$NODE_BIN" -e '
const interval = 30 * 60 * 1000;
const next = (Math.floor(Date.now() / interval) + 1) * interval;
process.stdout.write(new Date(next).toISOString());
'
}

sync_timer_is_active() {
  [[ -n "$SYSTEMCTL_BIN" && -x "$SYSTEMCTL_BIN" ]] || return 1
  "$SYSTEMCTL_BIN" is-enabled --quiet "$SYNC_TIMER_NAME" >/dev/null 2>&1 && \
    "$SYSTEMCTL_BIN" is-active --quiet "$SYNC_TIMER_NAME" >/dev/null 2>&1
}

pending_status() {
  local response_action=${1:-pending-status}
  local load_status=0
  load_queue_state || load_status=$?
  [[ $load_status -ne 2 ]] || fail "QUEUE_NOT_INITIALIZED" "Content queue has not been initialized"
  [[ $load_status -eq 0 ]] || fail "QUEUE_STATE_CORRUPT" "Content queue state is invalid"
  local latest=$QUEUE_LATEST_UPLOAD_TRANSACTION_ID
  local pending_count=0 ref transaction_id
  local upload_refs_output
  upload_refs_output=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" for-each-ref --format='%(refname)' \
    "$UPLOAD_TRANSACTION_REF_ROOT/" 2>>"$OP_LOG") || \
    fail "QUEUE_STATE_CORRUPT" "Upload transaction refs cannot be enumerated"
  local -a upload_refs=()
  [[ -z "$upload_refs_output" ]] || mapfile -t upload_refs <<< "$upload_refs_output"
  for ref in "${upload_refs[@]}"; do
    [[ -n "$ref" ]] || continue
    transaction_id=${ref##*/}
    load_upload_state_ref "$ref" "$transaction_id" || fail "QUEUE_STATE_CORRUPT" "An upload transaction state is invalid"
    validate_loaded_upload_against_pending || \
      fail "QUEUE_STATE_CORRUPT" "An upload transaction is outside the pending history"
    case "$UPLOAD_STATUS" in
      QUEUED|COALESCED|SYNCING) ((pending_count += 1)) ;;
      FAILED|PUBLISHED) ;;
      *) fail "QUEUE_STATE_CORRUPT" "An upload transaction has an invalid status" ;;
    esac
  done
  local has_pending=false syncing_json=null latest_json=null
  [[ "$QUEUE_PENDING_CONTENT_COMMIT" == "$QUEUE_PUBLISHED_CONTENT_COMMIT" ]] || has_pending=true
  [[ -z "$QUEUE_SYNCING_CONTENT_COMMIT" ]] || syncing_json=$(json_quote "$QUEUE_SYNCING_CONTENT_COMMIT")
  [[ -z "$latest" ]] || latest_json=$(json_quote "$latest")
  sync_ids_for_status || fail "SYNC_STATE_CORRUPT" "Synchronization index refs are invalid"
  local active_json=null last_json=null last_status_json=null blocked_json=null
  [[ -z "$SYNC_ACTIVE_TRANSACTION_ID" ]] || active_json=$(json_quote "$SYNC_ACTIVE_TRANSACTION_ID")
  [[ -z "$SYNC_LAST_TRANSACTION_ID" ]] || last_json=$(json_quote "$SYNC_LAST_TRANSACTION_ID")
  if [[ -n "$SYNC_LAST_TRANSACTION_ID" ]]; then
    load_indexed_sync_state "$SYNC_LAST_REF" "" || \
      fail "SYNC_STATE_CORRUPT" "Last synchronization transaction is invalid"
    last_status_json=$(json_quote "$SYNC_STATUS")
  fi
  if queue_ref_exists "$SYNC_BLOCKED_REF"; then
    load_indexed_sync_state "$SYNC_BLOCKED_REF" "FAILED_BLOCKED" || \
      fail "SYNC_STATE_CORRUPT" "Blocked synchronization state is invalid"
    blocked_json=$(json_quote "$SYNC_SYNCING_CONTENT_COMMIT")
  fi
  local timer_active=false
  sync_timer_is_active && timer_active=true
  local next_sync server_time
  next_sync=$(next_scheduled_sync_at) || fail "INTERNAL_ERROR" "Cannot calculate the next fixed synchronization time"
  server_time=$(iso_timestamp)
  printf '{"ok":true,"action":%s,"schema_version":%d' \
    "$(json_quote "$response_action")" "$QUEUE_SCHEMA_VERSION"
  printf ',"published_content_commit":%s,"pending_content_commit":%s,"syncing_content_commit":%s' \
    "$(json_quote "$QUEUE_PUBLISHED_CONTENT_COMMIT")" "$(json_quote "$QUEUE_PENDING_CONTENT_COMMIT")" "$syncing_json"
  printf ',"has_pending_changes":%s,"pending_upload_count":%d,"latest_upload_transaction_id":%s' \
    "$has_pending" "$pending_count" "$latest_json"
  printf ',"active_sync_transaction_id":%s,"last_sync_transaction_id":%s,"last_sync_status":%s,"blocked_content_commit":%s' \
    "$active_json" "$last_json" "$last_status_json" "$blocked_json"
  printf ',"next_scheduled_sync_at":%s,"sync_timer_active":%s,"server_time":%s' \
    "$(json_quote "$next_sync")" "$timer_active" "$(json_quote "$server_time")"
  printf ',"site_commit":%s,"queue_protocol_version":%d,"sync_protocol_version":%d,"message":%s}\n' \
    "$(json_quote "$QUEUE_SITE_COMMIT")" "$QUEUE_PROTOCOL_VERSION" "$SYNC_PROTOCOL_VERSION" \
    "$(json_quote "Pending content status checked")"
}

queue_init() {
  local published_commit=$1
  create_transaction "queue-init"
  local existing_status=0
  load_queue_state || existing_status=$?
  if [[ $existing_status -eq 0 ]]; then
    [[ "$QUEUE_PUBLISHED_CONTENT_COMMIT" == "$published_commit" ]] || \
      fail "QUEUE_ALREADY_INITIALIZED" "Content queue is already initialized with different state"
    if [[ -z "$QUEUE_SITE_COMMIT" ]]; then
      load_current_release_site_commit "$published_commit"
      local old_queue_state
      old_queue_state=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" rev-parse --verify "$QUEUE_STATE_REF^{blob}" 2>>"$OP_LOG") || \
        fail "QUEUE_STATE_CORRUPT" "Queue state cannot be migrated"
      write_queue_state_blob "$QUEUE_LATEST_UPLOAD_TRANSACTION_ID" || \
        fail "QUEUE_STATE_UPDATE_FAILED" "Cannot add the trusted website source commit to queue state"
      "$GIT_BIN" -C "$CONTENT_REPOSITORY" update-ref "$QUEUE_STATE_REF" "$QUEUE_STATE_BLOB" "$old_queue_state" \
        >>"$OP_LOG" 2>&1 || fail "QUEUE_STATE_UPDATE_FAILED" "Cannot atomically migrate queue state" true
    fi
    SUCCESS=true
    pending_status "queue-init"
    return
  fi
  [[ $existing_status -eq 2 ]] || fail "QUEUE_STATE_CORRUPT" "Content queue state is invalid"
  local existing_ref
  existing_ref=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" for-each-ref \
    --count=1 --format='%(refname)' refs/algae/ 2>>"$OP_LOG") || \
    fail "QUEUE_STATE_CORRUPT" "Content queue refs cannot be enumerated"
  [[ -z "$existing_ref" ]] || fail "QUEUE_STATE_CORRUPT" "Content queue refs exist without valid queue state"
  local commit
  commit=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" rev-parse --verify "$published_commit^{commit}" 2>>"$OP_LOG") || \
    fail "CONTENT_COMMIT_NOT_FOUND" "Published content commit does not exist"
  [[ "$commit" == "$published_commit" ]] || fail "CONTENT_COMMIT_NOT_FOUND" "Published content commit is not canonical"
  local repository_head
  repository_head=$(git_head_or_empty "$CONTENT_REPOSITORY")
  [[ "$repository_head" == "$published_commit" ]] || \
    fail "PUBLISHED_COMMIT_MISMATCH" "Published content must be initialized from the repository HEAD"
  load_current_release_site_commit "$published_commit"
  QUEUE_INITIALIZED_AT=""
  write_queue_state_blob "" || fail "QUEUE_STATE_UPDATE_FAILED" "Cannot create initial queue state"
  local update_file="$TX_ROOT/queue-init-ref-update"
  {
    printf 'start\n'
    printf 'create %s %s\n' "$PUBLISHED_CONTENT_REF" "$published_commit"
    printf 'create %s %s\n' "$PENDING_CONTENT_REF" "$published_commit"
    printf 'create %s %s\n' "$QUEUE_STATE_REF" "$QUEUE_STATE_BLOB"
    printf 'prepare\ncommit\n'
  } >"$update_file"
  chmod 0600 -- "$update_file"
  "$GIT_BIN" -C "$CONTENT_REPOSITORY" update-ref --stdin <"$update_file" >>"$OP_LOG" 2>&1 || \
    fail "QUEUE_STATE_UPDATE_FAILED" "Cannot atomically initialize the content queue" true
  SUCCESS=true
  pending_status "queue-init"
}

begin_queue_upload() {
  initialize_publish_state_context
  if [[ -e "$PUBLISH_STATE_FILE" || -L "$PUBLISH_STATE_FILE" ]]; then
    fail "TRANSACTION_KIND_MISMATCH" "This transaction id already belongs to a synchronous publish"
  fi

  local queue_status=0
  load_queue_state || queue_status=$?
  [[ $queue_status -ne 2 ]] || fail "QUEUE_NOT_INITIALIZED" "Content queue has not been initialized"
  [[ $queue_status -eq 0 ]] || fail "QUEUE_STATE_CORRUPT" "Content queue state is invalid"

  local transaction_ref
  transaction_ref=$(upload_transaction_ref)
  if queue_ref_exists "$transaction_ref"; then
    local requested_bundle_sha=$PUBLISH_EXPECTED_BUNDLE_SHA256
    load_upload_state_ref "$transaction_ref" "$PUBLISH_TRANSACTION_ID" || \
      fail "STATE_CORRUPT" "Upload transaction state is invalid"
    validate_loaded_upload_against_pending || \
      fail "STATE_CORRUPT" "Upload transaction state is outside the pending content history"
    local stored_bundle_sha=$PUBLISH_EXPECTED_BUNDLE_SHA256
    PUBLISH_EXPECTED_BUNDLE_SHA256=$requested_bundle_sha
    [[ "$stored_bundle_sha" == "$requested_bundle_sha" ]] || \
      fail "TRANSACTION_BUNDLE_MISMATCH" "This transaction id already belongs to a different Bundle"
    emit_upload_state_json "$transaction_ref" "queue-upload" || \
      fail "STATE_CORRUPT" "Upload transaction state cannot be read"
    if [[ "$UPLOAD_STATUS" == "FAILED" ]]; then
      ERROR_EMITTED=true
      exit 1
    fi
    SUCCESS=true
    exit 0
  fi

  create_transaction "queue-upload"
  UPLOAD_STATE_ACTIVE=true
  QUEUE_STAGING_ACTIVE=true
  cleanup_queue_staging_refs
}

queue_upload() {
  local bundle_directory=$1
  [[ $(basename -- "$bundle_directory") == "$PUBLISH_TRANSACTION_ID" ]] || \
    fail "TRANSACTION_BUNDLE_MISMATCH" "Bundle directory does not match the upload transaction id"
  copy_uploaded_delivery "$bundle_directory"
  local delivery=$DELIVERY_COPY
  parse_manifest "$delivery"
  [[ ${MANIFEST[BundleSha256]} == "$PUBLISH_EXPECTED_BUNDLE_SHA256" ]] || \
    fail "TRANSACTION_BUNDLE_MISMATCH" "Bundle SHA-256 does not match the upload transaction"
  validate_delivery_artifacts "$delivery"
  import_and_validate_bundle "$delivery"
  UPLOAD_CONTENT_TYPE=$BUNDLE_CONTENT_TYPE
  UPLOAD_STABLE_ID=$BUNDLE_STABLE_ID
  prepare_bundle_snapshot
  validate_changed_paths_against_snapshot
  import_verified_source_commit
  validate_queue_source_lineage

  clone_queue_candidate_repository
  validate_shared_snapshot_media
  install_bundle_snapshot
  validate_candidate_record "$BUNDLE_CONTENT_TYPE" "$BUNDLE_STABLE_ID"
  local candidate_status
  candidate_status=$("$GIT_BIN" -C "$CANDIDATE_REPOSITORY" status --porcelain --untracked-files=all 2>>"$OP_LOG") || \
    fail "CONTENT_REPOSITORY_INVALID" "Queued candidate status cannot be read" true
  if [[ -n "$candidate_status" ]]; then
    commit_candidate "content: queue $PUBLISH_TRANSACTION_ID $BUNDLE_STABLE_ID"
    import_queue_candidate_commit
    UPLOAD_CONTENT_COMMIT=$CANDIDATE_CONTENT_SHA
  else
    UPLOAD_CONTENT_COMMIT=$QUEUE_PENDING_CONTENT_COMMIT
  fi
  UPLOAD_SOURCE_COMMIT=$MANIFEST_HEAD
  UPLOAD_STATUS="QUEUED"
  UPLOAD_QUEUED_AT=$(iso_timestamp)
  UPLOAD_COALESCED_INTO_COMMIT=""
  UPLOAD_INCLUDED_IN_SYNC_TRANSACTION_ID=""
  UPLOAD_PUBLISHED_RELEASE_ID=""
  UPLOAD_PUBLISHED_AT=""
  UPLOAD_RETRYABLE=false
  UPLOAD_ERROR_CODE=""
  UPLOAD_MESSAGE="Content validated and queued for synchronization"
  persist_queued_upload
  UPLOAD_STATE_ACTIVE=false
  QUEUE_STAGING_ACTIVE=false
  local transaction_ref
  transaction_ref=$(upload_transaction_ref)
  load_upload_state_ref "$transaction_ref" "$PUBLISH_TRANSACTION_ID" || \
    fail "QUEUE_STATE_CORRUPT" "Queued upload transaction cannot be read"
  SUCCESS=true
  emit_upload_state_json "$transaction_ref" "queue-upload" || \
    fail "QUEUE_STATE_CORRUPT" "Queued upload transaction cannot be rendered"
}

generate_sync_transaction_id() {
  local attempt candidate full
  for attempt in {1..10}; do
    full=$(printf '%s\n' "$(iso_timestamp)-$$-$RANDOM-$attempt" | \
      "$GIT_BIN" -C "$CONTENT_REPOSITORY" hash-object --stdin 2>>"$OP_LOG") || return 1
    candidate=${full:0:32}
    is_sync_transaction_id "$candidate" || continue
    if ! queue_ref_exists "$SYNC_TRANSACTION_REF_ROOT/$candidate"; then
      SYNC_TRANSACTION_ID=$candidate
      return 0
    fi
  done
  return 1
}

initialize_sync_state() {
  local trigger=$1
  local attempt=${2:-1}
  is_sync_trigger "$trigger" || fail "INVALID_SYNC_TRIGGER" "Synchronization trigger is invalid"
  [[ "$attempt" =~ ^[1-9][0-9]*$ && "$attempt" -le 100 ]] || \
    fail "SYNC_STATE_CORRUPT" "Synchronization attempt is invalid"
  SYNC_TRIGGER=$trigger
  SYNC_STATUS="SNAPSHOTTING"
  SYNC_STAGE="SNAPSHOTTING"
  SYNC_CREATED_AT=$(iso_timestamp)
  SYNC_STARTED_AT=$SYNC_CREATED_AT
  SYNC_UPDATED_AT=$SYNC_CREATED_AT
  SYNC_COMPLETED_AT=""
  SYNC_STAGE_STARTED_AT=$SYNC_CREATED_AT
  SYNC_STARTED_MS=$(epoch_milliseconds)
  SYNC_ELAPSED_MS=0
  SYNC_SITE_COMMIT=$QUEUE_SITE_COMMIT
  SYNC_CONTENT_COMMIT=$QUEUE_PENDING_CONTENT_COMMIT
  SYNC_SOURCE_CONTENT_COMMIT=$QUEUE_PENDING_SOURCE_COMMIT
  SYNC_PUBLISHED_BEFORE=$QUEUE_PUBLISHED_CONTENT_COMMIT
  SYNC_PENDING_AT_START=$QUEUE_PENDING_CONTENT_COMMIT
  SYNC_SYNCING_CONTENT_COMMIT=$QUEUE_PENDING_CONTENT_COMMIT
  SYNC_SOURCE_SYNCING_COMMIT=$QUEUE_PENDING_SOURCE_COMMIT
  SYNC_RELEASE_ID=""
  SYNC_RELEASE_PATH=""
  SYNC_PREVIOUS_RELEASE_PATH=""
  SYNC_PREVIOUS_PREVIOUS_RELEASE_PATH=""
  SYNC_RETRYABLE=false
  SYNC_BLOCKED=false
  SYNC_ERROR_CODE=""
  SYNC_MESSAGE="Fixed pending content snapshot for synchronization"
  SYNC_ATTEMPT=$attempt
  SYNC_RECOVERED=false
  SYNC_SWITCH_COMPLETED=false
  SYNC_HEALTH_VERIFIED=false
  SYNC_SNAPSHOT_LATEST_UPLOAD_TRANSACTION_ID=$QUEUE_LATEST_UPLOAD_TRANSACTION_ID
  SYNC_STATE_BLOB=""
}

sync_commit_is_in_snapshot() {
  local upload_content=$1
  local upload_source=$2
  "$GIT_BIN" -C "$CONTENT_REPOSITORY" merge-base --is-ancestor \
    "$upload_content" "$SYNC_SYNCING_CONTENT_COMMIT" >>"$OP_LOG" 2>&1 || return 1
  "$GIT_BIN" -C "$CONTENT_REPOSITORY" merge-base --is-ancestor \
    "$upload_source" "$SYNC_SOURCE_SYNCING_COMMIT" >>"$OP_LOG" 2>&1
}

create_skipped_sync_transaction() {
  initialize_sync_state "$SYNC_TRIGGER" "$SYNC_ATTEMPT"
  SYNC_STATUS="SKIPPED_NO_PENDING"
  SYNC_STAGE="SKIPPED_NO_PENDING"
  SYNC_COMPLETED_AT=$(iso_timestamp)
  SYNC_MESSAGE="No pending content changes"
  SYNC_SYNCING_CONTENT_COMMIT=""
  SYNC_SOURCE_SYNCING_COMMIT=""
  write_sync_state_blob || fail "SYNC_STATE_UPDATE_FAILED" "Cannot create skipped synchronization state"
  local transaction_ref last_old=""
  transaction_ref=$(sync_transaction_ref) || fail "SYNC_STATE_UPDATE_FAILED" "Synchronization ref is invalid"
  if queue_ref_exists "$SYNC_LAST_REF"; then
    sync_ref_object "$SYNC_LAST_REF" || fail "SYNC_STATE_CORRUPT" "Last synchronization ref is invalid"
    last_old=$SYNC_RESOLVED_OBJECT
  fi
  local update_file="$TX_ROOT/skipped-sync-ref-update"
  {
    printf 'start\n'
    printf 'verify %s %s\n' "$PUBLISHED_CONTENT_REF" "$QUEUE_PUBLISHED_CONTENT_COMMIT"
    printf 'verify %s %s\n' "$PENDING_CONTENT_REF" "$QUEUE_PENDING_CONTENT_COMMIT"
    printf 'verify %s %040d\n' "$SYNC_ACTIVE_REF" 0
    printf 'create %s %s\n' "$transaction_ref" "$SYNC_NEW_STATE_BLOB"
    if [[ -n "$last_old" ]]; then
      printf 'update %s %s %s\n' "$SYNC_LAST_REF" "$SYNC_NEW_STATE_BLOB" "$last_old"
    else
      printf 'create %s %s\n' "$SYNC_LAST_REF" "$SYNC_NEW_STATE_BLOB"
    fi
    printf 'prepare\ncommit\n'
  } > "$update_file"
  chmod 0600 -- "$update_file"
  "$GIT_BIN" -C "$CONTENT_REPOSITORY" update-ref --stdin < "$update_file" >>"$OP_LOG" 2>&1 || \
    fail "SYNC_STATE_UPDATE_FAILED" "Cannot atomically record skipped synchronization" true
  SYNC_STATE_BLOB=$SYNC_NEW_STATE_BLOB
}

create_sync_snapshot() {
  if [[ -n "$QUEUE_SITE_COMMIT" ]]; then
    is_git_object_id "$QUEUE_SITE_COMMIT" || fail "QUEUE_STATE_CORRUPT" "Queue website source commit is invalid"
  fi
  [[ -n "$QUEUE_PENDING_SOURCE_COMMIT" ]] || \
    fail "QUEUE_STATE_CORRUPT" "Pending source snapshot is unavailable"
  initialize_sync_state "$SYNC_TRIGGER" "$SYNC_ATTEMPT"
  read_release_target "$CURRENT_LINK"
  SYNC_PREVIOUS_RELEASE_PATH=$RESOLVED_RELEASE_TARGET
  read_release_target "$PREVIOUS_LINK"
  SYNC_PREVIOUS_PREVIOUS_RELEASE_PATH=$RESOLVED_RELEASE_TARGET

  local queue_state_old
  queue_state_old=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" rev-parse --verify "$QUEUE_STATE_REF^{blob}" 2>>"$OP_LOG") || \
    fail "QUEUE_STATE_CORRUPT" "Queue state cannot be updated"
  write_queue_state_blob "$QUEUE_LATEST_UPLOAD_TRANSACTION_ID" || \
    fail "QUEUE_STATE_UPDATE_FAILED" "Cannot refresh queue state during synchronization snapshot"
  write_sync_state_blob || fail "SYNC_STATE_UPDATE_FAILED" "Cannot create synchronization state"

  local upload_refs_output ref upload_transaction_id upload_old_blob
  upload_refs_output=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" for-each-ref --format='%(refname)' \
    "$UPLOAD_TRANSACTION_REF_ROOT/" 2>>"$OP_LOG") || \
    fail "QUEUE_STATE_CORRUPT" "Upload transaction refs cannot be enumerated"
  local -a member_refs=()
  local -a member_objects=()
  local latest_upload_ref="" latest_upload_old="" latest_upload_new=""
  local saved_publish_transaction=$PUBLISH_TRANSACTION_ID
  local saved_bundle_sha=$PUBLISH_EXPECTED_BUNDLE_SHA256
  while IFS= read -r ref; do
    [[ -n "$ref" ]] || continue
    upload_transaction_id=${ref##*/}
    is_publish_transaction_id "$upload_transaction_id" || \
      fail "QUEUE_STATE_CORRUPT" "Upload transaction ref name is invalid"
    upload_old_blob=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" rev-parse --verify "$ref^{blob}" 2>>"$OP_LOG") || \
      fail "QUEUE_STATE_CORRUPT" "Upload transaction state cannot be read"
    load_upload_state_ref "$ref" "$upload_transaction_id" || \
      fail "QUEUE_STATE_CORRUPT" "Upload transaction state is invalid"
    case "$UPLOAD_STATUS" in
      QUEUED|COALESCED)
        if sync_commit_is_in_snapshot "$UPLOAD_CONTENT_COMMIT" "$UPLOAD_SOURCE_COMMIT"; then
          member_refs+=("$(sync_member_ref "$SYNC_TRANSACTION_ID" "$upload_transaction_id")")
          member_objects+=("$upload_old_blob")
          if [[ "$upload_transaction_id" == "$SYNC_SNAPSHOT_LATEST_UPLOAD_TRANSACTION_ID" ]]; then
            [[ "$UPLOAD_STATUS" == "QUEUED" ]] || \
              fail "QUEUE_STATE_CORRUPT" "Latest upload transaction is not queued"
            UPLOAD_STATUS="SYNCING"
            UPLOAD_INCLUDED_IN_SYNC_TRANSACTION_ID=$SYNC_TRANSACTION_ID
            UPLOAD_MESSAGE="Included in active synchronization"
            write_upload_state_blob "$TX_ROOT/syncing-upload-$upload_transaction_id.json" || \
              fail "SYNC_STATE_UPDATE_FAILED" "Cannot create syncing upload state"
            latest_upload_ref=$ref
            latest_upload_old=$upload_old_blob
            latest_upload_new=$UPLOAD_STATE_BLOB
          fi
        fi
        ;;
      FAILED|SYNCING|PUBLISHED) ;;
      *) fail "QUEUE_STATE_CORRUPT" "Upload transaction has an invalid status" ;;
    esac
  done <<< "$upload_refs_output"
  PUBLISH_TRANSACTION_ID=$saved_publish_transaction
  PUBLISH_EXPECTED_BUNDLE_SHA256=$saved_bundle_sha
  [[ -n "$latest_upload_ref" ]] || \
    fail "QUEUE_STATE_CORRUPT" "Latest pending upload is not part of the fixed synchronization snapshot"

  local old_syncing_content="" old_syncing_source="" old_blocked=""
  if queue_ref_exists "$SYNCING_CONTENT_REF"; then
    resolve_queue_commit_ref "$SYNCING_CONTENT_REF" true || fail "QUEUE_STATE_CORRUPT" "Syncing content ref is invalid"
    old_syncing_content=$RESOLVED_QUEUE_REF
  fi
  if queue_ref_exists "$SYNCING_SOURCE_REF"; then
    resolve_queue_commit_ref "$SYNCING_SOURCE_REF" true || fail "QUEUE_STATE_CORRUPT" "Syncing source ref is invalid"
    old_syncing_source=$RESOLVED_QUEUE_REF
  fi
  if queue_ref_exists "$SYNC_BLOCKED_REF"; then
    sync_ref_object "$SYNC_BLOCKED_REF" || fail "SYNC_STATE_CORRUPT" "Blocked synchronization ref is invalid"
    old_blocked=$SYNC_RESOLVED_OBJECT
  fi

  local transaction_ref update_file="$TX_ROOT/sync-snapshot-ref-update"
  transaction_ref=$(sync_transaction_ref) || fail "SYNC_STATE_UPDATE_FAILED" "Synchronization ref is invalid"
  {
    printf 'start\n'
    printf 'update %s %s %s\n' "$QUEUE_STATE_REF" "$QUEUE_STATE_BLOB" "$queue_state_old"
    printf 'verify %s %s\n' "$PUBLISHED_CONTENT_REF" "$SYNC_PUBLISHED_BEFORE"
    printf 'verify %s %s\n' "$PENDING_CONTENT_REF" "$SYNC_PENDING_AT_START"
    printf 'verify %s %s\n' "$PENDING_SOURCE_REF" "$SYNC_SOURCE_SYNCING_COMMIT"
    if [[ -n "$old_syncing_content" ]]; then
      printf 'update %s %s %s\n' "$SYNCING_CONTENT_REF" "$SYNC_SYNCING_CONTENT_COMMIT" "$old_syncing_content"
    else
      printf 'create %s %s\n' "$SYNCING_CONTENT_REF" "$SYNC_SYNCING_CONTENT_COMMIT"
    fi
    if [[ -n "$old_syncing_source" ]]; then
      printf 'update %s %s %s\n' "$SYNCING_SOURCE_REF" "$SYNC_SOURCE_SYNCING_COMMIT" "$old_syncing_source"
    else
      printf 'create %s %s\n' "$SYNCING_SOURCE_REF" "$SYNC_SOURCE_SYNCING_COMMIT"
    fi
    printf 'create %s %s\n' "$transaction_ref" "$SYNC_NEW_STATE_BLOB"
    printf 'create %s %s\n' "$SYNC_ACTIVE_REF" "$SYNC_NEW_STATE_BLOB"
    local index
    for index in "${!member_refs[@]}"; do
      printf 'create %s %s\n' "${member_refs[$index]}" "${member_objects[$index]}"
    done
    printf 'update %s %s %s\n' "$latest_upload_ref" "$latest_upload_new" "$latest_upload_old"
    if [[ -n "$old_blocked" ]]; then
      printf 'delete %s %s\n' "$SYNC_BLOCKED_REF" "$old_blocked"
    fi
    printf 'prepare\ncommit\n'
  } > "$update_file"
  chmod 0600 -- "$update_file"
  "$GIT_BIN" -C "$CONTENT_REPOSITORY" update-ref --stdin < "$update_file" >>"$OP_LOG" 2>&1 || \
    fail "SYNC_STATE_UPDATE_FAILED" "Cannot atomically fix the pending synchronization snapshot" true
  SYNC_STATE_BLOB=$SYNC_NEW_STATE_BLOB
  SYNC_STATE_ACTIVE=true
}

clone_sync_candidate_repository() {
  CANDIDATE_REPOSITORY="$TX_ROOT/candidate-content"
  if ! "$GIT_BIN" clone --quiet --no-hardlinks --no-checkout \
    "$CONTENT_REPOSITORY" "$CANDIDATE_REPOSITORY" >>"$OP_LOG" 2>&1; then
    fail "CONTENT_REPOSITORY_INVALID" "Cannot clone the fixed syncing content repository" true
  fi
  if ! "$GIT_BIN" -C "$CANDIDATE_REPOSITORY" fetch --quiet --no-tags "$CONTENT_REPOSITORY" \
    "$SYNCING_CONTENT_REF:refs/algae/sync-build" >>"$OP_LOG" 2>&1; then
    fail "SYNC_STATE_CORRUPT" "Cannot load the fixed syncing content snapshot" true
  fi
  "$GIT_BIN" -C "$CANDIDATE_REPOSITORY" checkout --quiet --detach refs/algae/sync-build >>"$OP_LOG" 2>&1 || \
    fail "SYNC_STATE_CORRUPT" "Cannot check out the fixed syncing content snapshot" true
  CANDIDATE_CONTENT_SHA=$(git_head_or_empty "$CANDIDATE_REPOSITORY")
  [[ "$CANDIDATE_CONTENT_SHA" == "$SYNC_SYNCING_CONTENT_COMMIT" ]] || \
    fail "SYNC_STATE_CORRUPT" "Syncing content snapshot changed identity"
  assert_no_symlinks_in_tree "$CANDIDATE_REPOSITORY"
  local candidate_status
  candidate_status=$("$GIT_BIN" -C "$CANDIDATE_REPOSITORY" status --porcelain --untracked-files=all 2>>"$OP_LOG") || \
    fail "CONTENT_REPOSITORY_INVALID" "Syncing content snapshot status cannot be read" true
  [[ -z "$candidate_status" ]] || fail "CONTENT_REPOSITORY_INVALID" "Syncing content snapshot is dirty"
}

sync_log_indicates_transient_error() {
  [[ -n "$OP_LOG" && -f "$OP_LOG" ]] || return 1
  LC_ALL=C grep -Eiq \
    'EAI_AGAIN|ETIMEDOUT|ECONNRESET|ENETUNREACH|temporary failure|temporarily unavailable|Could not resolve|GnuTLS|HTTP[^0-9]*(429|502|503|504)|response status (429|502|503|504)' \
    "$OP_LOG"
}

sync_error_is_retryable() {
  case "$1" in
    CONTROLLER_BUSY|SYNC_BUSY|SITE_SOURCE_NETWORK_FAILED|SITE_SOURCE_API_UNAVAILABLE)
      return 0
      ;;
    DEPENDENCY_PREPARATION_FAILED)
      sync_log_indicates_transient_error
      ;;
    *)
      return 1
      ;;
  esac
}

finish_sync_failure() {
  local code=$1
  local message=$2
  $SYNC_STATE_ACTIVE || return 0
  [[ -n "$SYNC_STATE_BLOB" && -n "$SYNC_TRANSACTION_ID" ]] || return 1

  local retryable=false
  if sync_error_is_retryable "$code" && (( SYNC_ATTEMPT < SYNC_MAX_ATTEMPTS )); then
    retryable=true
  fi
  SYNC_COMPLETED_AT=$(iso_timestamp)
  SYNC_STAGE_STARTED_AT=$SYNC_COMPLETED_AT
  SYNC_ERROR_CODE=$code
  SYNC_MESSAGE=$message
  SYNC_RETRYABLE=$retryable
  if $retryable; then
    SYNC_STATUS="FAILED_RETRYABLE"
    SYNC_STAGE="FAILED_RETRYABLE"
    SYNC_BLOCKED=false
  else
    SYNC_STATUS="FAILED_BLOCKED"
    SYNC_STAGE="FAILED_BLOCKED"
    SYNC_BLOCKED=true
    if sync_error_is_retryable "$code" && (( SYNC_ATTEMPT >= SYNC_MAX_ATTEMPTS )); then
      SYNC_ERROR_CODE="SYNC_RETRY_LIMIT_REACHED"
      SYNC_MESSAGE="$message; automatic retry limit reached"
    fi
  fi
  write_sync_state_blob || return 1

  local transaction_ref last_old="" blocked_old=""
  transaction_ref=$(sync_transaction_ref) || return 1
  if queue_ref_exists "$SYNC_LAST_REF"; then
    sync_ref_object "$SYNC_LAST_REF" || return 1
    last_old=$SYNC_RESOLVED_OBJECT
  fi
  if queue_ref_exists "$SYNC_BLOCKED_REF"; then
    sync_ref_object "$SYNC_BLOCKED_REF" || return 1
    blocked_old=$SYNC_RESOLVED_OBJECT
  fi

  local latest_ref="" latest_current="" latest_original=""
  if [[ -n "$SYNC_SNAPSHOT_LATEST_UPLOAD_TRANSACTION_ID" ]]; then
    latest_ref="$UPLOAD_TRANSACTION_REF_ROOT/$SYNC_SNAPSHOT_LATEST_UPLOAD_TRANSACTION_ID"
    local member_ref
    member_ref=$(sync_member_ref "$SYNC_TRANSACTION_ID" "$SYNC_SNAPSHOT_LATEST_UPLOAD_TRANSACTION_ID") || return 1
    sync_ref_object "$member_ref" || return 1
    latest_original=$SYNC_RESOLVED_OBJECT
    sync_ref_object "$latest_ref" || return 1
    latest_current=$SYNC_RESOLVED_OBJECT
  fi

  local keep_active=false
  if [[ "$code" == "RELEASE_ROLLBACK_FAILED" || "$code" == "CONTENT_REPOSITORY_RECOVERY_FAILED" ]]; then
    keep_active=true
  fi
  local update_file="$TX_ROOT/failed-sync-ref-update"
  {
    printf 'start\n'
    printf 'update %s %s %s\n' "$transaction_ref" "$SYNC_NEW_STATE_BLOB" "$SYNC_STATE_BLOB"
    if $keep_active; then
      printf 'update %s %s %s\n' "$SYNC_ACTIVE_REF" "$SYNC_NEW_STATE_BLOB" "$SYNC_STATE_BLOB"
    else
      printf 'delete %s %s\n' "$SYNC_ACTIVE_REF" "$SYNC_STATE_BLOB"
    fi
    if [[ -n "$last_old" ]]; then
      printf 'update %s %s %s\n' "$SYNC_LAST_REF" "$SYNC_NEW_STATE_BLOB" "$last_old"
    else
      printf 'create %s %s\n' "$SYNC_LAST_REF" "$SYNC_NEW_STATE_BLOB"
    fi
    if $SYNC_BLOCKED; then
      if [[ -n "$blocked_old" ]]; then
        printf 'update %s %s %s\n' "$SYNC_BLOCKED_REF" "$SYNC_NEW_STATE_BLOB" "$blocked_old"
      else
        printf 'create %s %s\n' "$SYNC_BLOCKED_REF" "$SYNC_NEW_STATE_BLOB"
      fi
    elif [[ -n "$blocked_old" ]]; then
      printf 'delete %s %s\n' "$SYNC_BLOCKED_REF" "$blocked_old"
    fi
    if [[ -n "$latest_ref" && "$latest_current" != "$latest_original" ]]; then
      printf 'update %s %s %s\n' "$latest_ref" "$latest_original" "$latest_current"
    fi
    printf 'prepare\ncommit\n'
  } > "$update_file"
  chmod 0600 -- "$update_file"
  "$GIT_BIN" -C "$CONTENT_REPOSITORY" update-ref --stdin < "$update_file" >>"$OP_LOG" 2>&1 || return 1
  SYNC_STATE_BLOB=$SYNC_NEW_STATE_BLOB
  if ! $keep_active; then
    SYNC_STATE_ACTIVE=false
  fi
}

sync_release_is_valid() {
  local require_health=${1:-false}
  [[ -n "$SYNC_RELEASE_PATH" ]] || return 1
  local resolved
  resolved=$(realpath -e -- "$SYNC_RELEASE_PATH" 2>>"$OP_LOG") || return 1
  [[ "$resolved" == "$SYNC_RELEASE_PATH" ]] || return 1
  read_release_identity "$resolved" "$SYNC_SYNCING_CONTENT_COMMIT" || return 1
  [[ "$RELEASE_IDENTITY_SITE_COMMIT" == "$SYNC_SITE_COMMIT" && \
     "$RELEASE_IDENTITY_RELEASE_ID" == "$SYNC_RELEASE_ID" ]] || return 1
  local source_file="$resolved/.source-content-sha"
  local transaction_file="$resolved/.algae-sync-transaction-id"
  [[ -f "$source_file" && ! -L "$source_file" && -f "$transaction_file" && ! -L "$transaction_file" ]] || return 1
  [[ $(<"$source_file") == "$SYNC_SOURCE_SYNCING_COMMIT" && \
     $(<"$transaction_file") == "$SYNC_TRANSACTION_ID" ]] || return 1
  if [[ "$require_health" == "true" ]]; then
    local health_file="$resolved/.algae-sync-health-ok"
    [[ -f "$health_file" && ! -L "$health_file" && $(<"$health_file") == "$SYNC_TRANSACTION_ID" ]] || return 1
  fi
}

reset_formal_repository_to_commit() {
  local commit=$1
  "$GIT_BIN" -C "$CONTENT_REPOSITORY" reset --hard --quiet "$commit" >>"$OP_LOG" 2>&1 || return 1
  [[ $(git_head_or_empty "$CONTENT_REPOSITORY") == "$commit" ]] || return 1
  local status
  status=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" status --porcelain --untracked-files=all 2>>"$OP_LOG") || return 1
  [[ -z "$status" ]] || return 1
  assert_no_symlinks_in_tree "$CONTENT_REPOSITORY"
}

complete_sync_success() {
  load_queue_state || fail "QUEUE_STATE_CORRUPT" "Queue state changed incompatibly before synchronization commit"
  [[ "$QUEUE_PUBLISHED_CONTENT_COMMIT" == "$SYNC_PUBLISHED_BEFORE" && \
     "$QUEUE_SYNCING_CONTENT_COMMIT" == "$SYNC_SYNCING_CONTENT_COMMIT" && \
     "$QUEUE_SYNCING_SOURCE_COMMIT" == "$SYNC_SOURCE_SYNCING_COMMIT" && \
     "$QUEUE_SITE_COMMIT" == "$SYNC_SITE_COMMIT" ]] || \
    fail "SYNC_STATE_CORRUPT" "Synchronization refs no longer match the fixed snapshot"
  read_release_target "$CURRENT_LINK"
  [[ "$RESOLVED_RELEASE_TARGET" == "$SYNC_RELEASE_PATH" ]] || \
    fail "SYNC_RECOVERY_REQUIRED" "Current release does not match the synchronization transaction"
  sync_release_is_valid true || fail "SYNC_RELEASE_INVALID" "Synchronized release markers are invalid"

  reset_formal_repository_to_commit "$SYNC_SYNCING_CONTENT_COMMIT" || \
    fail "CONTENT_REPOSITORY_UPDATE_FAILED" "Cannot advance the formal content repository to the synchronized commit" true

  local queue_state_old
  queue_state_old=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" rev-parse --verify "$QUEUE_STATE_REF^{blob}" 2>>"$OP_LOG") || \
    fail "QUEUE_STATE_CORRUPT" "Queue state cannot be finalized"
  write_queue_state_blob "$QUEUE_LATEST_UPLOAD_TRANSACTION_ID" || \
    fail "QUEUE_STATE_UPDATE_FAILED" "Cannot create final queue state"

  local member_refs_output member_ref upload_transaction_id upload_ref upload_old_blob
  member_refs_output=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" for-each-ref --format='%(refname)' \
    "$SYNC_MEMBER_REF_ROOT/$SYNC_TRANSACTION_ID/" 2>>"$OP_LOG") || \
    fail "SYNC_STATE_CORRUPT" "Synchronization upload members cannot be enumerated"
  local -a upload_refs=()
  local -a upload_old_blobs=()
  local -a upload_new_blobs=()
  local saved_publish_transaction=$PUBLISH_TRANSACTION_ID
  local saved_bundle_sha=$PUBLISH_EXPECTED_BUNDLE_SHA256
  local published_at
  published_at=$(iso_timestamp)
  while IFS= read -r member_ref; do
    [[ -n "$member_ref" ]] || continue
    upload_transaction_id=${member_ref##*/}
    is_publish_transaction_id "$upload_transaction_id" || \
      fail "SYNC_STATE_CORRUPT" "Synchronization upload member name is invalid"
    sync_ref_object "$member_ref" || fail "SYNC_STATE_CORRUPT" "Synchronization upload member is invalid"
    upload_ref="$UPLOAD_TRANSACTION_REF_ROOT/$upload_transaction_id"
    upload_old_blob=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" rev-parse --verify "$upload_ref^{blob}" 2>>"$OP_LOG") || \
      fail "QUEUE_STATE_CORRUPT" "Included upload transaction is missing"
    load_upload_state_ref "$upload_ref" "$upload_transaction_id" || \
      fail "QUEUE_STATE_CORRUPT" "Included upload transaction is invalid"
    sync_commit_is_in_snapshot "$UPLOAD_CONTENT_COMMIT" "$UPLOAD_SOURCE_COMMIT" || \
      fail "SYNC_STATE_CORRUPT" "Included upload is outside the fixed snapshot"
    if [[ "$upload_transaction_id" == "$SYNC_SNAPSHOT_LATEST_UPLOAD_TRANSACTION_ID" ]]; then
      [[ "$UPLOAD_STATUS" == "SYNCING" && "$UPLOAD_INCLUDED_IN_SYNC_TRANSACTION_ID" == "$SYNC_TRANSACTION_ID" ]] || \
        fail "SYNC_STATE_CORRUPT" "Latest included upload is not attached to the active synchronization"
      UPLOAD_STATUS="PUBLISHED"
      UPLOAD_COALESCED_INTO_COMMIT=""
      UPLOAD_MESSAGE="Published by queued content synchronization"
    else
      case "$UPLOAD_STATUS" in
        COALESCED) ;;
        QUEUED)
          UPLOAD_STATUS="COALESCED"
          UPLOAD_COALESCED_INTO_COMMIT=$SYNC_SYNCING_CONTENT_COMMIT
          ;;
        *) fail "SYNC_STATE_CORRUPT" "Earlier included upload has an invalid status" ;;
      esac
      UPLOAD_MESSAGE="Included in a published queued content snapshot"
    fi
    UPLOAD_INCLUDED_IN_SYNC_TRANSACTION_ID=$SYNC_TRANSACTION_ID
    UPLOAD_PUBLISHED_RELEASE_ID=$SYNC_RELEASE_ID
    UPLOAD_PUBLISHED_AT=$published_at
    UPLOAD_RETRYABLE=false
    UPLOAD_ERROR_CODE=""
    write_upload_state_blob "$TX_ROOT/published-upload-$upload_transaction_id.json" || \
      fail "SYNC_STATE_UPDATE_FAILED" "Cannot create published upload association"
    upload_refs+=("$upload_ref")
    upload_old_blobs+=("$upload_old_blob")
    upload_new_blobs+=("$UPLOAD_STATE_BLOB")
  done <<< "$member_refs_output"
  PUBLISH_TRANSACTION_ID=$saved_publish_transaction
  PUBLISH_EXPECTED_BUNDLE_SHA256=$saved_bundle_sha
  [[ ${#upload_refs[@]} -gt 0 ]] || fail "SYNC_STATE_CORRUPT" "Synchronization has no retained upload members"

  SYNC_STATUS="PUBLISHED"
  SYNC_STAGE="PUBLISHED"
  SYNC_COMPLETED_AT=$published_at
  SYNC_STAGE_STARTED_AT=$published_at
  SYNC_RETRYABLE=false
  SYNC_BLOCKED=false
  SYNC_ERROR_CODE=""
  SYNC_MESSAGE="Pending content synchronized and published"
  SYNC_SWITCH_COMPLETED=true
  SYNC_HEALTH_VERIFIED=true
  write_sync_state_blob || fail "SYNC_STATE_UPDATE_FAILED" "Cannot create published synchronization state"

  local transaction_ref last_old=""
  transaction_ref=$(sync_transaction_ref) || fail "SYNC_STATE_CORRUPT" "Synchronization transaction ref is invalid"
  if queue_ref_exists "$SYNC_LAST_REF"; then
    sync_ref_object "$SYNC_LAST_REF" || fail "SYNC_STATE_CORRUPT" "Last synchronization ref is invalid"
    last_old=$SYNC_RESOLVED_OBJECT
  fi
  queue_ref_exists "$SYNC_BLOCKED_REF" && fail "SYNC_STATE_CORRUPT" "Blocked synchronization ref was not cleared before execution"

  local update_file="$TX_ROOT/published-sync-ref-update"
  {
    printf 'start\n'
    printf 'update %s %s %s\n' "$QUEUE_STATE_REF" "$QUEUE_STATE_BLOB" "$queue_state_old"
    printf 'update %s %s %s\n' "$PUBLISHED_CONTENT_REF" "$SYNC_SYNCING_CONTENT_COMMIT" "$SYNC_PUBLISHED_BEFORE"
    printf 'update %s %s %s\n' "$PUBLISHED_SOURCE_REF" "$SYNC_SOURCE_SYNCING_COMMIT" "$QUEUE_PUBLISHED_SOURCE_COMMIT"
    printf 'delete %s %s\n' "$SYNCING_CONTENT_REF" "$SYNC_SYNCING_CONTENT_COMMIT"
    printf 'delete %s %s\n' "$SYNCING_SOURCE_REF" "$SYNC_SOURCE_SYNCING_COMMIT"
    printf 'update %s %s %s\n' "$transaction_ref" "$SYNC_NEW_STATE_BLOB" "$SYNC_STATE_BLOB"
    printf 'delete %s %s\n' "$SYNC_ACTIVE_REF" "$SYNC_STATE_BLOB"
    if [[ -n "$last_old" ]]; then
      printf 'update %s %s %s\n' "$SYNC_LAST_REF" "$SYNC_NEW_STATE_BLOB" "$last_old"
    else
      printf 'create %s %s\n' "$SYNC_LAST_REF" "$SYNC_NEW_STATE_BLOB"
    fi
    local index
    for index in "${!upload_refs[@]}"; do
      printf 'update %s %s %s\n' "${upload_refs[$index]}" "${upload_new_blobs[$index]}" "${upload_old_blobs[$index]}"
    done
    printf 'prepare\ncommit\n'
  } > "$update_file"
  chmod 0600 -- "$update_file"
  if ! "$GIT_BIN" -C "$CONTENT_REPOSITORY" update-ref --stdin < "$update_file" >>"$OP_LOG" 2>&1; then
    if ! reset_formal_repository_to_commit "$SYNC_PUBLISHED_BEFORE"; then
      fail "CONTENT_REPOSITORY_RECOVERY_FAILED" "Cannot restore the formal content repository after synchronization commit failure" true
    fi
    fail "SYNC_STATE_UPDATE_FAILED" "Cannot atomically commit synchronized content refs" true
  fi
  SYNC_STATE_BLOB=$SYNC_NEW_STATE_BLOB
  SYNC_STATE_ACTIVE=false
  RELEASE_ACTIVATED=false
  NEW_RELEASE_DIRECTORY=""
}

load_indexed_sync_state() {
  local index_ref=$1
  local required_status=${2:-}
  sync_transaction_id_from_ref "$index_ref" || return $?
  local indexed_id=$SYNC_RESOLVED_TRANSACTION_ID
  local indexed_blob=$SYNC_RESOLVED_OBJECT
  local transaction_ref
  transaction_ref=$(sync_transaction_ref "$indexed_id") || return 1
  load_sync_state_ref "$transaction_ref" "$indexed_id" || return 1
  [[ "$SYNC_STATE_BLOB" == "$indexed_blob" ]] || return 1
  [[ -z "$required_status" || "$SYNC_STATUS" == "$required_status" ]]
}

begin_new_sync_transaction() {
  local requested_trigger=$SYNC_TRIGGER
  local requested_retry=$SYNC_RETRY_BLOCKED
  local queue_status=0
  load_queue_state || queue_status=$?
  [[ $queue_status -ne 2 ]] || fail "QUEUE_NOT_INITIALIZED" "Content queue has not been initialized"
  [[ $queue_status -eq 0 ]] || fail "QUEUE_STATE_CORRUPT" "Content queue state is invalid"
  queue_ref_exists "$SYNC_ACTIVE_REF" && fail "SYNC_STATE_CORRUPT" "Active synchronization exists without the synchronization lock"

  local attempt=1
  local pending_commit=$QUEUE_PENDING_CONTENT_COMMIT
  if queue_ref_exists "$SYNC_BLOCKED_REF"; then
    load_indexed_sync_state "$SYNC_BLOCKED_REF" "FAILED_BLOCKED" || \
      fail "SYNC_STATE_CORRUPT" "Blocked synchronization state is invalid"
    local blocked_commit=$SYNC_SYNCING_CONTENT_COMMIT
    local blocked_attempt=$SYNC_ATTEMPT
    if [[ "$blocked_commit" == "$pending_commit" ]]; then
      if ! $requested_retry; then
        release_lock
        emit_sync_state_json "sync-pending"
        ERROR_EMITTED=true
        exit 1
      fi
      attempt=$((blocked_attempt + 1))
    fi
    load_queue_state || fail "QUEUE_STATE_CORRUPT" "Content queue state changed while checking blocked synchronization"
  elif queue_ref_exists "$SYNC_LAST_REF"; then
    sync_transaction_id_from_ref "$SYNC_LAST_REF" || fail "SYNC_STATE_CORRUPT" "Last synchronization ref is invalid"
    local last_id=$SYNC_RESOLVED_TRANSACTION_ID
    local last_blob=$SYNC_RESOLVED_OBJECT
    local last_transaction_ref
    last_transaction_ref=$(sync_transaction_ref "$last_id") || fail "SYNC_STATE_CORRUPT" "Last synchronization id is invalid"
    load_sync_state_ref "$last_transaction_ref" "$last_id" || fail "SYNC_STATE_CORRUPT" "Last synchronization state is invalid"
    [[ "$SYNC_STATE_BLOB" == "$last_blob" ]] || fail "SYNC_STATE_CORRUPT" "Last synchronization refs disagree"
    if [[ "$SYNC_STATUS" == "FAILED_RETRYABLE" && "$SYNC_SYNCING_CONTENT_COMMIT" == "$pending_commit" ]]; then
      attempt=$((SYNC_ATTEMPT + 1))
    fi
    load_queue_state || fail "QUEUE_STATE_CORRUPT" "Content queue state changed while checking retry history"
  fi

  SYNC_TRIGGER=$requested_trigger
  SYNC_RETRY_BLOCKED=$requested_retry
  SYNC_ATTEMPT=$attempt
  create_transaction "sync"
  generate_sync_transaction_id || fail "SYNC_STATE_UPDATE_FAILED" "Cannot allocate a synchronization transaction id"
  if [[ "$QUEUE_PENDING_CONTENT_COMMIT" == "$QUEUE_PUBLISHED_CONTENT_COMMIT" ]]; then
    create_skipped_sync_transaction
    release_lock
    SUCCESS=true
    emit_sync_state_json "sync-pending"
    return 1
  fi
  create_sync_snapshot
  release_lock
  return 0
}

validate_active_sync_snapshot() {
  load_queue_state || fail "QUEUE_STATE_CORRUPT" "Content queue state is invalid during synchronization"
  [[ "$QUEUE_PUBLISHED_CONTENT_COMMIT" == "$SYNC_PUBLISHED_BEFORE" && \
     "$QUEUE_SYNCING_CONTENT_COMMIT" == "$SYNC_SYNCING_CONTENT_COMMIT" && \
     "$QUEUE_SYNCING_SOURCE_COMMIT" == "$SYNC_SOURCE_SYNCING_COMMIT" && \
     "$QUEUE_SITE_COMMIT" == "$SYNC_SITE_COMMIT" ]] || \
    fail "SYNC_STATE_CORRUPT" "Active synchronization no longer matches queue refs"
}

execute_sync_transaction() {
  prepare_site_source_commit "$SYNC_SITE_COMMIT"
  clone_sync_candidate_repository
  build_release "" ""
  if $TEST_MODE && [[ "${ALGAE_SYNC_TEST_CRASH_AFTER_BUILD:-0}" == "1" ]]; then
    kill -KILL "$$"
  fi

  acquire_lock
  validate_active_sync_snapshot
  activate_release
  if $TEST_MODE && [[ "${ALGAE_SYNC_TEST_CRASH_AFTER_HEALTH:-0}" == "1" ]]; then
    kill -KILL "$$"
  fi
  SYNC_RELEASE_ID=$PUBLISH_RELEASE_ID
  SYNC_RELEASE_PATH=$RELEASE_DIRECTORY
  complete_sync_success
  release_lock
  SUCCESS=true
  emit_sync_state_json "sync-pending"
}

cleanup_incomplete_sync_candidates() {
  local release_root
  release_root=$(canonical_directory "$RELEASES_ROOT") || \
    fail "SYNC_RECOVERY_FAILED" "Release root is unavailable during synchronization recovery"
  local candidate marker resolved
  shopt -s nullglob
  local -a candidates=("$RELEASES_ROOT"/.candidate-sync-pending-*)
  shopt -u nullglob
  for candidate in "${candidates[@]}"; do
    [[ -d "$candidate" && ! -L "$candidate" ]] || continue
    marker="$candidate/.algae-sync-transaction-id"
    [[ -f "$marker" && ! -L "$marker" ]] || continue
    [[ $(<"$marker") == "$SYNC_TRANSACTION_ID" ]] || continue
    resolved=$(realpath -e -- "$candidate" 2>>"$OP_LOG") || \
      fail "SYNC_RECOVERY_FAILED" "Incomplete synchronization candidate cannot be resolved"
    [[ "$resolved" == "$release_root"/* ]] || \
      fail "SYNC_RECOVERY_FAILED" "Incomplete synchronization candidate is outside the release root"
    rm -rf -- "$resolved" || fail "SYNC_RECOVERY_FAILED" "Cannot remove incomplete synchronization candidate"
  done
}

adopt_recovered_release() {
  RELEASE_DIRECTORY=$SYNC_RELEASE_PATH
  RELEASE_NAME=$SYNC_RELEASE_ID
  PUBLISH_RELEASE_ID=$SYNC_RELEASE_ID
  PUBLISH_SWITCH_COMPLETED=$SYNC_SWITCH_COMPLETED
  OLD_CURRENT_RELEASE=$SYNC_PREVIOUS_RELEASE_PATH
  OLD_PREVIOUS_RELEASE=$SYNC_PREVIOUS_PREVIOUS_RELEASE_PATH
}

mark_recovered_release_healthy() {
  printf '%s\n' "$SYNC_TRANSACTION_ID" > "$SYNC_RELEASE_PATH/.algae-sync-health-ok" || \
    fail "HEALTH_MARKER_FAILED" "Cannot persist recovered synchronization health verification" true
  chmod 0600 -- "$SYNC_RELEASE_PATH/.algae-sync-health-ok" || \
    fail "HEALTH_MARKER_FAILED" "Cannot protect recovered synchronization health verification" true
  SYNC_HEALTH_VERIFIED=true
  persist_active_sync_state || fail "SYNC_STATE_UPDATE_FAILED" "Cannot persist recovered health verification"
}

recover_active_sync_transaction() {
  case "$SYNC_STATUS" in
    CREATED|SNAPSHOTTING|PREPARING_SOURCE|PREPARING_DEPENDENCIES|CHECKING|BUILDING|SWITCHING|VERIFYING|RECOVERING) ;;
    *) fail "SYNC_STATE_CORRUPT" "Terminal synchronization transaction still has an active ref" ;;
  esac
  create_transaction "sync-recovery"
  (( SYNC_ATTEMPT < SYNC_MAX_ATTEMPTS )) || \
    fail "SYNC_RECOVERY_LIMIT_REACHED" "Synchronization recovery attempt limit has been reached"
  SYNC_STATE_ACTIVE=true
  SYNC_TRIGGER="recovery"
  SYNC_RECOVERED=true
  ((SYNC_ATTEMPT += 1))
  set_sync_stage "RECOVERING" "Recovering the fixed synchronization snapshot"

  resolve_queue_commit_ref "$SYNCING_CONTENT_REF" true || \
    fail "SYNC_STATE_CORRUPT" "Active synchronization content ref is missing or invalid"
  [[ "$RESOLVED_QUEUE_REF" == "$SYNC_SYNCING_CONTENT_COMMIT" ]] || \
    fail "SYNC_STATE_CORRUPT" "Active synchronization content ref disagrees with its transaction"
  resolve_queue_commit_ref "$SYNCING_SOURCE_REF" true || \
    fail "SYNC_STATE_CORRUPT" "Active synchronization source ref is missing or invalid"
  [[ "$RESOLVED_QUEUE_REF" == "$SYNC_SOURCE_SYNCING_COMMIT" ]] || \
    fail "SYNC_STATE_CORRUPT" "Active synchronization source ref disagrees with its transaction"
  validate_active_sync_snapshot

  read_release_target "$CURRENT_LINK"
  local current_release=$RESOLVED_RELEASE_TARGET
  local release_exists=false
  [[ -n "$SYNC_RELEASE_PATH" && -d "$SYNC_RELEASE_PATH" && ! -L "$SYNC_RELEASE_PATH" ]] && release_exists=true

  if $release_exists && [[ "$current_release" == "$SYNC_RELEASE_PATH" ]]; then
    acquire_lock
    validate_active_sync_snapshot
    sync_release_is_valid false || fail "SYNC_STATE_CORRUPT" "Active synchronized release markers are invalid"
    adopt_recovered_release
    PUBLISH_SWITCH_COMPLETED=true
    SYNC_SWITCH_COMPLETED=true
    RELEASE_ACTIVATED=true
    if sync_release_is_valid true; then
      SYNC_HEALTH_VERIFIED=true
    elif service_is_active && health_is_ready; then
      mark_recovered_release_healthy
    else
      fail "HEALTH_CHECK_FAILED" "Recovered active release did not pass live service health checks" true
    fi
    complete_sync_success
    release_lock
    SUCCESS=true
    emit_sync_state_json "sync-pending"
    return
  fi

  if $release_exists; then
    [[ "$SYNC_SWITCH_COMPLETED" != "true" && "$SYNC_HEALTH_VERIFIED" != "true" ]] || \
      fail "SYNC_STATE_CORRUPT" "Synchronization release was switched but current no longer points to it"
    [[ -z "$SYNC_PREVIOUS_RELEASE_PATH" || "$current_release" == "$SYNC_PREVIOUS_RELEASE_PATH" ]] || \
      fail "SYNC_STATE_CORRUPT" "Current release changed during pre-switch synchronization recovery"
    sync_release_is_valid false || fail "SYNC_STATE_CORRUPT" "Built synchronization release markers are invalid"
    acquire_lock
    validate_active_sync_snapshot
    adopt_recovered_release
    NEW_RELEASE_DIRECTORY=$SYNC_RELEASE_PATH
    activate_release
    complete_sync_success
    release_lock
    SUCCESS=true
    emit_sync_state_json "sync-pending"
    return
  fi

  [[ "$SYNC_SWITCH_COMPLETED" != "true" && "$SYNC_HEALTH_VERIFIED" != "true" ]] || \
    fail "SYNC_STATE_CORRUPT" "Switched synchronization release is missing"
  [[ -z "$SYNC_PREVIOUS_RELEASE_PATH" || "$current_release" == "$SYNC_PREVIOUS_RELEASE_PATH" ]] || \
    fail "SYNC_STATE_CORRUPT" "Current release changed before synchronization recovery"
  cleanup_incomplete_sync_candidates
  SYNC_RELEASE_ID=""
  SYNC_RELEASE_PATH=""
  SYNC_SWITCH_COMPLETED=false
  SYNC_HEALTH_VERIFIED=false
  persist_active_sync_state || fail "SYNC_STATE_UPDATE_FAILED" "Cannot reset synchronization recovery state"
  execute_sync_transaction
}

sync_pending() {
  local active_status=0
  load_active_sync_state || active_status=$?
  if [[ $active_status -eq 0 ]]; then
    SYNC_STATE_ACTIVE=true
    recover_active_sync_transaction
    return
  fi
  [[ $active_status -eq 2 ]] || fail "SYNC_STATE_CORRUPT" "Active synchronization state is invalid"
  acquire_lock
  if begin_new_sync_transaction; then
    if $TEST_MODE && [[ "${ALGAE_SYNC_TEST_CRASH_AFTER_SNAPSHOT:-0}" == "1" ]]; then
      kill -KILL "$$"
    fi
    execute_sync_transaction
  fi
}

run_build_command() {
  local build_directory=$1
  shift
  (
    cd "$build_directory"
    CONTENT_REPOSITORY_SOURCE=overlay "$@"
  ) >>"$OP_LOG" 2>&1
}

write_content_runtime_config() {
  local build_directory=$1
  local runtime_environment="$build_directory/.env.production.local"
  [[ ! -e "$runtime_environment" && ! -L "$runtime_environment" ]] || \
    fail "BUILD_FAILED" "Website source runtime environment file is reserved" true
  if ! printf '%s\n' 'CONTENT_REPOSITORY_SOURCE=overlay' > "$runtime_environment"; then
    fail "BUILD_FAILED" "Website runtime content source cannot be configured" true
  fi
  "$CHMOD_BIN" 0644 -- "$runtime_environment" || \
    fail "BUILD_FAILED" "Website runtime content source permissions cannot be configured" true
}

build_release() {
  local content_type=$1
  local stable_id=$2
  assert_regular_command "npm" "$NPM_BIN"
  umask 022
  local build_directory="$RELEASES_ROOT/.candidate-$ACTION-$$-$RANDOM"
  BUILD_STAGING_DIRECTORY="$build_directory"
  [[ ! -e "$build_directory" ]] || fail "BUILD_FAILED" "Release staging directory already exists"
  [[ -n "$SITE_SOURCE_REPOSITORY" && -d "$SITE_SOURCE_REPOSITORY/.git" ]] || fail "SITE_SOURCE_FAILED" "Prepared website source is unavailable" true
  if ! cp -a -- "$SITE_SOURCE_REPOSITORY" "$build_directory" >>"$OP_LOG" 2>&1; then
    fail "SITE_SOURCE_FAILED" "Cannot copy the prepared website source" true
  fi
  "$CHMOD_BIN" -R a+rX -- "$build_directory" || fail "SITE_SOURCE_FAILED" "Cannot make the prepared website source readable" true
  local build_source_tree_sha
  build_source_tree_sha=$("$GIT_BIN" -C "$build_directory" rev-parse --verify 'HEAD^{tree}' 2>>"$OP_LOG") || fail "SITE_SOURCE_FAILED" "Prepared website source tree cannot be read" true
  [[ "$build_source_tree_sha" == "$SITE_SOURCE_TREE_SHA" ]] || fail "SITE_SOURCE_FAILED" "Prepared website source tree changed during the transaction" true
  [[ -z "$("$GIT_BIN" -C "$build_directory" status --porcelain --untracked-files=all 2>>"$OP_LOG")" ]] || fail "SITE_SOURCE_FAILED" "Prepared website source changed during the transaction" true
  if [[ "$ACTION" == "sync-pending" ]]; then
    printf '%s\n' "$SYNC_TRANSACTION_ID" > "$build_directory/.algae-sync-transaction-id" || \
      fail "BUILD_FAILED" "Cannot identify synchronization build staging" true
    "$CHMOD_BIN" 0600 -- "$build_directory/.algae-sync-transaction-id" || \
      fail "BUILD_FAILED" "Cannot protect synchronization build identity" true
  fi
  [[ ! -L "$build_directory/content" ]] || fail "BUILD_FAILED" "Website source content directory is unsafe"
  rm -rf -- "$build_directory/content"
  cp -a -- "$CANDIDATE_REPOSITORY/content" "$build_directory/content"
  chmod -R a+rX -- "$build_directory/content"
  [[ ! -L "$build_directory/public" && ! -L "$build_directory/public/images" && ! -L "$build_directory/public/images/uploads" ]] || fail "BUILD_FAILED" "Website upload directory is unsafe"
  mkdir -p -- "$build_directory/public/images"
  rm -rf -- "$build_directory/public/images/uploads"
  cp -a -- "$CANDIDATE_REPOSITORY/public/images/uploads" "$build_directory/public/images/uploads"
  chmod -R a+rX -- "$build_directory/public/images/uploads"
  write_content_runtime_config "$build_directory"
  set_operation_stage "PREPARING_DEPENDENCIES" "preparing_dependencies" "Preparing website dependencies"
  if ! run_build_command "$build_directory" "$NPM_BIN" ci --include=dev --prefer-offline --no-audit --no-fund; then
    if [[ "$ACTION" == "sync-pending" ]]; then
      fail "DEPENDENCY_PREPARATION_FAILED" "Website dependency installation failed" true
    fi
    fail "BUILD_FAILED" "Website dependency installation failed" true
  fi
  set_operation_stage "CHECKING" "validating_site" "Running website content validation"
  if ! run_build_command "$build_directory" "$NPM_BIN" run content:validate -- --json; then
    fail "BUILD_FAILED" "Website content validation failed" true
  fi
  set_operation_stage "BUILDING" "building_site" "Building the website"
  if ! run_build_command "$build_directory" "$NPM_BIN" run build:next; then
    fail "BUILD_FAILED" "Website build failed" true
  fi

  set_operation_stage "BUILDING" "creating_release" "Creating the release"
  RELEASE_NAME="$(date -u +%Y%m%dT%H%M%SZ)-${SITE_SOURCE_SHA:0:12}-${CANDIDATE_CONTENT_SHA:0:12}"
  if [[ "$ACTION" == "sync-pending" ]]; then
    RELEASE_NAME="${RELEASE_NAME}-${SYNC_TRANSACTION_ID:0:8}"
  fi
  RELEASE_DIRECTORY="$RELEASES_ROOT/$RELEASE_NAME"
  [[ ! -e "$RELEASE_DIRECTORY" ]] || fail "BUILD_FAILED" "Release identifier already exists"
  printf '%s\n' "$SITE_SOURCE_SHA" > "$build_directory/.release-sha"
  printf '%s\n' "$CANDIDATE_CONTENT_SHA" > "$build_directory/.content-sha"
  if [[ "$ACTION" == "sync-pending" ]]; then
    printf '%s\n' "$SYNC_SOURCE_SYNCING_COMMIT" > "$build_directory/.source-content-sha"
  fi
  printf '%s\n' "$RELEASE_NAME" > "$build_directory/.release-id"
  mv -- "$build_directory" "$RELEASE_DIRECTORY"
  BUILD_STAGING_DIRECTORY=""
  NEW_RELEASE_DIRECTORY="$RELEASE_DIRECTORY"
  PUBLISH_RELEASE_ID=$RELEASE_NAME
  write_operation_state
}

activate_release() {
  assert_regular_command "systemctl" "$SYSTEMCTL_BIN"
  assert_regular_command "curl" "$CURL_BIN"
  read_release_target "$CURRENT_LINK"
  local observed_current_release=$RESOLVED_RELEASE_TARGET
  read_release_target "$PREVIOUS_LINK"
  local observed_previous_release=$RESOLVED_RELEASE_TARGET
  if [[ "$ACTION" == "sync-pending" ]]; then
    [[ "$observed_current_release" == "$SYNC_PREVIOUS_RELEASE_PATH" && \
       "$observed_previous_release" == "$SYNC_PREVIOUS_PREVIOUS_RELEASE_PATH" ]] || \
      fail "SYNC_STATE_CORRUPT" "Production release links changed after the synchronization snapshot"
  fi
  OLD_CURRENT_RELEASE=$observed_current_release
  OLD_PREVIOUS_RELEASE=$observed_previous_release
  RELEASE_ACTIVATED=true
  if [[ "$ACTION" == "sync-pending" ]]; then
    SYNC_PREVIOUS_RELEASE_PATH=$OLD_CURRENT_RELEASE
    SYNC_PREVIOUS_PREVIOUS_RELEASE_PATH=$OLD_PREVIOUS_RELEASE
  fi
  set_operation_stage "SWITCHING" "switching_release" "Switching the active release"
  if [[ -n "$OLD_CURRENT_RELEASE" ]]; then
    make_link_atomically "$OLD_CURRENT_RELEASE" "$PREVIOUS_LINK" || fail "RELEASE_SWITCH_FAILED" "Cannot update the previous release link" true
  else
    rm -f -- "$PREVIOUS_LINK"
  fi
  make_link_atomically "$RELEASE_DIRECTORY" "$CURRENT_LINK" || fail "RELEASE_SWITCH_FAILED" "Cannot switch the current release link" true
  PUBLISH_SWITCH_COMPLETED=true
  write_operation_state
  if $TEST_MODE && [[ "${ALGAE_SYNC_TEST_CRASH_AFTER_SWITCH:-0}" == "1" && "$ACTION" == "sync-pending" ]]; then
    kill -KILL "$$"
  fi
  set_operation_stage "SWITCHING" "restarting_service" "Restarting the website service"
  if ! run_logged "$SYSTEMCTL_BIN" restart "$SERVICE_NAME"; then
    fail "SERVICE_RESTART_FAILED" "Website service restart failed" true
  fi
  set_operation_stage "VERIFYING" "verifying_production_url" "Verifying the production service and URL"
  local attempt
  local healthy=false
  for ((attempt = 1; attempt <= HEALTH_ATTEMPTS; attempt += 1)); do
    if run_logged "$CURL_BIN" --fail --silent --show-error --max-time 10 "$HEALTH_URL"; then
      healthy=true
      break
    fi
    [[ $attempt -eq $HEALTH_ATTEMPTS ]] || sleep 1
  done
  if ! $healthy; then
    fail "HEALTH_CHECK_FAILED" "Website health check failed" true
  fi
  if [[ "$ACTION" == "sync-pending" ]]; then
    printf '%s\n' "$SYNC_TRANSACTION_ID" > "$RELEASE_DIRECTORY/.algae-sync-health-ok" || \
      fail "HEALTH_MARKER_FAILED" "Cannot persist synchronization health verification" true
    chmod 0600 -- "$RELEASE_DIRECTORY/.algae-sync-health-ok" || \
      fail "HEALTH_MARKER_FAILED" "Cannot protect synchronization health verification" true
    SYNC_HEALTH_VERIFIED=true
    write_operation_state
  fi
}

verify_deleted_url() {
  local url=$1
  local response_code
  response_code=$("$CURL_BIN" --silent --show-error --output /dev/null --write-out '%{http_code}' --max-time 10 "$url" 2>>"$OP_LOG") || fail "DELETE_VERIFICATION_FAILED" "Cannot verify the deleted content URL" true
  [[ "$response_code" == "404" || "$response_code" == "410" ]] || fail "DELETE_VERIFICATION_FAILED" "Deleted content URL is still available"
}

verify_published_url() {
  local url=$1
  if ! run_logged "$CURL_BIN" --fail --silent --show-error --output /dev/null --max-time 10 "$url"; then
    fail "PUBLISH_VERIFICATION_FAILED" "Published content URL is unavailable" true
  fi
}

swap_formal_repository() {
  local current_head current_status candidate_head candidate_status
  current_head=$(git_head_or_empty "$CONTENT_REPOSITORY")
  [[ "$current_head" == "$FORMAL_CONTENT_HEAD" ]] || fail "CONTENT_REPOSITORY_CHANGED" "Formal content changed during this operation"
  current_status=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" status --porcelain --untracked-files=all 2>>"$OP_LOG") || \
    fail "CONTENT_REPOSITORY_CHANGED" "Formal content status cannot be verified" true
  [[ -z "$current_status" ]] || fail "CONTENT_REPOSITORY_CHANGED" "Formal content changed during this operation"
  assert_no_symlinks_in_tree "$CONTENT_REPOSITORY"
  candidate_head=$(git_head_or_empty "$CANDIDATE_REPOSITORY")
  [[ "$candidate_head" == "$CANDIDATE_CONTENT_SHA" ]] || fail "CONTENT_REPOSITORY_CHANGED" "Candidate content changed during this operation"
  candidate_status=$("$GIT_BIN" -C "$CANDIDATE_REPOSITORY" status --porcelain --untracked-files=all 2>>"$OP_LOG") || \
    fail "CONTENT_REPOSITORY_CHANGED" "Candidate content status cannot be verified" true
  [[ -z "$candidate_status" ]] || fail "CONTENT_REPOSITORY_CHANGED" "Candidate content changed during this operation"
  assert_no_symlinks_in_tree "$CANDIDATE_REPOSITORY"
  FORMAL_REPOSITORY_BACKUP="$TX_ROOT/formal-repository-before-swap"
  mv -- "$CONTENT_REPOSITORY" "$FORMAL_REPOSITORY_BACKUP" || fail "CONTENT_REPOSITORY_UPDATE_FAILED" "Cannot stage the formal content repository" true
  FORMAL_REPOSITORY_MOVED=true
  if ! mv -- "$CANDIDATE_REPOSITORY" "$CONTENT_REPOSITORY"; then
    restore_formal_repository
    fail "CONTENT_REPOSITORY_UPDATE_FAILED" "Cannot update the formal content repository" true
  fi
  FORMAL_REPOSITORY_SWAPPED=true
}

publish() {
  local bundle_directory=$1
  [[ $(basename -- "$bundle_directory") == "$PUBLISH_TRANSACTION_ID" ]] || \
    fail "TRANSACTION_BUNDLE_MISMATCH" "Bundle directory does not match the publish transaction id"
  create_transaction "publish"
  set_publish_stage "verifying_bundle" "Verifying the uploaded Bundle"
  copy_uploaded_delivery "$bundle_directory"
  local delivery=$DELIVERY_COPY
  parse_manifest "$delivery"
  [[ ${MANIFEST[BundleSha256]} == "$PUBLISH_EXPECTED_BUNDLE_SHA256" ]] || \
    fail "TRANSACTION_BUNDLE_MISMATCH" "Bundle SHA-256 does not match the publish transaction"
  validate_delivery_artifacts "$delivery"
  set_publish_stage "checking_content_commit" "Checking the content commit and snapshot"
  import_and_validate_bundle "$delivery"
  PUBLISH_CONTENT_TYPE=$BUNDLE_CONTENT_TYPE
  PUBLISH_STABLE_ID=$BUNDLE_STABLE_ID
  write_publish_state
  prepare_bundle_snapshot
  validate_changed_paths_against_snapshot
  prepare_site_source
  clone_candidate_repository "publish"
  bootstrap_candidate_if_placeholder
  validate_shared_snapshot_media
  install_bundle_snapshot
  validate_candidate_record "$BUNDLE_CONTENT_TYPE" "$BUNDLE_STABLE_ID"
  commit_candidate "content: publish $BUNDLE_STABLE_ID"
  PUBLISH_CONTENT_COMMIT=$CANDIDATE_CONTENT_SHA
  write_publish_state
  build_release "$BUNDLE_CONTENT_TYPE" "$BUNDLE_STABLE_ID"
  activate_release
  verify_published_url "$(local_content_url "$BUNDLE_CONTENT_TYPE" "$BUNDLE_STABLE_ID")"
  swap_formal_repository
  PUBLISH_URL=$(content_url "$BUNDLE_CONTENT_TYPE" "$BUNDLE_STABLE_ID")
  complete_publish_state
  SUCCESS=true
  emit_publish_state_json "publish" || fail "STATE_CORRUPT" "Completed publish state cannot be read"
}

delete_content() {
  local content_type=$1
  local stable_id=$2
  is_content_type "$content_type" || fail "INVALID_CONTENT_TYPE" "Content type is not allowed"
  is_stable_id "$stable_id" || fail "INVALID_STABLE_ID" "Stable id is invalid"
  create_transaction "delete"
  prepare_site_source
  clone_candidate_repository "delete"
  bootstrap_candidate_if_placeholder
  local target="$CANDIDATE_REPOSITORY/content/records/$content_type/$stable_id"
  [[ -d "$target" && ! -L "$target" ]] || fail "CONTENT_NOT_FOUND" "Content record does not exist"
  rm -rf -- "$target"
  commit_candidate "content: delete $content_type/$stable_id"
  build_release "$content_type" "$stable_id"
  activate_release
  verify_deleted_url "$(local_content_url "$content_type" "$stable_id")"
  swap_formal_repository
  SUCCESS=true
  printf '{"ok":true,"action":"delete","contentType":%s,"stableId":%s,"url":%s,"releaseSha":%s,"contentSha":%s,"message":"Deleted successfully"}\n' \
    "$(json_quote "$content_type")" \
    "$(json_quote "$stable_id")" \
    "$(json_quote "$(content_url "$content_type" "$stable_id")")" \
    "$(json_quote "$SITE_SOURCE_SHA")" \
    "$(json_quote "$CANDIDATE_CONTENT_SHA")"
}

service_is_active() {
  [[ -n "$SYSTEMCTL_BIN" && -x "$SYSTEMCTL_BIN" ]] || return 1
  "$SYSTEMCTL_BIN" is-active --quiet "$SERVICE_NAME" >/dev/null 2>&1
}

health_is_ready() {
  [[ -n "$CURL_BIN" && -x "$CURL_BIN" ]] || return 1
  "$CURL_BIN" --fail --silent --show-error --max-time 5 "$HEALTH_URL" >/dev/null 2>&1
}

status() {
  local current=""
  local previous=""
  read_release_target "$CURRENT_LINK"
  current=$RESOLVED_RELEASE_TARGET
  read_release_target "$PREVIOUS_LINK"
  previous=$RESOLVED_RELEASE_TARGET
  local repository_ready=false
  if [[ -d "$CONTENT_REPOSITORY/.git" ]] && "$GIT_BIN" -C "$CONTENT_REPOSITORY" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    repository_ready=true
  fi
  local service_active=false
  local healthy=false
  service_is_active && service_active=true
  health_is_ready && healthy=true
  local ready=false
  if $repository_ready && [[ -n "$current" ]] && $service_active && $healthy; then
    ready=true
  fi
  printf '{"ok":true,"action":"status","ready":%s,"contentRepositoryReady":%s,"currentRelease":%s,"previousRelease":%s,"serviceActive":%s,"healthy":%s,"publishProtocolVersion":%d,"queueProtocolVersion":%d,"message":%s}\n' \
    "$ready" "$repository_ready" "$(json_quote "$current")" "$(json_quote "$previous")" "$service_active" "$healthy" \
    "$PUBLISH_PROTOCOL_VERSION" "$QUEUE_PROTOCOL_VERSION" "$(json_quote "Server status checked")"
}

list_content() {
  local list_script
  list_script=$(cat <<'NODE'
const fs = require("fs");
const path = require("path");
const [repository, publicBase] = process.argv.slice(1);
const routes = {
  "team-news": "news", "research-output": "outputs", "research-project": "projects",
  "learning-resource": "tutorials", "algae-profile": "algae", "live-feed-profile": "live-feeds",
  "coastal-observation": "observations", "science-article": "insights", "team-member": "team",
  "collaboration": "collaboration", "research-profile": "research"
};
const validId = (value) => typeof value === "string" && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(value) && value.length <= 200;
const root = path.join(repository, "content", "records");
const rows = [];
try {
  if (fs.existsSync(root)) {
    for (const type of fs.readdirSync(root, { withFileTypes: true }).filter((entry) => entry.isDirectory()).map((entry) => entry.name).sort()) {
      if (!routes[type]) throw new Error(`unsupported content type: ${type}`);
      const typeRoot = path.join(root, type);
      for (const entry of fs.readdirSync(typeRoot, { withFileTypes: true }).filter((item) => item.isDirectory()).sort((a, b) => a.name.localeCompare(b.name))) {
        if (!validId(entry.name)) throw new Error(`invalid stable id: ${entry.name}`);
        const record = JSON.parse(fs.readFileSync(path.join(typeRoot, entry.name, "record.json"), "utf8"));
        if (record.id !== entry.name || record.type !== type) throw new Error(`record identity mismatch: ${type}/${entry.name}`);
        const zh = record.locales && record.locales.zh;
        if (!zh || typeof zh.title !== "string") throw new Error(`missing Chinese title: ${type}/${entry.name}`);
        rows.push({
          title: zh.title,
          stableId: entry.name,
          contentType: type,
          zhUrl: `${publicBase.replace(/\/$/, "")}/zh/${routes[type]}/${entry.name}`,
          status: "published",
          updatedAt: typeof record.updatedAt === "string" ? record.updatedAt : null
        });
      }
    }
  }
  process.stdout.write(`${JSON.stringify({ ok: true, action: "list", items: rows, count: rows.length, message: "Server content listed" })}\n`);
} catch (error) {
  process.stdout.write(`${JSON.stringify({ ok: false, action: "list", code: "CONTENT_REPOSITORY_INVALID", message: String(error.message || error) })}\n`);
  process.exitCode = 2;
}
NODE
)
  if ! "$NODE_BIN" -e "$list_script" "$CONTENT_REPOSITORY" "$PUBLIC_BASE_URL"; then
    ERROR_EMITTED=true
    exit 1
  fi
}

parse_arguments() {
  [[ $# -ge 1 ]] || { usage; fail "INVALID_ARGUMENTS" "A command is required"; }
  ACTION=$1
  shift
  local bundle=""
  local transaction_id=""
  local bundle_sha256=""
  local content_type=""
  local stable_id=""
  local published_commit=""
  local sync_trigger=""
  local retry_blocked_count=0
  local json_count=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)
        JSON_MODE=true
        ((json_count += 1))
        ;;
      --bundle)
        [[ -z "$bundle" && $# -ge 2 ]] || fail "INVALID_ARGUMENTS" "--bundle requires one value"
        bundle=$2
        shift
        ;;
      --transaction)
        [[ -z "$transaction_id" && $# -ge 2 ]] || fail "INVALID_ARGUMENTS" "--transaction requires one value"
        transaction_id=$2
        PUBLISH_TRANSACTION_ID=$transaction_id
        shift
        ;;
      --bundle-sha256)
        [[ -z "$bundle_sha256" && $# -ge 2 ]] || fail "INVALID_ARGUMENTS" "--bundle-sha256 requires one value"
        bundle_sha256=$2
        shift
        ;;
      --type)
        [[ -z "$content_type" && $# -ge 2 ]] || fail "INVALID_ARGUMENTS" "--type requires one value"
        content_type=$2
        shift
        ;;
      --id)
        [[ -z "$stable_id" && $# -ge 2 ]] || fail "INVALID_ARGUMENTS" "--id requires one value"
        stable_id=$2
        shift
        ;;
      --published)
        [[ -z "$published_commit" && $# -ge 2 ]] || fail "INVALID_ARGUMENTS" "--published requires one value"
        published_commit=$2
        shift
        ;;
      --trigger)
        [[ -z "$sync_trigger" && $# -ge 2 ]] || fail "INVALID_ARGUMENTS" "--trigger requires one value"
        sync_trigger=$2
        shift
        ;;
      --retry-blocked)
        ((retry_blocked_count += 1))
        ;;
      *)
        if [[ "$ACTION" == "sync-status" && -z "$transaction_id" && "$1" != --* ]]; then
          transaction_id=$1
        else
          fail "INVALID_ARGUMENTS" "Unknown argument"
        fi
        ;;
    esac
    shift
  done
  [[ $json_count -eq 1 ]] || fail "INVALID_ARGUMENTS" "--json is required exactly once"
  case "$ACTION" in
    status|list|pending-status)
      [[ -z "$bundle$transaction_id$bundle_sha256$content_type$stable_id$published_commit$sync_trigger" && \
         $retry_blocked_count -eq 0 ]] || \
        fail "INVALID_ARGUMENTS" "This command does not accept values"
      ;;
    publish-status)
      [[ -z "$bundle$bundle_sha256$content_type$stable_id$published_commit$sync_trigger" && \
         -n "$transaction_id" && $retry_blocked_count -eq 0 ]] || \
        fail "INVALID_ARGUMENTS" "publish-status requires only --transaction"
      is_publish_transaction_id "$transaction_id" || fail "INVALID_TRANSACTION_ID" "Publish transaction id is invalid"
      PUBLISH_TRANSACTION_ID=$transaction_id
      ;;
    sync-status)
      [[ -z "$bundle$bundle_sha256$content_type$stable_id$published_commit$sync_trigger" && \
         $retry_blocked_count -eq 0 ]] || \
        fail "INVALID_ARGUMENTS" "sync-status accepts only an optional synchronization transaction id"
      if [[ -n "$transaction_id" ]]; then
        is_sync_transaction_id "$transaction_id" || \
          fail "INVALID_SYNC_TRANSACTION_ID" "Synchronization transaction id is invalid"
      fi
      SYNC_REQUESTED_TRANSACTION_ID=$transaction_id
      ;;
    sync-pending)
      [[ -z "$bundle$transaction_id$bundle_sha256$content_type$stable_id$published_commit" && \
         -n "$sync_trigger" && $retry_blocked_count -le 1 ]] || \
        fail "INVALID_ARGUMENTS" "sync-pending requires only --trigger and optional --retry-blocked"
      case "$sync_trigger" in
        scheduled|manual) ;;
        *) fail "INVALID_SYNC_TRIGGER" "Synchronization trigger must be scheduled or manual" ;;
      esac
      if [[ $retry_blocked_count -eq 1 && "$sync_trigger" != "manual" ]]; then
        fail "INVALID_ARGUMENTS" "--retry-blocked requires --trigger manual"
      fi
      SYNC_TRIGGER=$sync_trigger
      if [[ $retry_blocked_count -eq 1 ]]; then
        SYNC_RETRY_BLOCKED=true
      fi
      ;;
    queue-init)
      [[ -z "$bundle$transaction_id$bundle_sha256$content_type$stable_id$sync_trigger" && \
         -n "$published_commit" && $retry_blocked_count -eq 0 ]] || \
        fail "INVALID_ARGUMENTS" "queue-init requires only --published"
      [[ "$published_commit" =~ ^[0-9a-f]{40}$ ]] || \
        fail "INVALID_CONTENT_COMMIT" "Published content commit is invalid"
      PARSED_PUBLISHED_COMMIT=$published_commit
      ;;
    publish|queue-upload)
      [[ -n "$bundle" && -n "$transaction_id" && -n "$bundle_sha256" && \
         -z "$content_type$stable_id$published_commit$sync_trigger" && $retry_blocked_count -eq 0 ]] || \
        fail "INVALID_ARGUMENTS" "$ACTION requires --transaction, --bundle, and --bundle-sha256"
      is_publish_transaction_id "$transaction_id" || fail "INVALID_TRANSACTION_ID" "Publish transaction id is invalid"
      is_bundle_sha256 "$bundle_sha256" || fail "INVALID_BUNDLE_SHA256" "Publish Bundle SHA-256 is invalid"
      PUBLISH_TRANSACTION_ID=$transaction_id
      PUBLISH_EXPECTED_BUNDLE_SHA256=$bundle_sha256
      PARSED_BUNDLE=$bundle
      ;;
    delete)
      [[ -z "$bundle$transaction_id$bundle_sha256$published_commit$sync_trigger" && \
         -n "$content_type" && -n "$stable_id" && $retry_blocked_count -eq 0 ]] || \
        fail "INVALID_ARGUMENTS" "delete requires --type and --id"
      PARSED_CONTENT_TYPE=$content_type
      PARSED_STABLE_ID=$stable_id
      ;;
    *)
      fail "INVALID_COMMAND" "Unsupported controller command"
      ;;
  esac
}

reject_legacy_mutation_when_queue_exists() {
  local queue_ref
  local log=${OP_LOG:-/dev/null}
  queue_ref=$("$GIT_BIN" -C "$CONTENT_REPOSITORY" for-each-ref \
    --count=1 --format='%(refname)' refs/algae/ 2>>"$log") || \
    fail "QUEUE_STATE_CORRUPT" "Content queue refs cannot be inspected"
  [[ -z "$queue_ref" ]] || \
    fail "QUEUE_MODE_ACTIVE" "Synchronous publish and delete are disabled after the content queue is initialized"
}

main() {
  # Pre-scan JSON mode so malformed invocations still return structured errors.
  local argument
  for argument in "$@"; do
    [[ "$argument" == "--json" ]] && JSON_MODE=true
  done
  parse_arguments "$@"
  if [[ "$ACTION" == "publish-status" ]]; then
    prepare_publish_status_runtime
    publish_status
    return
  fi
  if [[ "$ACTION" == "sync-status" ]]; then
    OP_LOG=/dev/null
    prepare_queue_runtime
    sync_status
    return
  fi
  if [[ "$ACTION" == "sync-pending" ]]; then
    OP_LOG=/dev/null
    prepare_runtime
    cleanup_publish_states
    acquire_sync_lock
    sync_pending
    return
  fi
  if [[ "$ACTION" == "pending-status" || "$ACTION" == "queue-init" || "$ACTION" == "queue-upload" ]]; then
    OP_LOG=/dev/null
    prepare_queue_runtime
    acquire_lock
    case "$ACTION" in
      pending-status) pending_status ;;
      queue-init) queue_init "$PARSED_PUBLISHED_COMMIT" ;;
      queue-upload)
        begin_queue_upload
        queue_upload "$PARSED_BUNDLE"
        ;;
    esac
    return
  fi
  if [[ "$ACTION" == "publish" ]]; then
    prepare_publish_status_runtime
    initialize_publish_state_context
    if [[ -e "$PUBLISH_STATE_FILE" || -L "$PUBLISH_STATE_FILE" ]]; then
      [[ -f "$PUBLISH_STATE_FILE" && ! -L "$PUBLISH_STATE_FILE" ]] || fail "STATE_CORRUPT" "Publish transaction state is unsafe"
      local existing_status=0
      load_publish_state || existing_status=$?
      if [[ $existing_status -eq 2 ]]; then
        fail "TRANSACTION_BUNDLE_MISMATCH" "This transaction id already belongs to a different Bundle"
      fi
      [[ $existing_status -eq 0 ]] || fail "STATE_CORRUPT" "Publish transaction state is invalid"
      if [[ "$PUBLISH_STATUS" == "succeeded" || "$PUBLISH_STATUS" == "running" || \
            "$PUBLISH_RETRYABLE" != "true" || "$PUBLISH_SWITCH_COMPLETED" == "true" ]]; then
        emit_publish_state_json "publish" || fail "STATE_CORRUPT" "Publish transaction state cannot be read"
        if [[ "$PUBLISH_STATUS" == "failed" ]]; then
          ERROR_EMITTED=true
          exit 1
        fi
        SUCCESS=true
        return
      fi
    fi
  fi
  prepare_runtime
  cleanup_publish_states
  acquire_lock
  if [[ "$ACTION" == "publish" || "$ACTION" == "delete" ]]; then
    reject_legacy_mutation_when_queue_exists
  fi
  case "$ACTION" in
    status) status ;;
    list) list_content ;;
    publish)
      begin_publish_state
      publish "$PARSED_BUNDLE"
      ;;
    delete) delete_content "$PARSED_CONTENT_TYPE" "$PARSED_STABLE_ID" ;;
  esac
}

main "$@"
