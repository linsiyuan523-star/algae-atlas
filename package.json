{
  "name": "algae-atlas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "tools/content-workbench"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "dev:next": "next dev",
    "build:next": "next build",
    "indexnow": "tsx scripts/submit-indexnow.ts",
    "check": "npm run check:schema && npm run check:content-loader && npm run check:content-migration && npm run desktop:check && tsc --noEmit -p tsconfig.next.json && eslint app components lib packages scripts tests/indexnow.test.ts tests/content-repository tests/content-migration",
    "check:schema": "tsc --noEmit -p packages/content-schema/tsconfig.json",
    "check:content-loader": "tsc --noEmit -p tsconfig.content-loader.json",
    "check:content-migration": "tsc --noEmit -p tsconfig.content-migration.json",
    "content:migrate": "tsx scripts/migrate-content.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "test": "npm run test:schema && npm run test:schema:browser && npm run test:content-loader && npm run test:content-migration && npm run desktop:test && npm run build && node --test tests/rendered-html.test.mjs && tsx --test tests/indexnow.test.ts",
    "test:schema": "tsx --test packages/content-schema/tests/*.test.ts",
    "test:schema:browser": "vite build --config packages/content-schema/vite.browser-contract.config.ts && node packages/content-schema/.browser-contract/content-schema-browser-contract.js",
    "test:content-loader": "tsx --test tests/content-repository/*.test.ts",
    "test:content-migration": "tsx --test tests/content-migration/*.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "desktop:dev": "npm run tauri:dev --workspace @algae-atlas/content-workbench",
    "desktop:check": "npm run check --workspace @algae-atlas/content-workbench",
    "desktop:test:scaffold": "node --test tests/content-workbench-scaffold.test.mjs",
    "desktop:test": "npm run desktop:test:scaffold && npm run test --workspace @algae-atlas/content-workbench",
    "desktop:frontend:build": "npm run build --workspace @algae-atlas/content-workbench",
    "desktop:rust:fmt": "npm run rust:fmt --workspace @algae-atlas/content-workbench",
    "desktop:rust:check": "npm run rust:check --workspace @algae-atlas/content-workbench",
    "desktop:rust:clippy": "npm run rust:clippy --workspace @algae-atlas/content-workbench",
    "desktop:rust:test": "npm run rust:test --workspace @algae-atlas/content-workbench",
    "desktop:build": "npm run tauri:build --workspace @algae-atlas/content-workbench"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@next/env": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "type": "module"
}
