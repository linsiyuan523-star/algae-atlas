{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "allowJs": false
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "db",
    "worker",
    "tests",
    "vite.config.ts"
  ]
}
